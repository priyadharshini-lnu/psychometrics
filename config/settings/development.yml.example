domain: lvh.me # psychometrics.co.uk
subdomain:  # subdomain
port: 3030
protocol: 'http'
assigns:
  mindmill_prefix: TTEDEV
react_dev:
  reports: false # set true if you are running npm server
  assessments: false # set true if you are running npm server
hogan:
  - name: HPI
    assessment_id: HPI
    form_id: 3
    reports:
      - report_id: EcHPIDML
        report_name: HPI Data Report
        norm_id: General
        language_id: en
  - name: HDS
    assessment_id: HDS
    form_id: 5
    reports:
      - report_id: EcHDSDML
        report_name: HDS Data Report
        norm_id: General
        language_id: en
  - name: MVPI
    assessment_id: MVPI
    form_id: 1
    reports:
      - report_id: EcMVPIDML
        report_name: MVPI Data Report
        norm_id: General
        language_id: en
  - name: HBRI
    assessment_id: HBRIV1
    form_id: 1
    reports:
      - report_id: EcHBRIV1D
        report_name: HBRI Data Report
        norm_id: General
        language_id: en
      - report_id: EcHBRIV1IML
        report_name: HBRI Interpret Report
        norm_id: General
        language_id: en
