AWS_SECRET_ACCESS_KEY: dummy_secret
AWS_REGION: eu-west-1
AWS_S3_BUCKET: dummy_bucket

S3_COMPATIBLE_STORAGE_ACCESS_KEY_ID: aws_access_key #replace with actual key from minio
S3_COMPATIBLE_STORAGE_SECRET_ACCESS_KEY: aws_secret_key #replace with actual secret from minio
S3_COMPATIBLE_STORAGE_PUBLIC_BUCKET: s3-public-bucket
S3_COMPATIBLE_STORAGE_PRIVATE_BUCKET: s3-private-bucket
S3_COMPATIBLE_STORAGE_REGION: eu-west-1
S3_COMPATIBLE_STORAGE_PROVIDER: minio # for local minio setup

MAINTENANCE_START_DATETIME: "2021-10-27 17:04:21 +0400"
MAINTENANCE_DURATION: '300' # minutes
UAE_DATA_MIGRATION_REDIRECT_ENABLED: 'true'
UAE_DATA_MIGRATION_SUBDOMAINS: ccd,adsg,adeo,xzy

PK_ID_START: '1'
