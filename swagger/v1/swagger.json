    "/reports/{report_id}/dimensions": {
      "get": {
        "summary": "Get all report dimensions",
        "operationId": "GetReportDimensions",
        "description": "Returns all report dimensions. Use `since` param to get records that \\\n      have been updated or created after since. Use `include_factors` to include Factors.\\\n      Use `include_occupations` to include Occupations",
        "tags": [
          "Dimensions"
        ],
        "consumes": [
          "application/json"
        ],
        "security": [
          {
            "basic": [

            ]
          }
        ],
        "parameters": [
          {
            "name": "report_id",
            "in": "path",
            "type": "integer",
            "required": true
          },
          {
            "name": "since",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "Returns results that have been updated after since."
          },
          {
            "name": "include_occupations",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "true - returns occupations"
          },
          {
            "name": "include_factors",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "true - returns factors"
          }
        ],
        "responses": {
          "200": {
            "description": "Get all report dimensions with factors since the updated_at",
            "schema": {
              "$ref": "#/definitions/Dimensions"
            },
            "examples": {
              "application/json": {
                "dimensions": [
                  {
                    "id": 12,
                    "name": "Dimension name",
                    "factors": [
                      {
                        "id": 123,
                        "name": "Factor Name",
                        "description": "Lorem ipsum dolor sit amet.",
                        "updated_at": "2019-10-06T18:25:43.511Z"
                      }
                    ]
                  }
                ],
                "server_time": "2019-10-06T18:25:43.511Z"
              }
            }
          },
          "404": {
            "description": "Raise 404 Not Found if the report is not found",
            "schema": {
              "$ref": "#/definitions/Dimensions"
            },
            "examples": {
              "application/json": {
                "code": 1005,
                "message": "Resource not found",
                "more_info": "Report with id 123 not found.",
                "meta": null
              }
            }
          },
          "412": {
            "description": "Raise 412 Not Configured if the report doesn't have data configuration",
