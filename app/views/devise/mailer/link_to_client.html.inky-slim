p = simple_format(t("devise.mailer.invitation_instructions.body", url: root_url, email: @resource.email, name: @resource.decorate.display_name))

p
  strong = t("devise.mailer.invitation_instructions.sections.#{@section}", section_name: @section_name)

spacer[size="16"]

row
  columns
    .radius.small
      button href= @sign_in_url
        = t("devise.mailer.invitation_instructions.login")
