spacer[size="48"]
container.email-container
  spacer[size="32"]  
  row
    columns
      - if @resource&.project&.logo&.url
        = image_tag(@resource&.project&.logo&.url, class: 'project-logo float-left')
  row
    columns.email-content
      - options = {id: @resource, invitation_token: @token, domain: Settings.domain, subdomain: @subdomain}
        p = t("devise.mailer.invitation_instructions.hello", email: @resource.email)
        p = t("devise.mailer.invitation_instructions.someone_invited_you", url: root_url)
        p = link_to(t("devise.mailer.invitation_instructions.accept"), url_for([:root, { domain: Settings.domain, subdomain: @project.subdomain }]))
  row
    columns.email-copyright.footer
      |  © 
      = Time.now.year
      |  Lighthouse. All rights reserved 
  spacer[size="16"]

spacer[size="16"]
wrapper.secondary
  center
    row
      columns.powered-by-tte[valign="middle"]
        center
          = image_tag('tte-logo-no-text.svg')
        spacer[size="16"]

        p.text-center
          |  Powered by The Talent Enterprises.
