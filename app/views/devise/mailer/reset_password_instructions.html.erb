<%
subdomain = @resource.admin? || @resource.assessor? ? Settings.subdomain : @resource&.project&.subdomain
change_password_link = url_for([:edit, @resource.role_scope, :password,  {
  id: @resource, reset_password_token: @token, domain: Settings.domain, subdomain: subdomain
}])
name = @resource.decorate.display_name
%>
<p><%=simple_format(t("devise.mailer.reset_password_instructions.body", name: name, change_password_link: change_password_link))%></p>
