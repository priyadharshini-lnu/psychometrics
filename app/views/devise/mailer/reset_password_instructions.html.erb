<style type="text/css">
  body,
  html, 
  .body {
    background: #f3f3f3 !important;
  }
  table {
    border: 1px solid #c7d0d4;
    width: 100%;
    margin: 15px auto;
    max-width: 900px;
    padding: 20px;
    background-color: #FFFFFF;
  }

  .container.header {
    background: #f3f3f3;
  }

  .body-drip {
    border-top: 8px solid #663399;
  }
  .project-logo img {
    margin-bottom: 20px;
    width: 120px;
  }
  .email-privacy-terms, .email-footer a {
    text-decoration: none;
    color: #434A54;
  }

  .email-footer {
    border-top: 1px solid #e7ebee;
    padding: 35px 0;
    color: #A9A9A9;
    font-size: 15px;
  }
  .email-content {
    margin-bottom: 20px;
  }
  .email-copyright img {
    width: 15px;
    vertical-align: middle;
  }
  .email-copyright {
    margin-top: 25px;
  }
  .powered-by-tte {
    width: 50%;
    margin: auto;
    text-align: center;
  }
</style>
<!-- move the above styles into your custom stylesheet -->


<spacer size="16"></spacer>

<container class="body-drip">
  <spacer size="16"></spacer>
  <body>
    <table align="center" class="container">
      <tbody>
        <tr>
          <td>
            <div class='project-logo'>
              <%= image_tag("lighthouseLogo.png") %>
            </div>
          </td>
        </tr>
        <tr>
          <td>
            <div class='email-content'>
              <%
                subdomain = @resource.admin? || @resource.assessor? ? Settings.subdomain : @resource&.project&.subdomain
                change_password_link = url_for([:edit, @resource.role_scope, :password,  {
                  id: @resource, reset_password_token: @token, domain: Settings.domain, subdomain: subdomain
                }])
                name = @resource.decorate.display_name
              %>
              <p><%=simple_format(t("devise.mailer.reset_password_instructions.body", name: name, change_password_link: change_password_link))%></p>
            </div>
          </td>
        </tr>
        <tr>
          <td>
            <div class='email-footer'>
              This email was sent to you as registered member of <a href='lighthouse.com'> lighthouse.com </a>.
              Use of service and website is subject to our terms of consitions and
              <%= link_to t('shared.terms_conditions_privacy'), 'https://thetalententerprise.com/privacy-statement/', 
                rel: 'noopener noreferrer', target: '_blank', class: 'email-privacy-terms' %>.
              <br>
              <div class='email-copyright'>
                <%= image_tag("copyright-regular.png") %>
                <%= Time.now.year %> Lighthouse. All rights reserved
              </div>
            </div>
          </td>
        <tr>
      </tbody>
    </table>
    <div class='powered-by-tte'>
      <%= image_tag('tte-logo-no-text.svg') %>
      <p> Powered by The Talent Enterprises. </p>
    </div>
  </body>
</container>
