- subdomain = @resource.admin? || @resource.assessor? ? Settings.subdomain : @resource&.project&.subdomain
- unlock_link = unlock_url(@resource, unlock_token: @token, domain: Settings.domain, subdomain: subdomain, protocol: Settings.protocol)
- name = @resource.decorate.display_name
= simple_format(t("devise.mailer.unlock_instructions.body", name: name, unlock_link: unlock_link))
spacer[size="16"]
row
  columns
    .radius.small
      button href= unlock_link
        = t("devise.mailer.unlock_instructions.unlock_account")
