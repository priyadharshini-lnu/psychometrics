container.email-container  
  row
    columns.email-content
      p
      | Hello 
      = @resource.email
      | !
      p
      | Your account has been locked due to an excessive number of unsuccessful login attempts.
      p
      | Click the link below to unlock your account:
      p
      = link_to 'Unlock my account', unlock_url(@resource, unlock_token: @token, domain: Settings.domain, subdomain: @resource.try(:clients).try(:first).try(:subdomain))
