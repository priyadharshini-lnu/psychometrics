spacer[size="48"]
container.email-container
  spacer[size="32"]  
  row
    columns
      - if @resource&.project&.logo&.url
        = image_tag(@resource&.project&.logo&.url, class: 'project-logo float-left')
  row
    columns.email-content
      p
      | Hello 
      = @resource.email
      | !
      p
      | Your account has been locked due to an excessive number of unsuccessful login attempts.
      p
      | Click the link below to unlock your account:
      p
      = link_to 'Unlock my account', unlock_url(@resource, unlock_token: @token, domain: Settings.domain, subdomain: @resource.try(:clients).try(:first).try(:subdomain))
  row
    columns.email-copyright.footer
      |  © 
      = Time.now.year
      |  Lighthouse. All rights reserved 
  spacer[size="16"]

spacer[size="16"]
wrapper.secondary
  center
    row
      columns.powered-by-tte[valign="middle"]
        center
          = image_tag('tte-logo-no-text.svg')
        spacer[size="16"]

        p.text-center
          |  Powered by The Talent Enterprises.
   