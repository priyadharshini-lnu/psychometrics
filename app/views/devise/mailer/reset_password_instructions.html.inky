<% @resource = User.last %>

<spacer size="48"></spacer>

<container class="email-container">
  <spacer size="32"> </spacer>
  <row>
    <columns>
      <% if @resource&.project&.logo.url %>
        <%= image_tag(@resource&.project&.logo.url, class: 'project-logo float-left')%>
      <% end %>
    </columns>
  </row>
  
  <row>
    <columns class="email-content">
      <%
        subdomain = @resource.admin? || @resource.assessor? ? Settings.subdomain : @resource&.project&.subdomain
        change_password_link = url_for([:edit, @resource.role_scope, :password, {
          id: @resource, reset_password_token: @token, domain: Settings.domain, subdomain: subdomain
        }])
        name = @resource.decorate.display_name
      %>
      <%=simple_format(t("devise.mailer.reset_password_instructions.body", name: name, change_password_link: change_password_link))%>
    </columns>
  </row>

  <row>
    <columns>
      <button class="radius small" href <%= change_password_link%> >
        <%= t("devise.mailer.reset_password_instructions.change_password") %>
      </button>
    <columns>
  </row>
  
  <row>
    <columns class="footer-instruction">
      <p>
        <%= t("devise.mailer.reset_password_instructions.footer")%>
      </p>
    </columns>
  </row>
 
  <row>
    <columns class='email-copyright footer'>
      © <%= Time.now.year %> Lighthouse. All rights reserved
    </columns>
  </row>
  <spacer size="16"> </spacer>
</container>

<spacer size="16"></spacer>

<wrapper class="secondary">
  <center>
    <row>
      <columns valign="middle" class="powered-by-tte">
        <center>
          <%= image_tag('tte-logo-no-text.svg')  %>
        </center>
        <spacer size="16"> </spacer>
        <p class="text-center"> Powered by The Talent Enterprises. </p>
      </columns>
    </row>
  </center>
</wrapper>
