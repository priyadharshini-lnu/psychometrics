<style type="text/css">
  body,
  .email-container .body {
    background: #f3f3f3 !important;
  }
  .email-container {
    border: 1px solid #c7d0d4;
    margin: 15px auto;
    max-width: 600px;
    padding: 20px;
    background-color: #FFFFFF;
  }

  .container.header {
    background: #f3f3f3;
  }

  .project-logo {
    margin-bottom: 20px;
    width: 120px;
  }
  .email-privacy-terms, .email-footer a {
    text-decoration: none;
    color: #434A54;
  }

  .email-footer {
    border-top: 1px solid #e7ebee;
    padding: 35px 0;
    color: #A9A9A9;
    font-size: 15px;
  }
  .email-content {
    margin-bottom: 20px;
  }
  .email-copyright img {
    width: 15px;
    vertical-align: middle;
  }
  .email-container p {
    font: 16px/1.2 Arial, sans-serif !important;
    text-align: left !important;
  }
</style>
<!-- move the above styles into your custom stylesheet -->


<spacer size="16"></spacer>

<container class="body-drip email-container">
  <row>
    <columns>
      <% if @resource&.project&.logo.url %>
        <%= image_tag(@resource&.project&.logo.url, class: 'project-logo float-left')%>
      <% end %>
    </columns>
  </row>
  
  <row>
    <columns large="8">
      <%
        subdomain = @resource.admin? || @resource.assessor? ? Settings.subdomain : @resource&.project&.subdomain
        change_password_link = url_for([:edit, @resource.role_scope, :password,  {
          id: @resource, reset_password_token: @token, domain: Settings.domain, subdomain: subdomain
        }])
        name = @resource.decorate.display_name
      %>
      <%=simple_format(t("devise.mailer.reset_password_instructions.body", name: name, change_password_link: change_password_link))%>
      <spacer size="25"></spacer>
    </columns>
  </row>
  <row>
    <columns large="8" class='email-copyright'>
      <%= image_tag("copyright-regular.png") %>
      <%= Time.now.year %> Lighthouse. All rights reserved
    </columns>
  </row>
</container>

<spacer size="16"></spacer>

<container>
   <center>
    <row>
      <columns valign="middle">
        <%= image_tag('tte-logo-no-text.svg')  %>
        <p> Powered by The Talent Enterprises. </p>
      </columns>
    </row>
  </center>
</container>
