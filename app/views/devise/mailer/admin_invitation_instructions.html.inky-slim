spacer[size="48"]
container.email-container
  spacer[size="32"]
  row
    columns
      - if @resource&.project&.logo.url
        = image_tag(@resource&.project&.logo.url, class: 'project-logo float-left')
  row
    columns.email-content
      - options = { id: @resource, invitation_token: @token, domain: Settings.domain, protocol: Settings.protocol, subdomain: Settings.subdomain }
      - accept_url = url_for([:accept, @resource.role_scope, :invitation, options])
      - accept_link = link_to t("devise.mailer.admin_invitation_instructions.accept"), accept_url, target: :blank
      p = simple_format(t("devise.mailer.admin_invitation_instructions.body", name: @resource.decorate.display_name, accept: accept_link))
  row
    columns.email-copyright.footer
      |  © 
      = Time.now.year
      |  Lighthouse. All rights reserved 
  spacer[size="16"]

spacer[size="16"]
wrapper.secondary
  center
    row
      columns.powered-by-tte[valign="middle"]
        center
          = image_tag('tte-logo-no-text.svg')
        spacer[size="16"]

        p.text-center
          |  Powered by The Talent Enterprises.