spacer[size="48"]
container.email-container
  spacer[size="32"]
  row
    columns
      - if @resource&.project&.logo&.url
        = image_tag(@resource&.project&.logo&.url, class: 'project-logo float-left')
  row
    columns.email-content
      - subdomain = @resource.admin? || @resource.assessor? ? Settings.subdomain : @resource&.project&.subdomain
      - change_password_link = url_for([:edit, @resource.role_scope, :password, { id: @resource, reset_password_token: @token, domain: Settings.domain, subdomain: subdomain }])
      - name = @resource.decorate.display_name
      = simple_format(t("devise.mailer.reset_password_instructions.body", name: name, change_password_link: change_password_link))
  row
    columns
      |  <button class="radius small" href 
      = change_password_link
      |  > 
      = t("devise.mailer.reset_password_instructions.change_password")
  row
    columns.email-content
      = simple_format(t("devise.mailer.reset_password_instructions.regards"))
  row
    columns.footer-instruction
      p
        = t("devise.mailer.reset_password_instructions.footer")
  row
    columns.email-copyright.footer
      |  © 
      = Time.now.year
      |  Lighthouse. All rights reserved 
  spacer[size="16"]

spacer[size="16"]
wrapper.secondary
  center
    row
      columns.powered-by-tte[valign="middle"]
        center
          = image_tag('tte-logo-no-text.svg')
        spacer[size="16"]
        p.text-center
          |  Powered by The Talent Enterprises.
          