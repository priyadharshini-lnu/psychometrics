div class=([@current_project&.login_box_position || 'right', 'box', 'devise', namespace_name].compact.join(' '))
  - if @browser_detections && !@browser_detections.preferred_browser?
    = render 'browser_detections'
  .panel.panel-default.session
    .panel-heading
      = render partial: 'devise/shared/header', locals: { banner: @current_project&.logo&.url }

    .panel-body
      /! Nav tabs
      .text-align-c
        ul.nav.nav-tabs
          li.active
            = link_to t('.tabs.sign_in'), new_user_session_path
          li
            = link_to t('.tabs.register'), new_user_registration_path
      /! Tab panes
      .tab-content
        .tab-pane.fade.in.active role="tabpanel"
          .message.pbl
            h1.mvm
              bdi = t('.title')
            - unless @current_project.saml_enforced?
              .instruction
                bdi = t('.instruction')
          div.clearfix
            == flash_messages
          - unless @current_project.saml_enforced?
            = simple_form_for(resource, as: resource_name, url: user_session_path) do |f|
              .username.input-group.mbm
                span#username.input-group-addon
                  i.icon-user
                = f.input_field :email, placeholder: t('.email'), class: 'form-control input-lg'
              .password.input-group.mbm
                span#password.input-group-addon
                  i.icon-lock
                = f.input_field :password, placeholder: t('.password_placeholder'), class: 'form-control input-lg'
              .actions.justified.mvm
                - if devise_mapping.recoverable?
                  bdi = link_to t('.forgot_password'), new_password_path(resource_name)
                button.btn.btn-primary.text-uppercase type="submit" value="Submit"
                  = t('.submit')
                  span class="fa fa-chevron-right mlm"

          - if @current_project.saml_login_allowed?
            .actions.mtl
              = link_to new_saml_user_session_path, class: "btn #{@current_project.saml_enforced? ? 'btn-primary text-light' : 'btn-default'}" do
                i class="fa fa-sign-in mrm"
                = t('.login_with_sso')

    .panel-footer
      = render partial: 'devise/shared/footer'

= render partial: 'devise/shared/locales'
