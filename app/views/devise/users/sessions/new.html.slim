.container
  .row
    .col-xs-12.col-sm-8.col-sm-offet-2.col-md-6.col-md-offset-3.col-lg-4.col-lg-offset-4
      .registrationForm
        /! Nav tabs
        ul.nav.nav-tabs role="tablist"
          li.active.fullWidth role="presentation"
            = link_to t('.tabs.sign_in'), new_user_session_path
          li.fullWidth role="presentation"
            = link_to t('.tabs.register'), new_user_registration_path
        /! Tab panes
        .tab-content
          #signIn.tab-pane.fade.in.active role="tabpanel"
            = simple_form_for(resource, as: resource_name, url: user_session_path) do |f|
              == flash_messages
              .usernameFormGroup
                = f.label :email
                .input-group
                  = f.input_field :email, placeholder: 'email@domain.com', class: 'form-control input-lg'
              .passwordFormGroup
                = f.label :password
                - if devise_mapping.recoverable?
                  span.pull-right.forgotPassword
                    = link_to t('.forgot_password'), new_password_path(resource_name)
                .input-group
                  = f.input_field :password, aria_describedby: "basic-addon2", class: 'form-control input-lg'
              .clearfix
              .stayLoggedIn
                .input-group
                  span.input-group-addon
                    label
                      input class="rememberLogin" type="checkbox" value="1" name="user[remember_me]"
                      span.rememberLogin = t('.keep_sign_in')
              .signInButton
                .input-group
                  button.btn.btn-primary.signIn type="submit" = t('.submit')
