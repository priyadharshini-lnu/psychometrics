.row
  .col-xs-12.col-sm-6.col-sm-offset-3.col-md-6.col-md-offset-3.col-lg-6.col-lg-offset-3
    .registrationForm
      /! Nav tabs
      ul.nav.nav-tabs.formTabs
        li
          = link_to t('.tabs.sign_in'), new_user_session_path
        li.active
          = link_to t('.tabs.register'), new_user_registration_path
      /! Tab panes
      .tab-content
        #register.tab-pane.fade.in.active role="tabpanel"
          = simple_form_for(@form, as: resource_name, url: user_registration_path) do |f|
            div.clearfix
              div class="alert alert-danger"
                = t('simple_form.error_notification.default_message')
                - if flash[:alert]
                  ul
                    li= flash[:alert]
            .loginFormContent
              .firstNameFormGroup
                = f.label :first_name
                .input-group
                  = f.input_field :first_name, placeholder: true, class: 'form-control input-lg'
                = f.error :first_name
              .lastNameFormGroup
                = f.label :last_name
                .input-group
                  = f.input_field :last_name, placeholder: true, class: 'form-control input-lg'
                = f.error :last_name
              .usernameFormGroup
                = f.label :email
                .input-group
                  = f.input_field :email, placeholder: true, class: 'form-control input-lg'
                = f.error :email
              .passwordFormGroup
                = f.label :password
                .input-group
                  = f.input_field :password, placeholder: true, class: 'form-control input-lg'
                = f.error :password
              .passwordFormGroup
                = f.label :password_confirmation
                .input-group
                  = f.input_field :password_confirmation, placeholder: true, class: 'form-control input-lg'
                = f.error :password_confirmation
              .registrationCodeFormGroup
                = f.label :registration_code
                .input-group
                  = f.text_field :registration_code,
                          placeholder: 'Enter the registration code', class: 'form-control input-lg',
                          maxlength: 32, value: @form.context.code
                = f.error :registration_code
              span.clear &nbsp;
              .signInButton
                .input-group
                  button.btn.btn-primary.signIn type="submit" value="Submit" = t('.submit')
    .loginLinks
      = render 'administration/administrator/shared/links'
    .clearfix
