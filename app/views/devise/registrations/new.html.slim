.row
  .col-xs-12.col-sm-6.col-sm-offset-3.col-md-6.col-md-offset-3.col-lg-6.col-lg-offset-3
    .registrationForm
      /! Nav tabs
      ul.nav.nav-tabs.formTabs
        li
          = link_to t('.tabs.sign_in'), new_user_session_path
        li.active
          = link_to t('.tabs.register'), new_user_registration_path
      /! Tab panes
      .tab-content
        #register.tab-pane.fade.in.active role="tabpanel"
          = simple_form_for(@form, as: resource_name, url: user_registration_path, wrapper: :registration_form) do |f|
            = f.error_notification message: f.object.errors[:base].to_sentence
            .loginFormContent
              .firstNameFormGroup.input-group
                = f.input :first_name
              .lastNameFormGroup.input-group
                = f.input :last_name
              .usernameFormGroup.input-group
                = f.input :email
              .passwordFormGroup.input-group
                = f.input :password
              .passwordFormGroup.input-group
                = f.input :password_confirmation
              .registrationCodeFormGroup.input-group
                = f.input :registration_code, as: :string,
                     placeholder: 'Enter the registration code', maxlength: 32, input_html: { value: @form.context.code }
              span.clear &nbsp;
              .signInButton
                .input-group
                  button.btn.btn-primary.signIn type="submit" value="Submit" = t('.submit')
    .clearfix
