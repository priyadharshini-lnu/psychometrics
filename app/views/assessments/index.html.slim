.row
  .col-xs-12
    #assessmentDashboard
      .contentTitleHeader
        i.glyphicon.glyphicon-dashboard.titleIcon.pull-left
        p.contentTitle
          = t('administration.assessments.dashboard')
      - if policy(:user).manager_dashboard?
        .dashboardToggle
          .btn-group.dashboard aria-label="..." role="group"
            = active_link_to t('.user_dashboard_button'), root_path, active: :exclusive, class: 'btn btn-default dashboardButton'
            = active_link_to t('.managers_dashboard_button'), managers_dashboard_index_path, class: 'btn btn-default dashboardButton'
      #accordion.panel-group
        - if @resources.present?
          = render partial: 'resource', collection: @resources
        - else
          tr.no_records
            td align='center' colspan='7' = t('administration.no_data_found')