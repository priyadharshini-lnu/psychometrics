.panel.panel-default
  .panel-heading
    table.table.table-responsive.table-borderless
      thead
        tr
          th
            | Assessment
          th
            | Duration
          th
            | Deadline
          th
            | Progress
          th.text-center
            | Download
      tbody
        tr
          td.col-md-3
            a.collapsed> data-parent="#assessments-#{resource.assessment.category}" data-toggle="collapse" href="##{dom_id(resource.assessment)}"
              span.toggle-icon.glyphicon.glyphicon-chevron-right
              span.toggle-icon.glyphicon.glyphicon-chevron-down
            - if resource.completed?
              span = resource.assessment.name
            - else
              - if resource.assessment.common?
                = link_to resource.assessment.name, [:pass, resource.assessment]
              - else
                = link_to resource.assessment.name, [:pass, :mindmill, resource.assessment], target: :_blank
          td.col-md-2 = resource.assessment.decorate.timing
          td.col-md-2
            | June. 30, 2017
          td.col-md-3
            .progress
              - percent = resource.assessment.decorate.completion_percent
              .progress-bar class=(percent == 100 ? 'progress-bar-success' : 'progress-bar-warning') aria-valuemax="100" aria-valuemin="0" aria-valuenow="#{percent}" role="progressbar" style="width:#{percent}%"
                = "#{percent}%"
          td.text-center.col-md-3
            // Show links to report if it's Common Assessment or it's Completed Assessment
            - if resource.assessment.common? || resource.completed?
              - reports = filter_reports_by_type(@reports.try(:[], resource.assessment.id) || [], resource.norm_type)
              - if reports.any?
                - if reports.size > 1
                  .dropdown
                    button data-toggle="dropdown" type="button" class=" btn dropdown-toggle btn-info #{!resource.completed? ? 'disabled' : ''}"
                      => t('.results')
                      span.caret
                    ul.dropdown-menu
                      - reports.each do |report|
                        - if policy(report).show?
                          li
                            = link_to report.name, report_path(report)
                        - else
                          li.disabled
                            = link_to report.name, "#"
                - elsif policy(reports.sample).show?
                  = link_to t('.results'), report_path(reports.sample), class: "btn btn-info #{!resource.completed? ? 'disabled' : ''}"
              - else
                = link_to t('.results'), '#', class: 'btn btn-info disabled'

            // Show Load Results link if it's not completed Mindmill Assessment
            - if resource.assessment.mindmill? && !resource.completed?
              = link_to 'Load Results', '#', class: "btn btn-info #{!resource.in_progress? ? 'disabled' : ''}"
  .panel-collapse.collapse id=dom_id(resource.assessment)
    hr.divider
    .panel-body
      .well = resource.assessment.decorate.description
