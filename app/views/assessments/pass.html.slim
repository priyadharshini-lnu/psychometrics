.container
  .panel.panel-default.assessment-holder
    .panel-heading
      .title
        i.fa.fa-question-circle-o
        span.contentTitle Questions
      = render partial: 'lang', locals: {with_confirm: true, locales: @available_translations}
      .clearfix
    .panel-body
      .assessment-box
        #psychometrics_preview[data-result="#{AssignSerializer.new(@assign).to_json}"
          data-type="pass_assessment"
          data-data="#{AssessmentSerializer.new(@resource).to_json(include: '**')}"
          data-locales=@translations.to_json]

      = javascript_include_tag :psychometrics_vendor
      = javascript_include_tag :psychometrics_preview