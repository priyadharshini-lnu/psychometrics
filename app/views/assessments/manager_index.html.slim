.row
  .col-xs-12
    #assessmentDashboard
      .contentTitleHeader
        i.glyphicon.glyphicon-dashboard.titleIcon.pull-left
        p.contentTitle
          = t('administration.assessments.dashboard')
      - if policy(@resource_class).manager_dashboard?
        .dashboardToggle
          .btn-group.dashboard aria-label="..." role="group"
            = active_link_to 'User Dashboard', root_path, class: "btn btn-default dashboardButton"
            = active_link_to 'Managers Dashboard', manager_dashboard_assessments_path, class: "btn btn-default dashboardButton"
      #accordion.panel-group
