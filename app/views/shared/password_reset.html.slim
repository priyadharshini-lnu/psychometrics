- password_reset_path = @current_project ? user_password_path : administration_password_path
.row
  .col-xs-12.col-sm-6.col-sm-offset-3.col-md-6.col-md-offset-3.col-lg-6.col-lg-offset-3
    /! Nav tabs
    .formTabs
      h1 = t('.title')
    /! Tab panes
    .content
      p.instructionalText = t('.description')
      = simple_form_for(@form, as: resource_name, url: password_reset_path, wrapper: :vertical_form) do |f|
        div.clearfix
          == flash_messages
        .loginFormContent
          .usernameFormGroup.input-group
            = f.input :email
          span.clear &nbsp;
          .resetPasswordButton
            .input-group.pull-left
              button.btn.btn-primary.signIn type="submit" value="Submit"
                = t('.submit')
          .clearfix
  .clearfix
