<style>
  .subject-relationship-table {
    border-collapse: collapse;
    border: none;
  }

  .subject-relationship-table th {
      font-weight: bold;
      font-size: 14px;
      color: #666;
    }

  .subject-relationship-table td, .subject-relationship-table th {
    padding: 6px 4px;
    font-size: 14px;
    border: 1px solid #eaeaea;
  }
</style>
<table class='subject-relationship-table'>
  <thead>
    <tr>
      <th>Subject Name</th>
      <th>Subject Email</th>
      <th>Subject Relationship</th>
    </tr>
  </thead>
  <tbody>
    <% @participants.each do |participant|%>
      <tr>
        <td><%= participant.subject.decorate.full_name %></td>
        <td><%= participant.subject.email %></td>
        <td><%= participant.relationship.name %></td>
      </tr>
    <% end %>
  </tbody>
</table>
