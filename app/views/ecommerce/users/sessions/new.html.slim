.container
  .row
    .col-xs-12
      #assessmentDashboard
        .contentTitleHeader
          i.glyphicon.glyphicon-log-in.titleIcon.pull-left
          p.contentTitle = t('.sign_in')
        .col-xs-12
          .dashboardToggle
            .btn-group.dashboard role="group"
              = active_link_to t('.sign_in'), new_ecommerce_session_path, class: 'btn btn-default dashboardButton'
              = active_link_to t('.register'), new_ecommerce_registration_path, class: 'btn btn-default'
        .col-xs-12
          .col-md-offset-3.col-md-6
            h3.text-center = t('.sign_in')
            = simple_form_for(resource, as: resource_name, url: ecommerce_session_path, html: { class: 'form-horizontal' }) do |f|
              == flash_messages
              .form-group.col-lg-12
                = f.input :email
              .form-group.col-lg-12
                = f.input :password      
              .form-group.col-lg-12
                = f.submit t('.sign_in'), class: 'btn btn-primary pull-right'
        .clearfix  
