.col-xs-12.product id=dom_id(product)
  #accordion.panel-group
    .panel.panel-default
      .panel-heading
        .hidden-xs.col-sm-1.togglePanel.text-center
          a data-toggle="collapse" href="#collapse_#{dom_id(product)}" 
            span.glyphicon.glyphicon-chevron-up
        .hidden-xs.col-sm-2
          = image_tag(product.image, class: 'img-responsive center-block')
        .col-xs-12.col-sm-9.col-md-5
          .well.assessmentTitleWell
            h3.assessmentTitle = product.name
        .clearfix.visible-sm
        .col-xs-12.col-sm-8.col-md-4.col-lg-2.tabletPadding
          .well.priceWell
            p = humanized_money_with_symbol product.price
        .clearfix.visible-md
        .col-md-8.visible-md
        = form_tag(add_to_cart_ecommerce_product_path(product), remote: true, method: :post, id: "add_to_cart_#{dom_id(product)}")
          .col-xs-6.col-sm-2.col-md-2.col-lg-1.tabletPadding
            = number_field_tag(:quantity, 1, in: 1..100, step: 1, class: 'quantitySelector center-block')
          .col-xs-6.col-sm-2.col-md-2.col-lg-1.tabletPadding
            p
              = link_to 'javascript:{}', onclick: "$('#add_to_cart_#{dom_id(product)}').submit(); return false;"
                = image_tag 'basketIcon.png', class: 'img-responsive center-block'
        .clearfix
      .panel-collapse.collapse.in id="collapse_#{dom_id(product)}"
        .panel-body
          .well.expandedDetailsWell
            p.expandedCopy = simple_format(product.description)
.clearfix  
.coursePreview
  - product.images.each do |image|
    .col-xs-12.col-sm-6.col-md-3
      a href="#"
        = image_tag image.image, class: 'img-responsive center-block courseThumbnail'
  .clearfix  
.clearfix 
