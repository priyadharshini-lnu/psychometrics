.panel.panel-default.assign
  .panel-heading
    table.table.table-responsive.table-borderless
      thead
        tr
          th
            | Assessment
          th
            | Duration
          th
            | Deadline
          th
            | Progress
          th.text-center
            | Download
      tbody
        tr
          td.col-md-3
            a.collapsed> data-parent="#assessments-#{assign.assessment.category}" data-toggle="collapse" href="##{dom_id(assign)}"
              span.toggle-icon.glyphicon.glyphicon-chevron-right
              span.toggle-icon.glyphicon.glyphicon-chevron-down
            - if assign.completed?
              span = assign.assessment.name
            - else
              - if assign.assessment.mindmill?
                - need_confirm = in_progress_assign && in_progress_assign != assign
                = link_to assign.assessment.name, 
                          '#',
                          data: { href: url_for([:pass, :mindmill, assign]),
                                  confirm_text: in_progress_assign && t('.mindmill_confirmation', assessment: in_progress_assign.assessment.name),
                                  need_confirm: need_confirm },
                          class: 'mindmill_link'
              - else
                = link_to assign.assessment.name, [:pass, assign]
          td.col-md-2 = assign.assessment.decorate.timing
          td.col-md-2
            | June. 30, 2017
          td.col-md-3
            .progress
              - percent = assign.assessment.decorate.completion_percent
              .progress-bar class=(percent == 100 ? 'progress-bar-success' : 'progress-bar-warning') aria-valuemax="100" aria-valuemin="0" aria-valuenow="#{percent}" role="progressbar" style="width:#{percent}%"
                = "#{percent}%"
          td.text-center.col-md-3
            // Show links to report if it's Common Assessment or it's Completed Assessment
            - if assign.assessment.common? || assign.completed?
              = render partial: 'reports', locals: { assign: assign }
            // Show Load Results link if it's not completed Mindmill Assessment
            - if assign.assessment.mindmill? && !assign.completed?
              = link_to 'Load Results', results_mindmill_assign_path(assign), class: "btn btn-info #{'disabled' unless assign.in_progress?}"
  .panel-collapse.collapse id=dom_id(assign)
    hr.divider
    .panel-body
      .well = assign.assessment.decorate.description
