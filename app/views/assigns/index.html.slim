#assigns_index
  .row.dashboard-holder
    .col-xs-12.col-md-8.col-md-offset-2
      h1.welcomeText Welcome to your dashboard, #{current_user.decorate.first_name}!
      - if @assigns.blank?
        p = t('administration.no_data_found')
      - else
        .panel-group.assessments-holder id="assessments-1" role="tablist" aria-multiselectable="true"
          - @single_assigns.each do |assign|
            - if show_single_assign?(assign)
              = render partial: 'assign', locals: { assign: assign }
      - if @multiple_reports.present?
        h3.assessmentTitles Multiple assessments
        .panel-group.assessments-holder id="assessments-multiple" role="tablist" aria-multiselectable="true"
          - @multiple_reports.each do |report|
            = render 'assigns_reports', report: report
      - if @threesixty_projects
        .panel-group.assessments-holder id="assessments-multiple" role="tablist" aria-multiselectable="true"
          - @threesixty_projects.each do |campaign|
            = render 'threesixty_campaign', campaign: campaign
= render partial: '//assigns/modals/accept_privacy'
