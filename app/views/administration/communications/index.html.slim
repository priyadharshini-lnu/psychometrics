.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        .pull-right
          - if policy(Communication).create?
            = link_to [:new, :administration, resource_class.model_name.singular.to_sym], remote: true, class: 'btn btn-default'
              span.fa.fa-plus
              = t('.new')
        #communications_filters
          = render partial: 'filters'
      .panel-body
        #filter_results
          = render partial: 'list'

= vite_javascript_tag 'entrypoints/admin/communication_form_app.jsx'
= vite_javascript_tag 'entrypoints/admin/translation_form_app.jsx'
