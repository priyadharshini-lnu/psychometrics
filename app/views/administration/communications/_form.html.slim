= simple_form_for(@communication_facade.form,
  as: :resource, url: { action: @communication_facade.communication.new_record? ? :create : :update },
  remote: true,
  data: { behavior: 'communications-form', form_url: @communication_facade.communication.decorate.form_url }) do |f|
  .modal-body
    = f.error_notification
    .form-inputs.clearfix
      h3 Settings
      - if current_user.is?(:superadmin)
        = f.association :owner, collection: @communication_facade.owners, include_blank: t('administration.tte'),
          input_html: { data: { live_search: true, behavior: @communication_facade.owner_behavior } }
      - unless current_user.is?(:superadmin) && @communication_facade.communication.owner_id.present?
        = f.association :client,
          collection: @communication_facade.owners,
          input_html: { data: { live_search: true, behavior: @communication_facade.client_behavior } }
      - if @communication_facade.show_projects?
        = f.association :project,
          collection: @communication_facade.projects,
          input_html: { data: { live_search: true,
            behavior: @communication_facade.project_behavior } }
      - if @communication_facade.show_campaigns?
        = f.association :campaign,
          collection: @communication_facade.campaigns,
          input_html: { data: { live_search: true,
            behavior: @communication_facade.campaign_behavior } }
      - if @communication_facade.show_sub_campaigns?
        = f.association :sub_campaign,
          collection: @communication_facade.sub_campaigns,
          input_html: { data: { live_search: true,
            behavior: @communication_facade.sub_campaign_behavior } }
      - if @communication_facade.show_kind?
        = f.input :kind,
          as: :select,
          collection: Communication.kinds,
          value_method: :first,
          label_method: proc { |rec| t(".#{rec.first}") },
          input_html: { data: { live_search: true,
            behavior: 'communication-changeable' } },
          label: t('.kind')
      - if @communication_facade.show_assessments?
        = f.association :assessment,
            collection: @communication_facade.assessments,
            input_html: { data: { live_search: true } }
      - if @communication_facade.show_recipients?
        = f.input :recipients,
          as: :select,
          collection: Communication.recipients,
          value_method: :first,
          label_method: proc { |rec| t(".#{rec.first}") },
          include_blank: false,
          input_html: { data: { live_search: true,
            behavior: 'communication-changeable' } }
      - if @communication_facade.show_memberships?
        = f.association :users,
          collection: @communication_facade.memberships,
          label_method: proc { |u| u.decorate.display_name },
          value_method: proc { |u| u.id },
          include_blank: false,
          input_html: { data: { live_search: true,
            behavior: @communication_facade.memberships_behavior },
            multiple: true }, label: t('.selected_recipients')
      - if @communication_facade.show_delivery_rules?
        .row.mbl
          .col-md-4.pln
            = f.input :delivery_rule,
              as: :select,
              collection: @communication_facade.delivery_rules,
              label_method: proc { |rec| t("administration.communications.form.delivery_rules.#{rec}") },
              input_html: { data: { live_search: true, behavior: 'communication-changeable' } }
          - if @communication_facade.show_inputs_for_date_and_time?
            .col-md-8.prn
              = f.input :delivery_at, as: :datetimepicker, initialize_time_now: true,
                label: t('.delivery_at'),
                min_date: date_without_seconds_and_timezone
      - if @communication_facade.show_delivery_intervals?
        .form-group
          = f.collection_radio_buttons :reminder_type, @communication_facade.reminder_types, :last, :first, {},
            data: { behavior: 'communication-changeable' } do |b|
            = b.label(class: 'mrl') { b.radio_button(class: 'mrs') + b.text }

        - if @communication_facade.show_timeframes_reminder?
          = f.input :delivery_interval, collection: ::Helpers::Communications.reminder_timeframes
        - if @communication_facade.show_custom_reminder?
          .row.mbl
            .col-md-4.pln
              = f.input :delivery_interval_period,
                as: :select,
                collection: @communication_facade.delivery_interval_periods
            .col-md-4
              = f.input :delivery_interval_number, as: :integer
        .row.mbl
          .col-md-4.pln
            = f.input :stop_reminder, as: :boolean, checked_value: true, unchecked_value: false,
              label: t('.stop_reminder'),
              input_html: { data: { behavior: 'communication-changeable' } }
          .col-md-8
            - if @communication_facade.show_stop_reminder_datetime?
              = f.input :stop_reminder_datetime, as: :datetimepicker, initialize_time_now: true,
                label: t('.stop_reminder_datetime'),
                min_date: date_without_seconds_and_timezone
      h3 Message
      = f.input :subject
      = f.input :body, input_html: { class: 'summernote_email' }
      = simple_format(t('.body_mustache'))

  .modal-footer
    .btn-group
      = f.button :submit, @communication_facade.communication.new_record? ? t('administration.create') : t('administration.update'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
