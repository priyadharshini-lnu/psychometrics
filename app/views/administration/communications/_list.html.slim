.table-responsive
  table.table.table-bordered.table-actions.table-hover.selectable.list id="#{resource_class.model_name.plural}_list"
    thead
      tr
        th = link_to_sort resource_class, :client_name, filter_form
        th.text-center = t('.project')
        th.text-center = t('.campaign')
        th.text-center = t('.sub_campaign')
        th.text-center = link_to_sort resource_class, :subject, filter_form
        th.text-center = t('.kind')
        th.text-center = t('.recipients')
        th.text-center = t('.delivery_rule')
        th.text-center = link_to_sort resource_class, :created_at, filter_form
        th.text-center = link_to_sort resource_class, :creator_first_name, filter_form
        th.text-center = t('.list.actions')
    tbody
      - if resources.present?
        = render partial: 'resource', collection: resources
      - else
        tr.no_records
          td align='center' colspan='9' = t('administration.no_data_found')
  = paginate resources, theme: 'twitter-bootstrap-3'
