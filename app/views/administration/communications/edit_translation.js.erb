$('#modal-container').html('<%= j render(partial: "edit_translation_modal") %>');
var $modal = $('#modal-container .modal');
$modal.modal('show');

$modal.on('shown.bs.modal', function() {
  var initialLocale = $('#locale').val();
  if (initialLocale === 'ar') {
    $('body').attr('data-locale', 'ar');
  }

  if (window.I18n && initialLocale) {
    window.I18n.locale = initialLocale;
  }

  if (typeof renderTranslationForm === 'function') {
    renderTranslationForm('translation_froala_editor');
  }
});

$('#edit_translation_form').off('ajax:success ajax:error');

$modal.on('change', '#locale', function() {
  var selectedLocale = $(this).val();
  var communicationId = '<%= @communication.id %>';

  $('body').attr('data-locale', selectedLocale);

  $.ajax({
    url: '<%= edit_translation_administration_communication_path(@communication) %>',
    method: 'GET',
    data: { locale: selectedLocale },
    dataType: 'json',
    success: function(response) {
      $('#communication_subject').val(response.translated_subject);
      var $referenceSubject = $('[data-copy-text]').first().closest('.form-control-static').find('.flex-grow-1');
      $referenceSubject.text(response.reference_subject || 'No reference subject available');
      $('[data-copy-text]').first().attr('data-copy-text', response.reference_subject);
      var $referenceBody = $('.form-control-static').last();
      var referenceBody = $referenceBody[0]
      $referenceBody.empty();
      if (response.reference_body) {
        response.reference_body.split('\n').forEach(function(line, index, arr) {
          referenceBody.appendChild(document.createTextNode(line));
          if (index < arr.length - 1) {
            referenceBody.appendChild(document.createElement('br'));
          }
        });
      } else {
        $referenceBody.text('No reference body available');
      }
      $('[data-copy-text]').last().attr('data-copy-text', response.reference_body);
      $('#translation_body_value').val(response.translated_body);

      if (window.FroalaEditor && $('#translation_froala_editor').data('froala.editor')) {
        $('#translation_froala_editor').froalaEditor('destroy');
      }

      if (window.I18n) {
        window.I18n.locale = selectedLocale;
      }

      if (typeof renderTranslationForm === 'function') {
        renderTranslationForm('translation_froala_editor');
      }
    },
    error: function() {
      noty({ text: 'Error loading translation data', type: 'error' });
    }
  });
});

function copyToClipboard(button) {
  var textToCopy = button.getAttribute('data-copy-text');
  if (textToCopy) {
    Utils.copyToClipboard(textToCopy);
    noty({ text: 'Text copied to clipboard successfully', type: 'success' });
  }
}

window.copyToClipboard = copyToClipboard;

$modal.find('.copy-btn').on('click', function() {
  copyToClipboard(this);
});

$('#edit_translation_form').on('ajax:success', function(event, data, status, xhr) {
  var response = data;
  if (response.success) {
    if (response.message) {
      noty({text: response.message, type: 'success'});
    }

    $modal.modal('hide');
    $modal.on('hidden.bs.modal', function() {
      $(this).remove();
      delete window.copyToClipboard;
      location.reload();
    });
  }
}).on('ajax:error', function(event, xhr, status, error) {
  var response = xhr.responseJSON;

  $('.modal-body .alert-danger').remove();

  if (response && response.errors) {
    var errorHtml = '<div class="alert alert-danger"><ul>';
    $.each(response.errors, function(field, messages) {
      $.each(messages, function(index, message) {
        errorHtml += '<li>' + field + ': ' + message + '</li>';
      });
    });
    errorHtml += '</ul></div>';
    $('.modal-body').prepend(errorHtml);
  } else {
    var errorHtml = '<div class="alert alert-danger">An error occurred while updating the translation. Please try again.</div>';
    $('.modal-body').prepend(errorHtml);
  }
});

$modal.on('hidden.bs.modal', function() {
  delete window.copyToClipboard;
  $(this).remove();
  location.reload();
});
