tr data-sidebar=url_for([:sidebar, :administration, resource]) id=dom_id(resource)
  td = resource.decorate.client_name
  td = resource.decorate.projects
  td = resource.decorate.campaigns
  td = resource.campaign_assessment_group.present? ? resource.campaign_assessment_group.name : "N/A"
  td.subject-column = resource.subject
  td = resource.decorate.kind
  td = render_selected_recipient_users(resource) || resource.recipients
  td = resource.delivery_rule_i18n
  td = resource.decorate.created_at
  td = resource.decorate.author
  td.actions-cell
    - if policy(resource, { project_id: resource.project_id }).show?
      = link_to administration_communication_path(resource, q: @active_filter_params), class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.view') }
        span.fa.fa-eye
    - if policy(resource, { project_id: resource.project_id }).download_history?
      = link_to [:download_history, :administration, resource], class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.download') }
        span.fa.fa-download
    - if policy(resource, { project_id: resource.project_id }).copy?
      = link_to [:copy, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.copy'), disable_with: t('.in_progress.copying') }
        span.fa.fa-copy
    - if policy(resource, { project_id: resource.project_id }).edit_translation?
      = link_to [:edit_translation, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.edit_translation') }
        span.fa.fa-language
    - if policy(resource, { project_id: resource.project_id }).destroy?
      = link_to [:administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', method: 'delete', data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete'), disable_with: t('.in_progress.deleting') }
        span.fa.fa-times
