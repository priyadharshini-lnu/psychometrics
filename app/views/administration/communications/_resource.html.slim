tr data-sidebar=url_for([:sidebar, :administration, resource]) id=dom_id(resource)
  td = resource.decorate.client_name
  td = resource.decorate.projects
  td = resource.decorate.campaigns
  td = resource.decorate.sub_campaigns
  td = resource.subject
  td = resource.decorate.kind
  td = resource.recipients
  td = resource.delivery_rule_i18n
  td = resource.decorate.created_at
  td = resource.decorate.author
  td.actions-cell
    - if policy(resource).actions?
      = link_to administration_communication_path(resource), class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.view') }
        span.fa.fa-eye
      = link_to [:download_history, :administration, resource], class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.download') }
        span.fa.fa-download
      = link_to [:copy, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.copy') }
        span.fa.fa-copy
      = link_to [:administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', method: 'delete', data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete')}
        span.fa.fa-times
