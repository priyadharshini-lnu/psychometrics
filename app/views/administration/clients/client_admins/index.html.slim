.row
  .col-md-12
    .page-title
      h2.mrl = client.decorate.display_name
      = render 'administration/clients/clients_menu'
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        = search_form_for(filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          = f.input :filterable_fields,
                    label: false,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    input_html: { class: 'has_clear periodically-observed', value: @filter_term }
          = link_to "Clear Filter", request.path, class: "btn btn-default"
        .pull-right
          - if policy(:membership).can_manage_client_admins?
              .add-icon-box
                = link_to new_step_one_administration_client_client_admins_path(client), remote: true, class: 'btn btn-default'
                  span.fa.fa-plus
                  = t('common.actions.add')
      .panel-body
        #filter_results
          = render partial: 'list'
