= hidden_field_tag 'resource[grants_attributes][data]{}'
table.table.grants-table
  thead
    tr
      th Entity
      th.actions Privileges
  tbody
    - if policy(:membership).manage_grants_for_actions?('clients', ['view', 'view_licenses'], client: client)
      tr
        td Clients
        td
          div.grants-grid
            - if policy(:membership).manage_grants_for_action?('clients', 'view', client: client)
              label
                = check_box_tag 'resource[grants_attributes][data][clients][]',
                        'view', resource.has_grant?(:clients, :view), id: clients_view_id
                | View
            - if policy(:membership).manage_grants_for_action?('clients', 'view_licenses', client: client)
              label
                = check_box_tag 'resource[grants_attributes][data][clients][]',
                        'view_licenses', resource.has_grant?(:clients, :view_licenses), id: clients_view_licenses_id
