.row
  .col-md-12
    .page-title
      h2.mrl = client.decorate.display_name
      = render partial: 'administration/clients/top_nav'
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        - if policy(resource_class).create?
          .pull-right
            = link_to(new_administration_client_assign_reports_path(client_id: client.id), remote: true, class: 'btn btn-default')
              span.fa.fa-plus
              = t('.add')
        - if policy(BulkReport).new?
          .pull-right
            = link_to(new_administration_bulk_report_path(client_id: client.id), remote: true, class: 'btn btn-default')
              span.fa.fa-download
              = t('.bulk_download')
        = search_form_for(filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|

          = f.input :report_assessments_category_in,
                    collection: ::Assessment::CATEGORIES,
                    input_html: { title: 'Category '},
                    include_blank: t('administration.any'),
                    label: false
          = f.input :report_assessments_id_in,
                    collection: policy_scope(Assessment).all.options_for_select,
                    input_html: { data: { live_search: true }, multiple: true, title: 'Assessment' },
                    required: false,
                    label: false
          = f.input :report_name_cont,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed' }
          = link_to "Clear Filter", request.path, class: "btn btn-default"
      .panel-body
        #filterrific_results
          = render partial: 'list'
