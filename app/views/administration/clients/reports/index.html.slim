.row
  .col-md-12
    .page-title
      h2.mrl = @client.decorate.display_name
      = active_link_to(t('administration.navigation.users'), administration_client_users_path(@client), class: 'btn btn-default')
      - if policy(:report).index?
        = active_link_to(t('administration.navigation.reporting'), administration_client_reports_path, class: 'btn btn-default')
      - if policy(@client).design?
        = active_link_to(t('administration.navigation.design'), edit_administration_client_designs_path, remote: true, class: 'btn btn-default')
    
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        .pull-right
          .btn-group
            - if policy(@resource_class).create?
              = link_to({ action: :new }, remote: true, class: 'btn btn-default')
                span.fa.fa-plus
                = t('.add')
      .panel-body
        = form_for_filterrific @filterrific, as: :filterrific, html: { class: 'form-inline', id: 'filter' } do |f|
          = f.hidden_field :sorted_by
          .row.mbm
            .col-sm-6.phn
              .btn-group data-toggle="buttons"
                - @filterrific.select_options[:with_assessment_category].each do |value|
                  label class="btn btn-default #{'active' if f.object.with_assessment_category == value}"
                    = f.radio_button(:with_assessment_category, value)
                    = t(".filterrific.with_assessment_category.#{value}")
              .form-group
                = f.select(:with_assessment, policy_scope(Assessment).all.options_for_select, { include_blank: t('administration.any') }, class: 'form-control select mll')
            .col-md-3.col-md-offset-3.col-sm-4.col-sm-offset-2.phn
              .form-group.has-feedback.has-clear.pull-right
                .input-group
                  = f.text_field(:search_query, placeholder: t('administration.search'), class: 'periodically-observed form-control')
                span.glyphicon.glyphicon-remove-sign.form-control-feedback.form-control-clear
          .clearfix
        #filterrific_results
          = render partial: 'list'
