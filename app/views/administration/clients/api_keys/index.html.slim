.row
  .col-md-12
    .page-title
      h2.mrl = client.decorate.display_name
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title', name: @user.decorate.display_name)
        .pull-right
          - if policy(resource_class).create?
            = link_to({ action: :create },
                      remote: true,
                      method: :post,
                      class: 'btn btn-default',
                      data: { loading_text: t('loading'), confirm: resource.decorate.create_confirmation })
              span.fa.fa-plus
              = t('.new')
        = search_form_for(filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
      .panel-body
        #filter_results
          = render partial: 'list'
