.row
  .col-md-12
    /.btn-group.mbm
      - %w(users reports designs).each do |value|
        = link_to [:administration, @resource_class.model_name.plural, filterrific: { with_category: value } ], class: "btn btn-default"
          = t(".filterrific.with_category.#{value}")
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        ul.panel-controls
          li
            = link_to [:new, :administration, @resource_class.model_name.singular], remote: true, data: { toggle: 'tooltip', title: t('.tooltips.create') }
              span.fa.fa-plus
      .panel-body
        = form_for_filterrific @filterrific, html: { class: 'form-inline', id: 'filter' } do |f|
          .row.mbm
            .col-sm-6.phn
            .col-md-3.col-md-offset-3.col-sm-4.col-sm-offset-2.phn
              .form-group.has-feedback.has-clear.pull-right
                .input-group
                  = f.text_field(:search_query, placeholder: t('administration.search'), class: 'periodically-observed form-control')
                span.glyphicon.glyphicon-remove-sign.form-control-feedback.form-control-clear
            .clearfix
        #filterrific_results
          = render partial: 'list'
