.modal.fade role='dialog' tabindex='-1' data-backdrop='static'
  .modal-dialog
    .modal-content
      .modal-header
        button.close aria-hidden='true' data-dismiss='modal' type='button'  &times;
        h4.modal-title= t('.select_type')
      = form_tag(administration_client_assessment_export_results_path(client, resource, format: 'xlsx'), method: :get, id: 'export_type_select_form') do
        .modal-body
          div
            = radio_button_tag :export_with_labels, false, true, class: 'form-check-input mrs'
            = label_tag :export_with_labels, t('.export_without_labels'), class: 'form-check-label'
          div
            = radio_button_tag :export_with_labels, true, false, class: 'form-check-input mrs'
            = label_tag :export_with_labels, t('.export_with_labels')
        .modal-footer
          .btn-group
            = button_tag 'Export', type: 'submit', class: 'btn btn-default btn-info'
            a.btn.btn-default data-dismiss='modal' = t 'administration.close'
