tr id=dom_id(resource)
  td = resource.name
  td = resource.decorate.created_at
  td = resource.decorate.anonym_link_for(@client)
  td 
    - if policy(:assessment).export_results?
      = link_to 'Export Results', 
        administration_client_assessment_export_results_path(@client, resource, format: 'xlsx'),
        class: 'btn btn-default'
    - if policy(:assessment).import_results?
      = link_to 'Import Results', 
        new_administration_imports_results_path(client_id: @client.id, assessment_id: resource.id), 
        remote: true,
        class: 'btn btn-default'
