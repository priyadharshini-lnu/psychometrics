tr id=dom_id(resource)
  td = resource.id
  td = resource.name
  td = resource.decorate.created_at
  - if client.tenancy?
    td = resource.decorate.clients_names
  td = resource.decorate.anonym_link_for(client)
  td.actions-cell
    - if policy(resource).can_configure_universal_links?
      .btn-group
        button.btn.btn-default.btn-rounded.dropdown-toggle.btn-sm.mrm data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" type="button"
          .i.fa.fa-link
          =<> t('.configure')
          span.caret
        ul.dropdown-menu
          - unless client.assessment_universal_links_enabled?(resource.id)
            li
              = link_to t('.activate_universal_link'),
                administration_client_assessment_enable_universal_links_path(client, resource),
                remote: true,
                method: :put
          - if client.assessment_universal_links_enabled?(resource.id)
            li
              = link_to t('.deactivate_universal_link'),
                administration_client_assessment_disable_universal_links_path(client, resource),
                remote: true,
                method: :put
          - if client.has_assessment_key?(resource)
            li
              = link_to t('.regenerate_universal_link'),
                administration_client_assessment_generate_universal_link_path(client, resource),
                remote: true,
                method: :post,
                data: { confirm: resource.decorate.universal_link_regeneration_confirmation }
          - if client.assessment_universal_links_enabled?(resource) && !client.has_assessment_key?(resource)
            li
              = link_to t('.generate_universal_link'),
                administration_client_assessment_generate_universal_link_path(client, resource),
                remote: true,
                method: :post
    - if policy(resource).export_results?
      .btn-group
        button.btn.btn-default.btn-rounded.dropdown-toggle.btn-sm.mrm data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" type='button'
          i.fa.fa-download
          =<> t('.export_results')
          span.caret
        ul.dropdown-menu
          - if policy(resource).export_scoring_results?
            li
              = link_to t('.scoring_results'), administration_client_assessment_export_results_path(client, resource, format: 'xlsx', scoring: true)
          - if policy(resource).export_raw_results?
            li
              = link_to t('.raw_results'), administration_client_assessment_export_results_path(client, resource, format: 'xlsx')
          - if policy(resource).export_normed_results?
            li
              = link_to t('.normed_results'), administration_client_assessment_export_normed_results_path(client, resource, format: 'xlsx')
          - if policy(resource).export_mindmill_results?
            li
              = link_to t('.mindmill_results'), administration_client_assessment_export_results_path(client, resource, format: 'xlsx', external: true)
          - if policy(resource).export_hogan_results?
            - hogan_reports_for_assessment(resource).each do |report|
              li
                = link_to report.name,
                          administration_client_assessment_export_hogan_results_path(client, resource, format: 'xlsx',
                                                                                    report_id: report.id)

    - if policy(:assessment).import_results? && resource.common?
      .btn-group
        button.btn.btn-default.btn-rounded.dropdown-toggle.btn-sm.mrm data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" type='button'
          i.fa.fa-upload
          =<> t('.import_results')
          span.caret
        ul.dropdown-menu
          li
            = link_to t('.scoring_results'),
                      new_administration_imports_results_path(client_id: client.id, assessment_id: resource.id, scoring: true),
                      remote: true
          li
            = link_to t('.raw_results'),
                      new_administration_imports_results_path(client_id: client.id, assessment_id: resource.id),
                      remote: true
