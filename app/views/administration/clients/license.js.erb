<% if @resource.errors.empty? %>
  $('#modal-container').html('<%= j render(partial: "modal", locals: { form: "license", header: t('.header', name: @resource.decorate.display_name) }) %>');
  $('#modal-container').find(".modal").modal('show');
  $('#modal-container').find(".modal").on('hidden.bs.modal', function (e) {
    $(this).remove();
  });
<% else %>
  $('#modal-container').find("form").html('<%= j render(partial: "license") %>');
<% end %>

// Reinit all plugins
$(document).trigger('initPlugins');
