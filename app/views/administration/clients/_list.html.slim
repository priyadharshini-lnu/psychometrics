.table-responsive
  table.table.table-bordered.table-actions.selectable.list.tenancies id="#{resource_class.model_name.plural}_list"
    thead
      tr
        th = link_to_sort resource_class, :name, filter_form
        - if policy(:client).view_additional_fields?
          th = link_to_sort resource_class, :type, filter_form
          th = link_to_sort resource_class, :number, filter_form
          th = link_to_sort resource_class, :location, filter_form
        th width='1%' = link_to_sort resource_class, :year, filter_form
        - if current_user.is?(:superadmin)
          th.report_family = t('.report_bundle')
          th.used_number = t('.used_license_number')
          th.overuse = t('.used_license_overuse_number')
          th.usage_percent = t('.usage_percent')
          th.start_date = t('.start_date')
          th.end_date = t('.end_date')
        th = t('.client_admins')
        th = link_to_sort resource_class, :account_manager_id, filter_form
        th = link_to_sort resource_class, :project_manager_id, filter_form
        - if policy(:client).edit_tte?
          th.text-center width='1%' = t 'administration.actions'
    - if resources.present?
      = render partial: 'resource', collection: resources
    - else
      tr.no_records
        td align='center' colspan='8' = t('administration.no_data_found')
  = paginate resources, theme: 'twitter-bootstrap-3'
