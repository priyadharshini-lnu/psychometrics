tr data-sidebar=url_for([:sidebar, :administration, resource]) id=dom_id(resource)
  td
    - if resource.retail?
      = link_to resource.name, administration_client_users_path(resource)
    - else
      = link_to resource.name, administration_client_projects_path(resource)
  td = resource.decorate.type
  td = resource.number
  td = resource.country
  td = resource.decorate.project_admins
  td = resource.year
  td = resource.account_manager&.decorate&.display_name
  td = resource.project_manager&.decorate&.display_name
  td.actions-cell
    - if policy(resource).actions?
      = link_to [:edit, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.edit') }
        span.fa.fa-pencil
      = link_to [:copy, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.copy') }
        span.fa.fa-copy
      = link_to [:administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', method: 'delete', data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete')}
        span.fa.fa-times
