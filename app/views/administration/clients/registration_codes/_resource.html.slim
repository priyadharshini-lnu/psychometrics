tr id=dom_id(resource)
  td.text-center
    = link_to({ action: :toggle_status, id: resource }, remote: true,
            method: :patch, data: { confirm: resource.decorate.toggle_status_confirmation })
      = resource.decorate.status
  td = resource.name
  td = resource.code
  td = resource.decorate.formatted_date_time(:start_date)
  td = resource.decorate.formatted_date_time(:end_date)
  td = resource.decorate.get_usage_stats
  td.actions-cell
    button.btn.btn-default.btn-rounded.btn-xs.copy-coded-url data-toggle="tooltip" data-title="#{resource.decorate.url}"
      span.fa.fa-copy
    .btn-group
      button.btn.btn-default.btn-rounded.dropdown-toggle.btn-sm data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" type="button"
        .i.fa.fa-qrcode
        =<> t('.qr_code')
        span.caret
      ul.dropdown-menu
        li
          = link_to download_qrcode_administration_client_registration_code_path(id: resource.id, type: t('.png'), format: 'png')
            .i.fa.fa-download
            =<> t('.png')
        li
          = link_to download_qrcode_administration_client_registration_code_path(id: resource.id, type: t('.svg'), format: 'svg') do
            .i.fa.fa-download
            =<> t('.svg')
    = link_to edit_administration_client_registration_code_path(client_id: client.id, id: resource.id), remote: true,
        class: 'btn btn-default btn-rounded btn-sm edit', data: {toggle: 'tooltip', title: t('.tooltips.edit')} do
      span.fa.fa-pencil
    = link_to({ action: :destroy, id: resource.id }, remote: true,
        class: 'btn btn-default btn-rounded btn-sm mn', method: :delete,
        data: { confirm: resource.decorate(context: { resource_name: resource.decorate.display_name }).delete_confirmation,
        toggle: 'tooltip', title: t('.tooltips.delete') })
      span.fa.fa-times
