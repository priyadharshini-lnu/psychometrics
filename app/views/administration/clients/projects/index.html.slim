.row
  .col-md-12
    .page-title
      h2.mrl = client.decorate.display_name
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        ul.panel-controls
          li
            = link_to [:new, :administration, client, :project], remote: true,  data: { toggle: 'tooltip', title: t('.tooltips.create') }
              span.fa.fa-plus
        = search_form_for(@filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          = f.input :name_cont,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed' }              
      .panel-body
        #filter_results
          = render partial: 'list'
