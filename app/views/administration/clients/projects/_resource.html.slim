- if current_user.is?(:superadmin) || current_user.is?(:client_admin) || resource.project_admin_ids.include?(current_user.id)
  tr data-sidebar=url_for(sidebar_administration_client_project_path(client, resource)) id=dom_id(resource)
    td.nowrap
      - if resource.project_level?
        = link_to resource.decorate.display_name, administration_client_users_path(resource)
      - else
        = link_to resource.decorate.display_name, administration_client_project_campaigns_path(client, resource)
    td = t("activerecord.attributes.client.applicable_levels.#{resource.applicable_level}")
    td = resource.number
    td
      - if resource.project_level?
        strong.nowrap
          = t('.assessments')
          = link_to edit_administration_client_assign_assessments_path(resource.id), class: 'mlm', remote: true
            span.fa.fa-pencil
        div
          - resource.assessments.each do |assessment|
            span.mrs.mbs data-toggle='tooltip' data-title=assessment.name
              = assessment.decorate.icon
        - if policy(:assign).create?
          .add-icon-box.nowrap
            = link_to new_administration_client_assign_assessments_path(client_id: resource.id), remote: true
              span.fa.fa-plus
              =< t('.add_assessment')
    td
      - if resource.project_level?
        - resource.clients_reports.includes(:report_family, :report).group_by(&:report_family).each do |report_family, reports|
          div
            - if report_family
              strong.nowrap
                = report_family.name
                = link_to edit_administration_client_assign_reports_path(resource.id, report_family_id: report_family.id), class: 'mlm', remote: true
                  span.fa.fa-pencil
              .clearfix
            - reports.each do |report|
              span.mrs.mbs data-toggle='tooltip' data-title=report&.report&.name
                = report&.report&.decorate&.icon
        - if policy(:clients_report).create?
          .add-icon-box.nowrap
            = link_to new_administration_client_assign_reports_path(resource.id), remote: true
              span.fa.fa-plus
              =< t('.add_report')
    td = resource.assigned_memberships.size
    td = resource.completed_memberships.size
    td
      - if resource.project_level?
        = link_to resource.end_memberships.size, administration_client_users_path(resource)
        - if policy(Membership).create?
          .add-icon-box
            = link_to new_administration_client_user_path(client_id: resource.id), remote: true, data: { toggle: 'tooltip', title: t('.tooltips.create_user') }
              span.fa.fa-plus
    td = resource.parent.account_manager&.decorate&.display_name
    td
      = resource.decorate.client_project_admins
      - if policy(:membership).create_project_admin?
        .add-icon-box
          = link_to new_step_1_administration_client_project_admins_path(client_id: resource.id), remote: true, data: { toggle: 'tooltip', title: t('.tooltips.create_admin') }
            span.fa.fa-plus
    td = resource.decorate.url
    - if current_user.is?(:superadmin)
      td = resource.decorate.actual_usage
    td.text-center = resource.decorate.created_at
    td = resource.decorate.creator_name
    td.text-center = resource.decorate.updated_at
    td = resource.decorate.modifier_name
    td.actions-cell
      - if policy(resource).actions? && policy(:client).manage_project?
        = link_to({ action: :edit, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.edit') })
          span.fa.fa-pencil
        = link_to({ action: :copy, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.copy') })
          span.fa.fa-copy
        = link_to({ action: :destroy, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm', method: 'delete', data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete')})
          span.fa.fa-times
