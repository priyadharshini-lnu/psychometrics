.table-responsive
  table.table.table-bordered.table-actions.table-hover.selectable.list id="#{resource_class.model_name.plural}_list"
    thead
      tr
        th = link_to_sort resource_class, :id, filter_form
        th = link_to_sort resource_class, :name, filter_form
        th = t('.applicable_level')
        th = link_to_sort resource_class, :number, filter_form
        th = t('.assessments')
        th = t('.reports')
        th = t('.assigned_user')
        th = t('.completed_user')
        th = t('.users_count')
        th = t('.tte_admin')
        th = t('.project_admin')
        th = t('.url')
        - if current_user.is?(:superadmin)
          th = t('.actual_usage')
        th.date = link_to_sort resource_class, :created_at, filter_form
        th = t('administration.created_by')
        th.date = link_to_sort resource_class, :updated_at, filter_form
        th = t('administration.modified_by')
        th width='1%' = t('administration.actions')
    tbody
      - if resources.present?
        = render partial: 'resource', collection: resources
      - else
        tr.no_records
          td align='center' colspan='18' = t('administration.no_data_found')
  = paginate resources, theme: 'twitter-bootstrap-3'
