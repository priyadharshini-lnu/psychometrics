tbody id=dom_id(resource)
  - if resource.project.sub_campaign_level?
    tr data-sidebar=url_for(sidebar_administration_client_project_campaign_path(client, project, resource))
      - rowspan = resource.children.enabled.count + 2
      td rowspan=rowspan
        = link_to resource.decorate.display_name, administration_client_project_campaign_sub_campaigns_path(client, project, resource)
      - if current_user.is?(:superadmin)
        td rowspan=rowspan = resource.decorate.actual_usage
    = render partial: 'administration/clients/projects/campaigns/sub_campaigns/resource', collection: resource.children.enabled, as: :resource, locals: {campaign: resource}
    tr
      td.text-center colspan='5'
        - unless resource.archived?
          = link_to t('.sub_campaign.create'),
                    new_administration_client_project_campaign_sub_campaign_path(client, project, resource),
                    remote: true
  - else
    tr data-sidebar=url_for(sidebar_administration_client_project_campaign_path(client, project, resource))
    td
      = link_to resource.name, administration_client_users_path(resource)
      td
        - if resource.project_level?
          strong = t('.assessments')
          div
            - resource.assessments.each do |assessment|
              span.mrm data-toggle='tooltip' data-title=assessment.name
                = assessment.decorate.icon
          - if policy(:clients_report).create?
            .add-icon-box.nowrap
              = link_to new_administration_client_assign_assessments_path(client_id: resource.id), remote: true
                span.fa.fa-plus
                =< t('.add_assessment')
      td
        - if resource.project_level?
          - resource.clients_reports.includes(:report_family, :report).group_by(&:report_family).each do |report_family, reports|
            div
              - if report_family
                strong.nowrap
                  = report_family.name
                  = link_to edit_administration_client_assign_reports_path(resource.id, report_family_id: report_family.id), class: 'mlm', remote: true
                    span.fa.fa-pencil
                .clearfix
              - reports.each do |report|
                span.mrm data-toggle='tooltip' data-title=report&.report&.name
                  = report&.report&.decorate&.icon
          .add-icon-box.nowrap
            = link_to new_administration_client_assign_reports_path(resource.id), remote: true
              span.fa.fa-plus
              =< t('.add_report')
      td
        = link_to resource.end_memberships.size, administration_client_users_path(resource)
        - if policy(User).create?
          .add-icon-box
            = link_to new_administration_client_user_path(client_id: resource.id), remote: true, data: { toggle: 'tooltip', title: t('.tooltips.create_user') }
              span.fa.fa-plus
      - if current_user.is?(:superadmin)
        td = resource.decorate.actual_usage
