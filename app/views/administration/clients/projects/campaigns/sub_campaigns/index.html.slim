.row
  .col-md-12
    .page-title
      h2.mrl = project.decorate.display_name
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        ul.panel-controls
          li
            = link_to new_administration_client_project_campaign_sub_campaign_path(client, project, campaign), remote: true,  data: { toggle: 'tooltip', title: t('.tooltips.create') }
              span.fa.fa-plus
      .panel-body
        .row
          .col-sm-10
            #filter_results
              = render partial: 'list'
          .col-sm-2
              = render partial: 'filter'
