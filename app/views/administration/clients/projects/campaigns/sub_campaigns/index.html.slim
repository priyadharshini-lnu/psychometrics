.row
  .col-md-12
    .page-title
      h2.mrl = campaign.decorate.display_name
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        .pull-right
          - if policy(@resource_class).export?
            = link_to({ action: :export, format: :csv }, target: :_blank, class: 'btn btn-default')
              span.fa.fa-upload
              = t('.export')
          = link_to new_administration_client_project_campaign_sub_campaign_path(client, project, campaign), 
                    remote: true,
                    class: 'btn btn-default'
            span.fa.fa-plus
            = t('.new')
        = search_form_for(@filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          = f.input :name_cont,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed' }
          .form-group.form-group-long
            .btn-group data-toggle="buttons"
              - [['Active', false], ['Archived', true]].each do |item|
                label class="btn btn-default #{'active' if f.object.archived_true == item.last}"
                  = f.input_field :archived_true, type: :radio, checked: f.object.archived_true == item.last, value: item.last
                  = item.first                                        
      .panel-body
        #filter_results
          = render partial: 'list'
