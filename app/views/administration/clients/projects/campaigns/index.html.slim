.row
  .col-md-12
    .page-title
      h2.mrl = project.decorate.display_name
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        .pull-right
          = link_to new_administration_client_project_campaign_path(client, project), 
                    remote: true,  
                    data: { toggle: 'tooltip', title: t('.tooltips.create') },
                    class: 'btn btn-default'
            span.fa.fa-plus
            = t('.create')
        = search_form_for(@filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          = f.input :name_cont,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed' }                      
      .panel-body
        #filter_results
          = render partial: 'list'
