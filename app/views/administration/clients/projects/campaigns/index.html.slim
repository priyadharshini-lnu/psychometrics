.row
  .col-md-12
    .page-title
      h2.mrl = project.decorate.display_name
      = render 'project_menu'
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        .pull-right
          - if policy(resource_class).export?
            = link_to({ action: :export, format: :csv }, target: :_blank, class: 'btn btn-default')
              span.fa.fa-upload
              = t('.export')
          = link_to new_administration_client_project_campaign_path(client, project),
                  remote: true,
                  class: 'btn btn-default'
            span.fa.fa-plus
            = t('.new')
        = search_form_for(@filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          = f.input :name_cont,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed' }
      .panel-body
        #filter_results
          = render partial: 'list'
