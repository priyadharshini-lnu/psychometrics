$('#filter').trigger('reloadList');

function gotoCampaign () {
  window.location.href = "<%= administration_client_project_threesixty_campaign_path(@campaign.client, @campaign.project, @campaign.threesixty_campaign) %>"
}

<% if @campaign.errors.any? %>
  noty({
    layout: 'center',
    theme: 'relax',
    text: "<%= @campaign.errors.messages[:base].first %>",
    type: 'warning',
    buttons: [
      {
        addClass: 'btn btn-danger center-block', text: 'Ok', onClick: function($noty) {
          $noty.close();
          gotoCampaign();
        }
      }
    ],
  });
<% else %>
  noty({text: '<%= t("administration.#{i18n || resource_class.model_name.plural}.destroy.successfully", name: resource.decorate.display_name) %>', type: 'success'});
<% end %>
