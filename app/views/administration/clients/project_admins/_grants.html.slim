- assessments_view_id = dom_id(u, :assessments_view)
- assessments_manage_id = dom_id(u, :assessments_manage)

- communications_view_id = dom_id(u, :communications_view)
- communications_manage_id = dom_id(u, :communications_manage)

- assessors_view_id = dom_id(u, :assessors_view)
- assessors_manage_id = dom_id(u, :assessors_manage)
- assessors_manage_users_id = dom_id(u, :assessors_manage_users)

- projects_view_id = dom_id(u, :projects_view)
- projects_manage_users_id = dom_id(u, :projects_manage_users)

- results_view_report_id = dom_id(u, :results_view_report)
- results_report_data_id = dom_id(u, :results_report_data)
- results_raw_responses_id = dom_id(u, :results_raw_responses)
- results_scores_id = dom_id(u, :results_scores)

- registration_codes_view_id = dom_id(u, :registration_codes_view)
- registration_codes_manage_id = dom_id(u, :registration_codes_manage)

- dimensions_manage_id = dom_id(u, :dimensions_manage)

- datasheet_view_id = dom_id(u, :datasheet_view)
- datasheet_manage_id = dom_id(u, :datasheet_manage)

= hidden_field_tag 'resource[grants_attributes][data]{}'
table.table.grants-table
  thead
    tr
      th Entity
      th.actions Privileges
  tbody
    - if policy(:membership).manage_grants_for_actions?('projects', ['view', 'manage_users'], project: project)
      tr
        td Projects
        td.text-nowrap
          - if policy(:membership).manage_grants_for_action?('projects', 'view', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][projects][]',
                      'view', resource.has_grant?(:projects, :view), id: projects_view_id
              | View
          - if policy(:membership).manage_grants_for_action?('projects', 'manage_users', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][projects][]',
                      'manage', resource.has_grant?(:projects, :manage), id: projects_manage_users_id
              | Manage Users
    
    - if policy(:membership).manage_grants_for_actions?('results', ['view_report', 'report_data', 'raw_responses', 'scores'], project: project)
      tr
        td Results
        td.text-nowrap
          - if policy(:membership).manage_grants_for_action?('results', 'view_report', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][results][]',
                      'view_report', resource.has_grant?(:results, :view_report), id: results_view_report_id
              | View Report
          - if policy(:membership).manage_grants_for_action?('results', 'report_data', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][results][]',
                      'report_data', resource.has_grant?(:results, :report_data), id: results_report_data_id
              | Report Data
          - if policy(:membership).manage_grants_for_action?('results', 'raw_responses', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][results][]',
                      'raw_responses', resource.has_grant?(:results, :raw_responses), id: results_raw_responses_id
              | Raw Responses
          - if policy(:membership).manage_grants_for_action?('results', 'scores', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][results][]',
                      'scores', resource.has_grant?(:results, :scores), id: results_scores_id
              | Scores

    - if policy(:membership).manage_grants_for_actions?('dimensions', ['manage'], project: project)
      tr
        td Dimensions
        td.text-nowrap
          - if policy(:membership).manage_grants_for_action?('dimensions', 'manage', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][dimensions][]',
                      'manage', resource.has_grant?(:dimensions, :manage), id: dimensions_manage_id
              | Manage

    - if policy(:membership).manage_grants_for_actions?('registration_codes', ['view', 'manage'], project: project)
      tr
        td Registration Codes
        td.text-nowrap
          - if policy(:membership).manage_grants_for_action?('registration_codes', 'view', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][registration_codes][]',
                      'view', resource.has_grant?(:registration_codes, :view), id: registration_codes_view_id, data: { turn_off: [registration_codes_manage_id] }
              | View
          - if policy(:membership).manage_grants_for_action?('registration_codes', 'manage', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][registration_codes][]',
                      'manage', resource.has_grant?(:registration_codes, :manage), id: registration_codes_manage_id, data: { turn_on: [registration_codes_view_id] }
              | Manage
    
    - if policy(:membership).manage_grants_for_actions?('communications', ['view', 'manage'], project: project)
      tr
        td Communication Centre
        td.text-nowrap
          - if policy(:membership).manage_grants_for_action?('communications', 'view', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][communications][]',
                      'view', resource.has_grant?(:communications, :view), id: communications_view_id, data: { turn_off: [communications_manage_id] }
              | View
          - if policy(:membership).manage_grants_for_action?('communications', 'manage', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][communications][]',
                      'manage', resource.has_grant?(:communications, :manage), id: communications_manage_id, data: { turn_on: [communications_view_id] }
              | Manage
    
    - if policy(:membership).manage_grants_for_actions?('campaigns', ['view', 'manage', 'manage_users', 'manage_options', 'show', 'manage_messages'], project: project)
      tr
        td Campaigns & Sub-Campaigns
        td.text-nowrap
          - if policy(:membership).manage_grants_for_action?('campaigns', 'view', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][campaigns][]',
                      'view', resource.has_grant?(:campaigns, :view), id: dom_id(u, :campaigns_view)
              | View

          - if policy(:membership).manage_grants_for_action?('campaigns', 'manage', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][campaigns][]',
                      'manage', resource.has_grant?(:campaigns, :manage), id: dom_id(u, :campaigns_manage)
              | Manage

          - if policy(:membership).manage_grants_for_action?('campaigns', 'manage_users', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][campaigns][]',
                      'manage_users', resource.has_grant?(:campaigns, :manage_users), id: dom_id(u, :campaigns_manage_users)
              | Manage Users

          - if policy(:membership).manage_grants_for_action?('campaigns', 'manage_options', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][campaigns][]',
                      'manage_options', resource.has_grant?(:campaigns, :manage_options), id: dom_id(u, :campaigns_manage_options)
              | Manage Options

          - if policy(:membership).manage_grants_for_action?('campaigns', 'show', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][campaigns][]',
                      'show', resource.has_grant?(:campaigns, :show), id: dom_id(u, :campaigns_show)
              | Show
          
          - if policy(:membership).manage_grants_for_action?('campaigns', 'manage_messages', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][campaigns][]',
                      'manage_messages', resource.has_grant?(:campaigns, :manage_messages), id: dom_id(u, :campaigns_manage_messages)
              | Manage Messages
    
    - if policy(:membership).manage_grants_for_actions?('assessors', ['view', 'manage', 'manage_users'], project: project)
      tr
        td Assessors
        td.text-nowrap
          - if policy(:membership).manage_grants_for_action?('assessors', 'view', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][assessors][]',
                      'view', resource.has_grant?(:assessors, :view), id: assessors_view_id, data: { turn_off: [assessors_manage_id] }
              | View
          - if policy(:membership).manage_grants_for_action?('assessors', 'manage', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][assessors][]',
                      'manage', resource.has_grant?(:assessors, :manage), id: assessors_manage_id,  data: { turn_on: [assessors_view_id] }
              | Manage
          - if policy(:membership).manage_grants_for_action?('assessors', 'manage_users', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][assessors][]',
                      'manage_users', resource.has_grant?(:assessors, :manage_users), id: assessors_manage_users_id
              | Manage Users

    - if policy(:membership).manage_grants_for_action?('reports', 'manage', project: project)
      tr
        td Reports
        td.text-nowrap
          label
            = check_box_tag 'resource[grants_attributes][data][reports][]',
                    'manage', resource.has_grant?(:reports, :manage), id: dom_id(u, :reports_manage)
            | Manage
    
    - if policy(:membership).manage_grants_for_actions?('datasheet', ['view', 'manage'], project: project)
      tr
        td Datasheets
        td.text-nowrap
          - if policy(:membership).manage_grants_for_action?('datasheet', 'view', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][datasheet][]',
                      'view', resource.has_grant?(:datasheet, :view), id: datasheet_view_id, data: { turn_off: [datasheet_manage_id] }
              | View
          - if policy(:membership).manage_grants_for_action?('datasheet', 'manage', project: project)
            label
              = check_box_tag 'resource[grants_attributes][data][datasheet][]',
                      'manage', resource.has_grant?(:datasheet, :manage), id: datasheet_manage_id, data: { turn_on: [datasheet_view_id] }
              | Manage
