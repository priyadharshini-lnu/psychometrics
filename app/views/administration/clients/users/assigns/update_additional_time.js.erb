$(function () {
  $('#modal-container').find('.modal').modal('hide');
  $('#modal-container').find('.modal').on('hidden.bs.modal', function () {
    $('#filter').trigger('reloadList');

    // Reinit all plugins
    $(document).trigger('initPlugins');

    // Notify message
    noty({text: '<%= t("administration.#{i18n || resource_class.model_name.plural}.update_additional_time.successfully") %>', type: 'success'});
  });
});
