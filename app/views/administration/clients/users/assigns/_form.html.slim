= simple_form_for(resource, as: :resource, url: { action: :create }, remote: true, html: { method: :post, id: :assigns_form }) do |f|
  .modal-body
    = render_error_notification resource
    .form-inputs.clearfix
      = f.association :assessment,
                      collection: assessments_options_for_select(client.assessments),
                      input_html: { data: { live_search: true,
                                            dynamic_selectable_url: url_for(action: :reports, assessment_id: '__id__'),
                                            dynamic_selectable_target: '#resource_report_ids',
                                            include_blank: false } },
                      include_blank: true,
                      label: t('.assessment')
      = f.association :reports, collection: []
      .form-group.has-error
        = f.error :client_id

      = f.label 'Reports Access', class: 'resource_user_access'
      = f.input :user_access, as: :boolean, label: 'User'

  .modal-footer
    .btn-group
      = f.button :submit, t('administration.create'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
