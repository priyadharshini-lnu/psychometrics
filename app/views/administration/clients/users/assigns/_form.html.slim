= simple_form_for(@resource, as: :resource, url: { action: @resource.new_record? ? :create : :update }, remote: true) do |f|
  .modal-body
    = f.error_notification
    .form-inputs.clearfix
      = f.input :assessment_id, 
                collection: @client.assessments,
                input_html: {  data: { live_search: true } },
                include_blank: false
      .form-group.has-error
        = f.error :client_id
  .modal-footer
    .btn-group
      = f.button :submit, @resource.new_record? ? t('administration.create') : t('administration.update'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
