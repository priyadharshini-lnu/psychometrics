= simple_form_for(resource, as: :resource, url: { action: :create }, remote: true, method: :post) do |f|
  .modal-body
    = render_error_notification resource
    .form-inputs.clearfix
      = f.association :assessment,
                      collection: client.assessments,
                      input_html: { data: { live_search: true,
                                            dynamic_selectable_url: url_for(action: :reports, assessment_id: '__id__'),
                                            dynamic_selectable_target: '#resource_report_ids',
                                            include_blank: false } },
                      include_blank: true,
                      label: t('.assessment')
      - reports_arr = client.reports.where(assessment_id: f.object.assessment_id).distinct if f.object.assessment.present?
      = f.association :reports, collection: reports_arr || []
      .form-group.has-error
        = f.error :client_id
  .modal-footer
    .btn-group
      = f.button :submit, t('administration.create'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
