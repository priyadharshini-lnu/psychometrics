.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title', name: membership.decorate.display_name)
        .pull-right
          .btn-group
            - if policy(:assign).create?
              = link_to(new_administration_client_user_assign_assessment_path(client.id, membership.id), remote: true, class: 'btn btn-default')
                span.fa.fa-plus
                = t('.add_assessments')
            - if policy(:clients_report).create?
              = link_to(new_administration_client_user_assigns_report_path(client.id, membership.id), remote: true, class: 'btn btn-default')
                span.fa.fa-plus
                = t('.add_reports')
        = search_form_for(filter_form,
                url: { action: :index },
                html: { id: 'filter', class: 'list-filter' },
                builder: SimpleForm::FormBuilder) do |f|
          = f.input :assessment_category_in,
                  collection: ::Assessment::CATEGORIES.map { |role, value| [t("activerecord.attributes.user.roles.#{role}"), value] },
                  input_html: { title: t('activerecord.attributes.assessment.category') },
                  required: false,
                  label: false,
                  include_blank: t('administration.any')
      .panel-body
        #filter_results
          = render partial: 'list'
