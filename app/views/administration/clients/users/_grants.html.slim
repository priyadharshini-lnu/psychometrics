          i.fa.fa-eye title='View'
        label
          = check_box_tag 'resource[user_attributes][grants][communications][manage]',
                  true, u.object.has_grant?(:communications, :manage)
          i.fa.fa-pencil title='Manage'
    tr
      td Reports
      td.text-nowrap
        label
          = check_box_tag 'resource[user_attributes][grants][reports][view]',
                  true, u.object.has_grant?(:reports, :view)
          i.fa.fa-eye title='View'
        label
