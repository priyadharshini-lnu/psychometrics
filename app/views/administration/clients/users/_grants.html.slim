= hidden_field_tag 'resource[user_attributes][grants]{}'
table.table.grants-table
  thead
    tr
      th Entity
      th.actions Privileges
  tbody
    tr
      td Norms
      td.text-nowrap
        label
          = check_box_tag 'resource[user_attributes][grants][norms][]',
                  'view', u.object.has_grant?(:norms, :view)
          i.fa.fa-eye title='View'
        label
          = check_box_tag 'resource[user_attributes][grants][norms][]',
                  'manage', u.object.has_grant?(:norms, :manage)
          i.fa.fa-pencil title='Manage'
    tr
      td Dimensions
      td.text-nowrap
        label
          = check_box_tag 'resource[user_attributes][grants][dimensions][]',
                  'view', u.object.has_grant?(:dimensions, :view)
          i.fa.fa-eye title='View'
        label
          = check_box_tag 'resource[user_attributes][grants][dimensions][]',
                  'manage', u.object.has_grant?(:dimensions, :manage)
          i.fa.fa-pencil title='Manage'
    tr
