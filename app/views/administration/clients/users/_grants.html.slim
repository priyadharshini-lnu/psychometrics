                  'manage', u.object.has_grant?(:assessments, :manage)
          i.fa.fa-pencil title='Manage'
        label
          = check_box_tag 'resource[user_attributes][grants][assessments][]',
                  'assign', u.object.has_grant?(:assessments, :assign)
          i.fa.fa-user-plus title='Assign'
    tr
      td Raw Assessment Results
      td.text-nowrap
        label
          = check_box_tag 'resource[user_attributes][grants][assessments][]',
                  'export', u.object.has_grant?(:assessments, :export)
          i.fa.fa-upload
        label
          = check_box_tag 'resource[user_attributes][grants][assessments][]',
                  'import', u.object.has_grant?(:assessments, :import)
          i.fa.fa-download
    tr
