                  true, u.object.has_grant?(:clients, :manage)
          i.fa.fa-pencil title='Manage'
        label
          = check_box_tag 'resource[user_attributes][grants][clients][design]',
                  true, u.object.has_grant?(:clients, :design)
          i.fa.fa-paint-brush title='Design'
    tr
