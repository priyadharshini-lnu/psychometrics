= hidden_field_tag 'resource[user_attributes][grants]{}'
table.table.grants-table
  thead
    tr
      th Entity
      th.actions Privileges
  tbody
    tr
      td Norms
      td.text-nowrap
        label
          = check_box_tag 'resource[user_attributes][grants][norms][view]',
                  true, u.object.has_grant?(:norms, :view)
          i.fa.fa-eye title='View'
        label
          = check_box_tag 'resource[user_attributes][grants][norms][manage]',
                  true, u.object.has_grant?(:norms, :manage)
          i.fa.fa-pencil title='Manage'
    tr
      td Dimensions
      td.text-nowrap
        label
          = check_box_tag 'resource[user_attributes][grants][dimensions][view]',
                  true, u.object.has_grant?(:dimensions, :view)
          i.fa.fa-eye title='View'
        label
          = check_box_tag 'resource[user_attributes][grants][dimensions][manage]',
                  true, u.object.has_grant?(:dimensions, :manage)
          i.fa.fa-pencil title='Manage'
    tr
      td Assessments
      td.text-nowrap
        label
          = check_box_tag 'resource[user_attributes][grants][assessments][view]',
                  true, u.object.has_grant?(:assessments, :view)
          i.fa.fa-eye title='View'
        label
          = check_box_tag 'resource[user_attributes][grants][assessments][manage]',
                  true, u.object.has_grant?(:assessments, :manage)
          i.fa.fa-pencil title='Manage'
        label
          = check_box_tag 'resource[user_attributes][grants][assessments][assign]',
                  true, u.object.has_grant?(:assessments, :assign)
          i.fa.fa-user-plus title='Assign'
    tr
      td Raw Assessment Results
      td.text-nowrap
        label
          = check_box_tag 'resource[user_attributes][grants][assessments][export]',
                  true, u.object.has_grant?(:assessments, :export)
          i.fa.fa-upload
        label
          = check_box_tag 'resource[user_attributes][grants][assessments][import]',
                  true, u.object.has_grant?(:assessments, :import)
          i.fa.fa-download
    tr
      td Translations
