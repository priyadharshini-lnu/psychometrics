= simple_form_for(@resource, as: :resource, url: { action: :create }, remote: true) do |f|
  .modal-body
    = f.error_notification
    .form-inputs.clearfix
      = f.input :email
      = f.input :first_name
      = f.input :last_name
      = f.input :membership_role, as: :select, label: t('simple_form.labels.membership.role'),
                    collection: Membership::MEMBERSHIP_ROLES,
                    class: 'form-control select mll',
                    include_blank: false
      = f.input :parent_id, 
                collection: client.memberships.includes(:user),
                label_method: lambda { |u| u.user.decorate.display_name },
                input_html: {  data: { live_search: true } }
      - if client.tenancy?
        = f.input :sub_client_id,
                  label: 'Sub Tenancy',
                  as: :fake_select,
                  collection: client.sub_clients.map{ |c| [c.decorate.display_name, c.id] },
                  input_html: { include_blank: true, data: { live_search: true } }
  .modal-footer
    .btn-group
      = f.button :submit, t('administration.create'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
