= simple_form_for(@resource, as: :resource, url: { action: @resource.new_record? ? :create : :update }, remote: true) do |f|
  .modal-body
    = f.error_notification
    .form-inputs.clearfix
      = f.input :email
      = f.input :first_name
      = f.input :last_name
      = f.input :role, as: :select, 
                collection: @current_user.decorate.can_manage_roles, 
                class: 'form-control select mll', 
                include_blank: false
      = f.simple_fields_for :memberships do |p|
        = p.input :parent_id, 
                  collection: @client.users, 
                  label_method: lambda { |u| u.decorate.display_name }, 
                  input_html: {  data: { live_search: true } }
  .modal-footer
    .btn-group
      = f.button :submit, @resource.new_record? ? t('administration.create') : t('administration.update'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
