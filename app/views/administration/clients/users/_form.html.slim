= simple_form_for(resource, as: :resource, url: { action: :create }, remote: true) do |f|
  .modal-body
    = render_error_notification(resource)
    .form-inputs.clearfix
      = f.simple_fields_for :user, f.object.user || User.new  do |u|
        = u.input :email
        = u.input :first_name
        = u.input :last_name
      = f.input :role, as: :select, label: t('simple_form.labels.membership.role'),
              collection: [Membership::MANAGER_ROLE, Membership::MEMBER_ROLE],
              class: 'form-control select mll',
              include_blank: false
      = f.input :parent_id,
              collection: client.memberships.join_user,
              label_method: lambda { |u| u.decorate.display_name },
              input_html: { data: { live_search: true } }
  .modal-footer
    .btn-group
      = f.button :submit, t('administration.create'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
