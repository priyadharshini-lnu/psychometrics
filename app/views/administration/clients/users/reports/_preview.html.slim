= stylesheet_link_tag :psychometrics_reports_vendor
= stylesheet_link_tag :psychometrics_reports_preview

#report_preview.html_preview[data-user="#{Reports::UserSerializer.new(membership, assign: project_assign, assigns: @assigns).to_json}"
  data-results="#{Facades::Reports::SerializedResults.new(@results, membership).results}"
  data-data="#{ReportSerializer.new(resource, membership: membership, assigns: @assigns).to_json(include: '**')}"
  data-locales=@translations.to_json]
- if params[:export]
  = javascript_include_tag :psychometrics_pdf_vendor
  = javascript_include_tag :psychometrics_pdf_app
- elsif Settings.react_dev.reports
  / for debug
  = javascript_include_tag 'http://localhost:3000/psychometrics_reports_vendor.js'
  = javascript_include_tag 'http://localhost:3000/psychometrics_reports_preview.js'
- else
  = javascript_include_tag :psychometrics_reports_vendor
  = javascript_include_tag :psychometrics_reports_preview

