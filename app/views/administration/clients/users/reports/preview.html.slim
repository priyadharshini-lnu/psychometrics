.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        .pull-right
          .btn-group
            - if policy(@resource).preview?
              = link_to(preview_administration_report_path(@resource, format: :pdf), class: 'btn btn-default')
                span.fa.fa-file-pdf-o
                = t('.export_pdf')
      .panel-body
        = render partial: 'preview'
