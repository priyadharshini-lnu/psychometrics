$(function () {
  var $modalBox = $('#modal-container').find('.modal');

  $modalBox.modal('hide');
  $modalBox.on('hidden.bs.modal', function () {
    $('#filter').trigger('reloadList');

    // Reinit all plugins
    $(document).trigger('initPlugins');

    // Notify message
    var message = '<%= t("administration.memberships.create.successfully", name: resource.full_name) %>'

    noty({
      text: message,
      type: 'success'
    });
  });
});
