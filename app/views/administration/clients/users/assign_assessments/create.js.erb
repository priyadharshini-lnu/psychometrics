$(function () {
  $('#modal-container').find('.modal').modal('hide');
  $('#modal-container').find('.modal').on('hidden.bs.modal', function () {
    $('#filter').trigger('reloadList');

    // Reinit all plugins
    $(document).trigger('initPlugins');

    // Notify message
    noty({text: 'Successfully updated', type: 'success'});
  });
});
