$(function () {
  var $modalBox = $('#modal-container').find('.modal')
  $modalBox.modal('hide');
  $modalBox.on('hidden.bs.modal', function () {

    $('a[data-assign-id=<%= resource.assign.id %>][data-report-id=<%= resource.report.id %>]').hide('slow')
    $('#client-tenancy-assign-<%= resource.assign.id %>-report-<%= resource.report.id %>').hide('slow')
    // Notify message
    noty({
      text: '<%= t('administration.clients.users.assigns.common.detach_report',
          name: resource.assign.decorate.display_name) %>', type: 'success'
    });
  });
});
