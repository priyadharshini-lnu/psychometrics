.table-responsive
  table.table.table-bordered.table-actions.table-hover.selectable.list id="#{@resource_class.model_name.plural}_list"
    thead
      tr
        th.text-center width="100" = link_to_sort @resource_class, :active, @filter_form
        th = link_to_sort @resource_class, :first_name, @filter_form
        th = link_to_sort @resource_class, :last_name, @filter_form
        th = link_to_sort @resource_class, :email, @filter_form
        th = link_to_sort @resource_class, :role, @filter_form
        - if client.tenancy?
          th = t('administration.tenancies')
        th = link_to_sort @resource_class, :created_at, @filter_form
        th width='300' = t('administration.actions')
    tbody
      - if @resources.present?
        = render partial: 'resource', collection: @resources
      - else
        tr.no_records
          td align='center' colspan='9' = t('administration.no_data_found')
  = paginate @resources, theme: 'twitter-bootstrap-3'
