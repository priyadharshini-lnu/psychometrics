.row
  .col-md-12
    .page-title
      h2.mrl = @client.decorate.display_name
      = active_link_to(t('administration.navigation.users'), administration_client_users_path(@client), class: 'btn btn-default')
      - if policy(:report).index?
        = active_link_to(t('administration.navigation.reporting'), administration_client_reports_path, class: 'btn btn-default')
      - if policy(@client).design?
        = active_link_to(t('administration.navigation.design'), edit_administration_client_designs_path, remote: true, class: 'btn btn-default')

    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        .pull-right
          .btn-group
            - if policy(@resource_class).import?
              .btn-group
                button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                  span.fa.fa-upload
                  => t('.import')
                  span.caret
                ul.dropdown-menu
                  li = link_to(t('.import_users'), new_administration_imports_users_path, remote: true, class: 'btn btn-default')
                  li = link_to(t('.import_hris'), new_administration_imports_hris_path, remote: true, class: 'btn btn-default')
            - if policy(@resource_class).export?
              = link_to({ action: :export, format: :csv }, target: :_blank, class: 'btn btn-default')
                span.fa.fa-download
                = t('.export')
            - if policy(@resource_class).create?
              = link_to({ action: :new }, remote: true, class: 'btn btn-default')
                span.fa.fa-plus
                = t('.add')
      .panel-body
        .row
          .col-sm-10
            #filter_results
              = render partial: 'list'
          .col-sm-2
            h3 
              i.fa.fa-filter
              | Filter
            = search_form_for(@filter_form, 
                              url: { action: :index }, 
                              html: { id: 'filter' },
                              builder: SimpleForm::FormBuilder) do |f|

              = f.input :role_in, 
                        collection: ::User::USER_ROLES.map { |role, value| [t("activerecord.attributes.user.roles.#{role}"), value] }, 
                        input_html: { multiple: true },
                        required: false,
                        label: 'Roles'
              = f.input :first_name_or_last_name_or_email_cont, 
                        label: 'Search', 
                        as: :string, 
                        required: false, 
                        placeholder: t('administration.search'), 
                        input_html: { class: 'has_clear periodically-observed' }
              = link_to "Clear Filter", request.path, class: "btn btn-default"
