.row
  .col-md-12
    .page-title
      h2.mrl = @client.decorate.display_name
      = active_link_to(t('administration.navigation.users'), administration_client_users_path(@client), class: 'btn btn-default')
      = active_link_to(t('administration.navigation.reporting'), administration_users_path, class: 'btn btn-default')
      = active_link_to(t('administration.navigation.design'), administration_users_path, class: 'btn btn-default')

    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        ul.panel-controls
          li
            = link_to({ action: :new }, remote: true)
              span.fa.fa-plus
      .panel-body
        = form_for_filterrific @filterrific, as: :filterrific, html: { class: 'form-inline', id: 'filter' } do |f|
          = f.hidden_field :sorted_by
          .row.mbm
            .col-sm-6.phn
              .btn-group data-toggle="buttons"
                - @filterrific.select_options[:with_role].each do |value|
                  label class="btn btn-default #{'active' if f.object.with_role == value}"
                    = f.radio_button(:with_role, value)
                    = t(".filterrific.with_role.#{value}")
            .col-md-3.col-md-offset-3.col-sm-4.col-sm-offset-2.phn
              .input-group.pull-right
                = f.text_field(:search_query, placeholder: t('administration.search'), class: 'periodically-observed form-control')
                span.input-group-addon
                  .fa.fa-search
          .clearfix
        #filterrific_results
          = render partial: 'list'
