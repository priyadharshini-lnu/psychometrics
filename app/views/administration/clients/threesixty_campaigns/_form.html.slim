= simple_form_for(resource, as: :resource, url: { action: resource.new_record? ? :create : :update }, remote: true, html: { id: 'threesixty_campaign' }) do |f|
  .modal-body
    = f.error_notification
    .form-inputs.clearfix
      = f.input :name
      = f.input :type, as: :select, collection: Campaign::TYPES.map{|k,v| [v, k]}, include_blank: false
      = f.fields_for :threesixty_campaign do |ff|
        #assessment_field.form-group
          = ff.input :assessment_id, as: :select, collection: Assessment.where(category: Assessment.categories['360']).map { |a| [a.decorate.name, a.id] }
        #factors_field.form-group
          = ff.input :factors, as: :select, collection: [], input_html: { multiple: true }


  .modal-footer
    .btn-group
      = f.button :submit, resource.new_record? ? t('administration.create') : t('administration.update'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'

javascript:
  $(function () {
    function changeType(){
      var type = $(this).find('option:selected').attr('value')
      if (type === 'empty') {
        $('#assessment_field').css('display', 'none')
        $('#factors_field').css('display', 'none')
      } else {
        fetchAssessments(type)
        $('#assessment_field').css('display', 'block')
        $('#factors_field').css('display', 'block')
      }
    }

    $('#threesixty_campaign #resource_type').change(changeType)
    changeType.call($('#threesixty_campaign #resource_type'))

    function assessmentHandler () {
      $('#threesixty_campaign #resource_threesixty_campaign_assessment_id').change(function(){
        var assessment = $(this).find('option:selected').attr('value')
        fetchFactors(assessment)
      })
    }

    function fetchAssessments (type) {
      var url = $('#threesixty_campaign').attr('action') + '/assessments?type=' + type

      $.ajax({
        url: url,
        type: 'GET',
        dataType: 'script',
        success: function () {
          assessmentHandler()
        }
      });
    }

    function fetchFactors (assessment) {
      var url = $('#threesixty_campaign').attr('action') + '/factors?assessment_id=' + assessment

      $.ajax({
        url: url,
        type: 'GET',
        dataType: 'script',
      });
    }

    assessmentHandler()
  })
