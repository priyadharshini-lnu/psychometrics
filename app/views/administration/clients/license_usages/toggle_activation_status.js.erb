$('#filter').trigger('reloadList');
// Reinit all plugins
$(document).trigger('initPlugins');

$(document).trigger('close_sidebar');
$('#<%= dom_id(resource) %>').hide('fast')

// Notify message
noty({ text: '<%= t("administration.#{i18n || resource_class.model_name.plural}.toggle_status.successfully",
  status: "#{ @_resource.active? ? 'activated' : 'deactivated' }" )%>', type: 'success' });
