#license_usages_index
  .row
    .col-md-12
      .panel.panel-default
        .panel-heading
          h3.panel-title = t('.title', client_name: client.decorate.display_name)
          = search_form_for(filter_form,
                            url: { action: :index },
                            html: { id: 'filter', class: 'list-filter' },
                            builder: SimpleForm::FormBuilder) do |f|
            = f.input :subject_cont,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed', value: @filter_term }
            = link_to 'Clear Filter', request.path, class: 'btn btn-default'
            .form-group.form-group-long
              .btn-group data-toggle="buttons"
                - [['Active', 0], ['Deactivated', 1]].each do |item|
                  label class="btn btn-default #{'active' if f.object.status_eq == item.last}"
                    = f.input_field :status_eq, type: :radio, checked: f.object.status_eq == item.last, value: item.last
                    = item.first
        .panel-body
          #filterrific_results
            = render partial: 'list'
