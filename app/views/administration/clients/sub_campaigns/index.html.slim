.row
  .col-md-12
    .page-title
      h2.mrl = client.decorate.display_name
      = render 'clients_menu'
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        = search_form_for(@filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          = f.input :name_cont,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed' }
          .form-group.form-group-long
            .btn-group data-toggle="buttons"
              - [['Active', false], ['Archived', true]].each do |item|
                label class="btn btn-default #{'active' if f.object.disabled_true == item.last}"
                  = f.input_field :disabled_true, type: :radio, checked: f.object.disabled_true == item.last, value: item.last
                  = item.first                                
      .panel-body
        #filter_results
          = render partial: 'list'
