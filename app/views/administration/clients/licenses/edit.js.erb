<% if @resource.errors.empty? %>
  $('#modal-container').html('<%= j render(partial: 'modal', locals: { dialog_class_name: 'modal-lg', header: t("administration.clients.licenses.edit.header", client_name: @resource.decorate.display_name) }) %>');
  $('#modal-container').find(".modal").modal('show');
  $('#modal-container').find(".modal").on('hidden.bs.modal', function (e) {
    $(this).remove();
  });
<% else %>
  $('#modal-container').find("form").html('<%= j render(partial: 'form') %>');
<% end %>

// Reinit all plugins
$(document).trigger('initPlugins');
