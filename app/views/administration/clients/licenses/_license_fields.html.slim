
tr.nested-fields
  td
    = f.association :report_family,
            input_html: { data: { live_search: true } },
            include_blank: false,
            label: false
  td
    = f.input :number, label: false
  td 
    = f.input :overuse_number, label: false
  td
    = f.input :start_date, label: false
  td
    = f.input :end_date, label: false, end_year: Date.today.year + 30
  td 
    = link_to_remove_association f
      i.fa.fa-times 
