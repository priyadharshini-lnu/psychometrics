tr id=dom_id(resource)
  td.text-center
    = link_to toggle_status_administration_client_license_path(client, resource),
              method: :patch,
              remote: true,
              class: 'toggle-status',
              data: { confirm: resource.decorate.toggle_status_confirmation }
      = resource.decorate.status
  td = resource.decorate.display_name
  td = resource.decorate.used_number(client)
  - if current_user.is?(:superadmin) && client.root?
    td = resource.decorate.used_overuse_number
  td = resource.decorate.usage_percent(client)
  td = resource.decorate.start_date
  - if current_user.is?(:superadmin)
    td = resource.decorate.end_date
  td.actions-cell
    - if policy(:license).edit?
      = link_to edit_administration_client_license_path(client, resource),
                remote: true,
                class: 'btn btn-default btn-rounded btn-sm',
                data: { toggle: 'tooltip', title: t('.tooltips.edit') }
        span.fa.fa-pencil
