$(function () {
  var $modalContainer = $('#modal-container'),
      $modalBox = $modalContainer.find('.modal');

  $modalBox.modal('hide');
  $modalBox.on('hidden.bs.modal', function () {
    $(document).trigger('close_sidebar');
    noty({
      text: '<%= t(".successfully") %>',
      type: 'success'
    });
  });
});
