= f.input :number
= f.input :country, as: :select, 
                    collection: Data::Geo.select(:country_name).distinct, 
                    label_method: :country_name, 
                    value_method: :country_name,
                    input_html: { data: { live_search: true } },
                    include_blank: false
= f.input :year, as: :select, collection: 2.years.ago.year..10.years.since.year
