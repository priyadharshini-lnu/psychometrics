= simple_form_for(resource, as: :resource, url: { action: :update }, remote: true) do |f|
  .modal-body
    = f.error_notification
    .form-inputs.clearfix
      = f.input :assign_to_assessment_ids, as: :select, collection: policy_scope(Assessment).all, class: 'form-control select mll', include_blank: false, input_html: {  data: { live_search: true }, multiple: true }
  .modal-footer
    .btn-group
      = f.button :submit, resource.new_record? ? t('administration.create') : t('administration.update'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
