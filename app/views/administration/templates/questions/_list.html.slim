.table-responsive
  table.table.table-bordered.table-actions.table-hover.selectable.list id="#{@resource_class.model_name.plural}_list"
    thead
      tr
        th.text-center width="100" = sorting @resource_class, :active, @filterrific
        th = sorting @resource_class, :name, @filterrific
        th = t('.linked_assessments')
        th = sorting @resource_class, :created_at, @filterrific
        th = t('administration.questions.index.owner')
        th width='300' = t('administration.actions')
    tbody
      - if @resources.present?
        = render partial: 'resource', collection: @resources
      - else
        tr.no_records
          td align='center' colspan='9' = t('administration.no_data_found')
  = paginate @resources, theme: 'twitter-bootstrap-3'
