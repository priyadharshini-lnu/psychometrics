<% resource = escape_javascript(
  render(partial: 'resource', locals: { resource: @resource })
) %>

$('#<%= dom_id(@resource) %>').hide('fast', function(){
  $(this).replaceWith('<%= resource %>').show('slow');

  // If sidebar has been opened then we reload him
  if($('#sidebar').hasClass('opened')){
    $(document).trigger('load_sidebar', ['#<%= dom_id(@resource) %>']);
  }

  // Reinit all plugins
  $(document).trigger('initPlugins');

  // Notify message
  noty({text: '<%= t('.successfully') %>', layout: 'topCenter', type: 'success'});
});

