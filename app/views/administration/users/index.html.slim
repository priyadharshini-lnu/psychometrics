.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        .pull-right
          .btn-group
            - if policy(resource_class).create_superadmin?
              = link_to({ action: :new }, remote: true, class: 'btn btn-default')
                span.fa.fa-plus
                = t('.new_superadmin')
        = search_form_for(filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          - if current_user.is?(:superadmin)
            = f.input :role_scope_in,
                      collection: roles_dropdown(current_user),
                      input_html: { multiple: true, title: 'Roles'},
                      label: false
          = f.input :memberships_client_id_in,
                    collection: policy_scope(Client).order(:name),
                    input_html: { data: { live_search: true }, multiple: true, title: t('.client_tenancy') },
                    required: false,
                    label: false
          = f.input :filterable_fields,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed', value: @filter_term }
          = link_to t('shared.filters.clear'), request.path, class: "btn btn-default"
      .panel-body
        #filter_results
          = render partial: 'list'
