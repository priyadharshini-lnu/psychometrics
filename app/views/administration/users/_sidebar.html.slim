ul.x-navigation.x-navigation-panel id="sidebar_#{dom_id(@resource)}"
  li.xn-title.title = t('.title', id: @resource.id)
  - if policy(@resource).edit?
    li = link_to @resource.decorate.toggle_status_text, [:toggle_status, :administration, @resource], remote: true, method: :patch
  - if policy(@resource).edit?
    li = link_to t('.edit_user'), [:edit, :administration, @resource]
  - if policy(@resource).new?
    li.xn-title = t('.new_user')
  - if policy(@resource).new?
    li.xn-title = t('.import_users')
  li.xn-title = t('.export_users')
  li.xn-title = t('.email')
  li.xn-title = t('.view_report')
  li.xn-title = t('.login_as_user')
  - if policy(@resource).reset_password?
    li = link_to t('.reset_password'), [:reset_password, :administration, @resource]
