ul.x-navigation.x-navigation-panel id="sidebar_#{dom_id(@resource)}"
  li.xn-title.title = t('.title', id: @resource.id)
  - if policy(@resource).edit?
    li = link_to @resource.decorate.toggle_status_text, { action: :toggle_status, id: @resource }, remote: true, method: :patch
  - if policy(@resource).edit?
    li = link_to t('.edit_user'), { action: :edit, id: @resource }
  - if policy(@resource_class).new?
    li = link_to t('.new_user'), { action: :new }, remote: true
  - if policy(@resource_class).new?
    li = link_to t('.import_users'), [:new, :administration, :import, { resource: @resource_class.model_name.singular, type: :csv }], remote: true
  - if policy(@resource_class).export?
    li = link_to t('.export_users'), { action: :export, format: :csv }, target: :_blank
  li.xn-title = t('.email')
  li.xn-title = t('.view_report')
  - if policy(@resource).spoof?
    li = link_to t('.login_as_user'), { action: :spoof, id: @resource }, target: :_blank
  - if policy(@resource).reset_password?
    li = link_to t('.reset_password'), { action: :reset_password, id: @resource }, data: { confirm: @resource.decorate.change_password_confirmation }
