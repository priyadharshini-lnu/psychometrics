#reports_index
  .row
    .col-md-12
      .panel.panel-default
        .panel-heading
          h3.panel-title = t('.title')
          .pull-right
            .btn-group
              - if policy(resource_class).create?
                = link_to({ action: :new }, remote: true, class: 'btn btn-default create')
                  span.fa.fa-plus
                  = t('.add')
              - if policy(resource_class).index?
                = link_to(administration_report_families_path,  class: 'btn btn-default')
                  = t('.families')

          = search_form_for(filter_form,
                            url: { action: :index },
                            html: { id: 'filter', class: 'list-filter' },
                            builder: SimpleForm::FormBuilder) do |f|

            = f.input :assessments_category_in,
                      collection: ::Assessment::CATEGORIES,
                      input_html: { title: 'Category '},
                      include_blank: t('administration.any'),
                      label: false
            = f.input :assessments_id_in,
                      collection: policy_scope(Assessment).all.options_for_select,
                      input_html: { data: { live_search: true }, multiple: true, title: 'Assessment' },
                      required: false,
                      label: false
            = f.input :filterable_fields,
                      as: :string,
                      required: false,
                      placeholder: t('administration.search'),
                      label: false,
                      input_html: { class: 'has_clear periodically-observed' }
            = link_to "Clear Filter", request.path, class: "btn btn-default"
            .form-group.form-group-long
              .btn-group data-toggle="buttons"
                - [['Active', false], ['Archived', true]].each do |item|
                  label class="btn btn-default #{'active' if f.object.archived_true == item.last}"
                    = f.input_field :archived_true, type: :radio, checked: f.object.archived_true == item.last, value: item.last
                    = item.first
        .panel-body
          #filterrific_results
            = render partial: 'list'
