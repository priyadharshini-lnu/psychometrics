#reports_form
  = simple_form_for(resource, as: :resource, url: { action: resource.new_record? ? :create : :update }, remote: true) do |f|
    .modal-body
      = render_error_notification(resource)
      = render_error_notification(@external_settings) if @external_settings
      .form-inputs.clearfix
        = f.input :name
        = f.input :description, as: :text
        - root_clients = policy_scope(Client).roots
        - if current_user.is?(:superadmin)
          = f.association :owner,
                          collection: policy_scope(Client).enabled.roots.order(:name),
                          include_blank: t('administration.tte'),
                          input_html: { data: { live_search: true } }
        - elsif current_user.is?(:client_admin) && root_clients.count > 1
          = f.association :owner,
                          collection: policy_scope(Client).enabled.roots.order(:name),
                          input_html: { data: { live_search: true } }
        = f.input :data_only, as: :boolean, input_html: { id: 'report_data_only_checkbox' }
        = f.association :assessments,
                        collection: assessments_options_for_select(policy_scope(Assessment).unarchived.not_deleted, resource),
                        include_hidden: false,
                        wrapper_html: { class: f.object.data_only? ? 'hidden' : '' },
                        input_html: { multiple: true,
                                      data: { live_search: true,
                                              max_options: Report::MAX_ASSESSMENT_COUNT,
                                              max_options_text: I18n.t('activerecord.errors.models.report.max_assessment_count', max: Report::MAX_ASSESSMENT_COUNT),
                                              dynamic_selectable_url: url_for(action: :external_reports, assessment_ids: '__id__', external_report_id: f.object&.external_settings&.dig(:report_id)),
                                              dynamic_selectable_target: 'select.external_reports_setting',
                                              include_blank: t('.none_external') }}

        - if (resource.assigns_reports.any? || resource.clients_reports.any?) && resource.errors[:assessments].blank?
          span.help-block.text-danger.margin-top-minus-10
            = I18n.t('activerecord.errors.models.report.has_already_assigned')

        = f.input :provider, as: :select,
                      collection: [ \
                        [t('.none_external'), 'internal'],
                        [t('.load_from_pearson'), 'pearson', ],
                        ['hogan', 'hogan', {class: 'hidden'}],
                        ['saville', 'saville', {class: 'hidden'}] \
                      ],
                      wrapper_html: { class: 'resource_pearson' },
                      input_html: { id: 'provider_input' },
                      include_blank: false

        = f.simple_fields_for :external_settings do |hogan|
          = hogan.input :report_id,
                        label: 'Hogan report ID',
                        as: :select,
                        collection: [],
                        input_html: { multiple: false, class: 'external_reports_setting' },
                        wrapper_html: { class: 'resource_hogan hidden', id: 'hogan_report_id' },
                        disabled: true,
                        include_hidden: false

        = f.simple_fields_for :external_settings do |saville|
          = saville.input :report_id,
                        label: 'Saville report ID',
                        as: :select,
                        collection: [],
                        input_html: { multiple: false, class: 'external_reports_setting' },
                        wrapper_html: { class: 'resource_saville hidden', id: 'saville_report_id' },
                        disabled: true,
                        include_hidden: false

        = f.input :default_language,
                  collection: I18n.available_locales.map { |locale| [t("languages.#{locale}"), locale] },
                  include_blank: false
        .clearfix
          = f.input :require_approval, as: :boolean

        = render partial: 'administration/administrator/shared/simple_design', locals: { f: f }
    .modal-footer
      .btn-group
        = f.button :submit, resource.new_record? ? t('administration.create') : t('administration.update'), class: 'btn-info'
        a.btn.btn-default data-dismiss='modal' = t 'administration.close'
