ul.x-navigation.x-navigation-panel id="sidebar_#{dom_id(resource)}"
  li.xn-title.title = t('.title')
  - if policy(resource, { project_id: resource.owner_id }).edit?
    li = link_to(resource.decorate.toggle_status_text, { action: :toggle_status, id: resource }, remote: true, method: :patch, data: { confirm: resource.decorate.toggle_status_confirmation })
  - if policy(resource, { project_id: resource.owner_id }).edit?
    li = link_to t('.edit'), { action: :edit, id: resource }, remote: true
  - if policy(resource, { project_id: resource.owner_id }).destroy?
    li = link_to(t('.destroy'), { action: :destroy, id: resource }, remote: true, method: :delete, data: { confirm: resource.decorate.delete_confirmation })
  - if policy(resource, { project_id: resource.owner_id }).toggle_archive?
    li = link_to(resource.decorate.toggle_archive_status_text, [:toggle_archive, :administration, resource],
      remote: true, method: :patch,
      data: { confirm: resource.decorate.toggle_archive_confirmation })
