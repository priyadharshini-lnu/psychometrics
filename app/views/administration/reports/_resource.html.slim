tr data-sidebar=(url_for({ action: :sidebar, id: resource }) if  policy(resource).sidebar?) id=dom_id(resource)
  td = resource.id
  td.text-center
    - if policy(:report, { project_id: resource.owner_id }).toggle_status?
      = link_to({ action: :toggle_status, id: resource }, remote: true, method: :patch, class: 'toggle-status', data: { confirm: resource.decorate.toggle_status_confirmation })
        = resource.decorate.status
    - else
      = resource.decorate.status
  td
    - if policy(resource, { project_id: resource.owner_id }).edit?
      = link_to resource.name, administration_report_path(resource)
    - else
      = resource.name
  td = resource.decorate.assessments_names
  td = resource.decorate.owner_link
  td = resource.decorate.report_families
  td.text-center = resource.decorate.created_at
  td.text-center = resource.decorate.updated_at
  td.actions-cell
    - if policy(:report, { project_id: resource.owner_id }).preview?
      = link_to({ action: :preview, id: resource }, class: 'btn btn-default btn-rounded btn-sm  preview', data: { toggle: 'tooltip', title: t('.tooltips.preview') })
        i.fa.fa-eye
    - if policy(resource).edit?
      = link_to({ action: :edit, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm edit', data: { toggle: 'tooltip', title: t('.tooltips.edit') })
        i.fa.fa-pencil
    - if policy(:report, { project_id: resource.owner_id }).copy?
      = link_to({ action: :copy, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm copy', data: { toggle: 'tooltip', title: t('.tooltips.copy'), disable_with: t('.in_progress.copying') })
        span.fa.fa-copy
    - if policy(:report, { project_id: resource.owner_id }).destroy? && resource.deleted?
      = link_to({ action: :destroy, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm delete',
        method: :delete, data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete'),
        disable_with: t('.in_progress.deleting') })
        span.fa.fa-times
    - if policy(:report, { project_id: resource.owner_id }).soft_delete? && !resource.deleted?
       = link_to({ action: :soft_delete, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm',
        method: :delete, data: { confirm: resource.decorate.soft_delete_confirmation, toggle: 'tooltip', title: t('.tooltips.soft_delete'),
        disable_with: t('.in_progress.deleting') })
        span.fa.fa-trash
    - if policy(:report, { project_id: resource.owner_id }).restore? && resource.deleted?
      = link_to [:restore, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm',
        method: 'put', data: { toggle: 'tooltip', title: t('.tooltips.restore'), disable_with: t('.in_progress.restoring') }
        span.fa.fa-refresh
