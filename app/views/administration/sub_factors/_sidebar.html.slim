ul.x-navigation.x-navigation-panel id="sidebar_#{dom_id(@resource)}"
  li.xn-title = t('.title')
  - if policy(@resource).edit?
    li = link_to t('.edit'), edit_administration_dimension_factor_sub_factor_path(dimension_id: @dimension.id, factor_id: @factor.id, id: @resource.id), remote: true
    - if policy(@resource).new?
    li = link_to t('administration.create'), new_administration_dimension_factor_sub_factor_path(dimension_id: @dimension.id, factor_id: @factor.id), remote: true
