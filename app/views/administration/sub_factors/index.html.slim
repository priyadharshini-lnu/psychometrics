.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = "#{@dimension.name}: #{@factor.name}: #{t('.title')}"
        ul.panel-controls
          li
            = link_to new_administration_dimension_factor_sub_factor_path, remote: true, data: { toggle: 'tooltip', title: t('.tooltips.create') }
              span.fa.fa-plus
        = search_form_for(@filter_form,
                url: {action: :index},
                html: {id: 'filter', class: 'list-filter'},
                builder: SimpleForm::FormBuilder) do |f|
          = f.input :name_cont,
                  label: false,
                  as: :string,
                  required: false,
                  placeholder: t('administration.search'),
                  input_html: {class: 'has_clear periodically-observed'}


      .panel-body
        #filter_results
          = render partial: 'list'
