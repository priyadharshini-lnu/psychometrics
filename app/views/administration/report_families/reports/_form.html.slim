#report_families_form
  = simple_form_for(@form, as: :resource, url: { action: :create }, remote: true) do |f|
    .modal-body
      = f.error_notification
      .form-inputs.clearfix
        = f.input :report_id,
                  as: :select,
                  collection: @reports.map { |report| [report.name, report.id, { 'data-provider' => report.provider}] },
                  class: 'form-control',
                  include_blank: false,
                  input_html: { data: { live_search: true, behavior: 'communication-changeable' } },
                  wrapper_html: { class: 'internal hogan saville pearson iiht' }
        = f.input :external_package_id,
                  as: :select,
                  collection: Settings.providers.hogan.report_packages.map { |a| [a.name, a.id] },
                  class: 'form-control',
                  include_blank: true,
                  input_html: { data: { live_search: true, behavior: 'communication-changeable' } },
                  wrapper_html: { class: 'hogan' }
    .modal-footer
      .btn-group
        = f.button :submit, t('administration.create'), class: 'btn-info'
        a.btn.btn-default data-dismiss='modal' = t 'administration.close'
