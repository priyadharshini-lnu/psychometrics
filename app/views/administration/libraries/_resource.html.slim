- image_icon_url = resource.file_url(:icon)
tr id=dom_id(resource)
  td.text-center
    - if resource.image? && resource.file.attached? && image_icon_url
      = image_tag image_icon_url, alt: resource.name, class: 'thumb'
    - else
      i class="icon #{resource.decorate.icon}" style="font-size: 30px;"
  td
    - if resource.folder?
      = link_to resource.name, { action: :index, folder_id: resource.id }, method: :get
    - else
      = resource.name
  td = resource.description
  td = resource.decorate.owner_link
  td.text-center = resource.decorate.created_at
  td.actions-cell
    - if resource.file?
      button.btn.btn-default.btn-rounded.btn-xs.copy-coded-url data-toggle="tooltip" data-title="#{resource.file.url}"
        i.fa.fa-copy
    - if policy(resource, { project_id: resource.owner_id }).edit?
      = link_to({ action: :edit, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm mrm', data: { toggle: 'tooltip', title: t('.tooltips.edit') })
        i.fa.fa-pencil
    - if policy(resource, { project_id: resource.owner_id }).destroy?
      = link_to({ action: :destroy, id: resource }, remote: true, class: 'btn btn-default btn-rounded btn-sm mrm', method: :delete, data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete') })
        span.fa.fa-times
