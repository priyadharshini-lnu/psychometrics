= render 'administration/libraries/breadcrumbs'
.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = @folder.present? ? @folder.name : t('.title')
        .pull-right
          .btn-group
            - if policy(resource_class).create?
              = link_to({ action: :new, type: :folder, parent_id: @folder&.id }, remote: true, class: 'btn btn-default')
                span.fa.fa-folder-o
                = t('.new_folder')
              = link_to({ action: :new, type: :other, parent_id: @folder&.id }, remote: true, class: 'btn btn-default')
                span.fa.fa-upload
                = t('.upload')
        = search_form_for(filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          = f.input :parent_id_in, as: :hidden, input_html: { value: @folder&.id }
          = f.input :name_cont,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed' }
      .panel-body
        #filterrific_results
          = render partial: 'list'
