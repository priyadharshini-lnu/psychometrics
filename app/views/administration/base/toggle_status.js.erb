// If sidebar has been opened then we reload him
if($('#sidebar').hasClass('opened')){
  $(document).trigger('load_sidebar', ['#<%= dom_id(@resource) %>']);
} else {
  // Remove active class from active tr
  $('#resource_list').find('.active').removeClass('active');
}

// Notify message
noty({text: '<%= t("administration.#{@resource_class.model_name.plural}.toggle_status.successfully", name: @resource.decorate.display_name) %>', type: 'success'});

$('#<%= dom_id(@resource) %>').hide("fast", function(){
  var resource = $('<%= j render(partial: 'resource', locals: { resource: @resource }) %>').hide();
  $(this).replaceWithPush(resource).addClass('active').show('slow');

  // Reinit all plugins
  $(document).trigger('initPlugins');
});
