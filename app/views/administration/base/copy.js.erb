$cloned_resource = $('<%= j render(partial: 'resource', locals: { resource: @cloned_resource }) %>').hide();
$('#<%= @resource_class.model_name.plural %>_list')
    .find('#<%= dom_id(@resource) %>')
    .before($cloned_resource);

$cloned_resource.show('slow');

// Reinit plugins
$(document).trigger('initPlugins');

// Notify message
noty({text: '<%= t("administration.#{@resource_class.model_name.plural}.update.successfully") %>', type: 'success'});
