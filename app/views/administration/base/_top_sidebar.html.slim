/! START X-NAVIGATION VERTICAL
ul.x-navigation.x-navigation-horizontal.x-navigation-panel
  /! TOGGLE NAVIGATION
  li.xn-icon-button
    a.x-navigation-minimize href="#"
      span.fa.fa-dedent
  /! END TOGGLE NAVIGATION
  /! SIGN OUT
  li.xn-icon-button.pull-right
    = link_to destroy_administrator_session_path, method: :delete, data: { confirm: { body: t('.sign_out_message.body'), title: t('.sign_out_message.title') } } do
      span.fa.fa-sign-out
  /! END SIGN OUT
/! END X-NAVIGATION VERTICAL
/! START BREADCRUMB
ul.breadcrumb
  = render_breadcrumbs tag: :li, separator: ''
/! END BREADCRUMB
