= javascript_pack_tag 'vendors2'
= javascript_pack_tag 'vendors'
= stylesheet_pack_tag 'vendors2'
= stylesheet_pack_tag 'vendors'
= stylesheet_pack_tag 'admin/adminJobs'

/! START X-NAVIGATION VERTICAL
ul.x-navigation.x-navigation-horizontal.x-navigation-panel
  /! TOGGLE NAVIGATION
  li.xn-icon-button
    a.x-navigation-minimize href="#"
      span.fa.fa-dedent
  /! END TOGGLE NAVIGATION
  /! SIGN OUT
  li.xn-icon-button.pull-right
    = link_to destroy_administration_session_path, method: :get, data: { confirm: { body: t('.sign_out_message.body'), title: t('.sign_out_message.title') } } do
      span.fa.fa-sign-out
  li.xn-icon-button.pull-right.z-index-2#admin-job-wrapper
  /! END SIGN OUT
/! END X-NAVIGATION VERTICAL
/! START BREADCRUMB
- if breadcrumbs.present?
  ul.breadcrumb
    - if content_for? :breadcrumbs
      = yield :breadcrumbs
    - else
      = render_breadcrumbs tag: :li, separator: ''
/! END BREADCRUMB
= javascript_pack_tag 'admin/adminJobs'
