<% if resource.destroyed? %>
  $('#filter').trigger('reloadList');
  // Reinit all plugins
  $(document).trigger('initPlugins');

  $(document).trigger('close_sidebar');

  // Notify message
  noty({text: '<%= t("administration.#{i18n || resource_class.model_name.plural}.destroy.successfully", name: resource.decorate.display_name) %>', type: 'success'});
<% else %>
  noty({text: '<%= resource.errors.full_messages.join(", ") %>', type: 'error', timeout: 14000 });
<% end %>
