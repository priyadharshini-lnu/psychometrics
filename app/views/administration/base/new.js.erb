$(function () {
  var $modalPartial = $("<%= j render 'modal', local_assigns.merge( header: t("administration.#{i18n || resource_class.model_name.plural}.new.header") ) %>"),
      $modalPartialForm = $modalPartial.find('.modal-content'),
      $modalContainer = $('#modal-container');

  if ($modalContainer.html().length) {
    $modalContainer.find('.modal-content').replaceWith($modalPartialForm)
  } else {
    $modalContainer.html($modalPartial);
    $modalBox = $modalContainer.find('.modal');
    $modalBox.modal('show');
    $modalBox.on('hidden.bs.modal', function (e) {
      $(this).remove();
    });
  }

  // Reinit all plugins
  $(document).trigger('initPlugins');
  $(document).trigger('initDatetimepicker');
});
