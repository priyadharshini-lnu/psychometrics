$(function () {
  var $modalBox = $('#modal-container').find('.modal');

  $modalBox.modal('hide');
  $modalBox.on('hidden.bs.modal', function () {
    $('#filter').trigger('reloadList');
    $(document).trigger('initPlugins');

    // Notify message
    noty({
      text: '<%= t("administration.#{i18n || resource_class.model_name.plural}.create.successfully", name: resource.decorate.display_name) %>',
      type: 'success'
    });
  });
});
