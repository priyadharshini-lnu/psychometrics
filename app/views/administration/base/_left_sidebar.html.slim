/! START PAGE SIDEBAR
.page-sidebar
  /! START X-NAVIGATION
  ul.x-navigation
    li.xn-logo
      = link_to Settings.project_name, administration_root_path
      a.x-navigation-control href="#"
    li.xn-profile
      = link_to administration_root_path, class: 'profile-mini'
        span.mb-title-icon.fa.fa-user
      .profile
        .profile-data
          = link_to current_administrator.decorate.display_name, edit_administration_profiles_path, class: 'profile-data-name'
          .profile-data-title = current_administrator.decorate.role
    li.xn-title Navigation
    = active_link_to(administration_root_path, active: :exclusive, wrap_tag: :li, data: { toggle: 'tooltip', title: t('administration.navigation.home'), placement: 'right' })
      i.fa.fa-home
      span.xn-text = t('administration.navigation.home')
    - if policy(:user).index?
      = active_link_to(administration_users_path, wrap_tag: :li, data: { toggle: 'tooltip', title: t('administration.navigation.users'), placement: 'right' })
        i.fa.fa-users
        span.xn-text = t('administration.navigation.users')
    - if policy(:norm).index?
      = active_link_to(administration_norms_path, wrap_tag: :li, data: { toggle: 'tooltip', title: t('administration.navigation.norms'), placement: 'right' })
        i.fa.fa-file-text-o
        span.xn-text = t('administration.navigation.norms')
    - if policy(:dimension).index?
      = active_link_to(administration_dimensions_path, wrap_tag: :li, data: { toggle: 'tooltip', title: t('administration.navigation.dimensions'), placement: 'right' })
        i.fa.fa-file-text-o
        span.xn-text = t('administration.navigation.dimensions')
    - if policy(:assessment).index?
      = active_link_to(administration_assessments_path, wrap_tag: :li, data: { toggle: 'tooltip', title: t('administration.navigation.assessments'), placement: 'right' })
        i.fa.fa-universal-access
        span.xn-text= t('administration.navigation.assessments')
    - if policy(:client).index?
      = active_link_to(administration_clients_path, wrap_tag: :li, data: { toggle: 'tooltip', title: t('administration.navigation.clients'), placement: 'right' })
        .fa.fa-briefcase
        span.xn-text= t('administration.navigation.clients')
    li.xn-openable
      a href="#"
        .fa.fa-plus
        span.xn-text = t('administration.navigation.create')
      ul
        li.xn-openable
          a href="#" Assessment
          ul
            li = link_to(t('administration.navigation.psychometrics'), '#')
        li.xn-openable
          a href="#" Survey
          ul
            li
              a href="#" 360
            li
              a href="#" Organisational
        li.xn-openable
          a href="#" User(s)
          - if policy(:user).new? || policy(:user).import?
            ul
              - if policy(:user).new?
                li = link_to t('administration.navigation.users_add'), [:new, :administration, :user], remote: true
              - if policy(:user).import?
                li = link_to t('administration.navigation.users_import'), [:new, :administration, :import, { resource: :user, type: :csv }], remote: true
        - if policy(:client).new?
          li = link_to(t('administration.navigation.client'), [:new, :administration, :client], remote: true)
        li.xn-openable
          a href="#" Report
          ul
            li
              a href="#" Psychometric
            li
              a href="#" 360
            li
              a href="#" Organisational
        li.xn-openable
          a href="#" Benchmarks
          ul
            li
              a href="#" Historical
            li
              a href="#" External
        li
          a href="#" Email Template
        li
          a href="#" Theme
        li
          a href="#" Org Structure
        li
          a href="#" Library
        li
          a href="#" Action Plan
    li
      a href='#'
        span.xn-text Client Tenancies
    li
      a href='#'
        span.xn-text Libraries
    li
      a href='#'
        span.xn-text Retail
    li.xn-openable
      a href='#'
        span.xn-text Reporting
      ul
        li
          a href="#" Psychometric
        li
          a href="#" 360
        li
          a href="#" Organisational

    li
      a href='#'
        span.xn-text Administrators
    li
      a href='#'
        span.xn-text Scoring
    li
      a href='#'
        span.xn-text API Integrations
    li
      a href='#'
        span.xn-text Help

  /! END X-NAVIGATION
/! END PAGE SIDEBAR
