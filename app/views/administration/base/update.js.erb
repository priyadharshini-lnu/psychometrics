$('#modal-container').find('.modal').modal('hide');
$('#modal-container').find('.modal').on('hidden.bs.modal', function(){
  $('#<%= dom_id(@resource) %>').hide("fast", function(){
    var resource = $('<%= j render(partial: 'resource', locals: { resource: @resource }) %>').hide();
    $(this).replaceWithPush(resource).addClass('active').show('slow');
    $(document).trigger('initPlugins');
  });
});
$(document).trigger('resource:updated', ['<%= @resource.to_json.html_safe %>']);
// Notify message
noty({text: '<%= t("administration.#{@resource_class.model_name.plural}.update.successfully", name: @resource.decorate.display_name) %>', type: 'success'});
