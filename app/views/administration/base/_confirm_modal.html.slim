script id="mb-confirm-template" type="x-tmpl-mustache"
  #mb-confirm.message-box.animated.fadeIn data-sound="alert"
    .mb-container
      .mb-middle
        .mb-title
          span.mb-title-icon.fa.fa-warning
          span.mb-title-text
            | {{{ title }}}
        .mb-content
          | {{{ body }}}
        .mb-footer
          .pull-right
            button.btn.btn-success.btn-lg.mb-control-close.mb-confirm-yes  tabindex="0" data-dismiss="modal" = t('yes')
            button.btn.btn-default.btn-lg.mb-control-close tabindex="0" data-dismiss="modal" = t('no')
