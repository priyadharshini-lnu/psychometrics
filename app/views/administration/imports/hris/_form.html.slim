= simple_form_for(resource, as: :import, url: { action: :create }, remote: true, html: { multipart: true }) do |f|
  .modal-body
    .form-inputs.clearfix
      = f.input :client_id, as: :hidden
      = f.input :file, as: :file, error: false
      - if f.object.errors.any?
        - f.object.errors.to_a.each do |error|
          .text-danger = error
  .modal-footer
    .btn-group
      = f.button :submit, t('.import'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'
javascript:
  $(function(){
    $('#new_import').on('submit', function(event) {
      event.stopPropagation(); // Stop stuff happening
      event.preventDefault(); // Totally stop stuff happening

      var form = $(this);
      var formdata = false;
      if (window.FormData){
          formdata = new FormData(form[0]);
      }

      var formAction = form.attr('action');
      $.ajax({
        url         : formAction,
        data        : formdata ? formdata : form.serialize(),
        dataType    : 'script',
        cache       : false,
        contentType : false,
        processData : false,
        type        : 'POST',
        success     : function(data, textStatus, jqXHR){

        }
      });
    });
  });
