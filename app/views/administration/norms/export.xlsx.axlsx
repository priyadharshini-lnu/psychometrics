# frozen_string_literal: true

xlsx_package.use_shared_strings = true
wb = xlsx_package.workbook
FactorsNorm::NORM_TYPES.each do |type|
  styles = wb.styles
  text_center_bold = styles.add_style alignment: { horizontal: :center, vertical: :center }, b: true

  wb.add_worksheet(name: "#{resource.name} #{type.upcase}") do |sheet|
    sheet.add_row [resource.dimension.name]
    sheet.add_row
    sheet.add_row [nil, nil] + resource.decorate.xls_levels_row, style: text_center_bold
    @factors_norms[type]['factors'].each do |factor|
      current_row = [nil, factor[:name]]
      FactorsNorm::LEVELS.each do |level|
        cell = factor[:factors_norms_props].find { |c| c['level'] == level }
        current_row << cell.try(:[], 'score_from')
        current_row << cell.try(:[], 'score_to')
      end
      sheet.add_row current_row
    end
    sheet.add_row
    sheet.add_row
    a = sheet.add_row ['factor', 'sub-factor'] + resource.decorate.xls_levels_row, style: text_center_bold
    sheet.merge_cells "C#{sheet.rows.size}:D#{sheet.rows.size}"
    sheet.merge_cells "E#{sheet.rows.size}:F#{sheet.rows.size}"
    sheet.merge_cells "G#{sheet.rows.size}:H#{sheet.rows.size}"
    sheet.merge_cells "I#{sheet.rows.size}:J#{sheet.rows.size}"
    sheet.merge_cells "K#{sheet.rows.size}:L#{sheet.rows.size}"
    @factors_norms[type]['sub_factors'].each do |factor|
      current_row = factor[:parent].name, factor[:name]
      FactorsNorm::LEVELS.each do |level|
        cell = factor[:factors_norms_props].find { |c| c['level'] == level }
        current_row << cell.try(:[], 'score_from')
        current_row << cell.try(:[], 'score_to')
      end
      sheet.add_row current_row
    end
    sheet.merge_cells 'C3:D3'
    sheet.merge_cells 'E3:F3'
    sheet.merge_cells 'G3:H3'
    sheet.merge_cells 'I3:J3'
    sheet.merge_cells 'K3:L3'
  end
end
