table.table.table-bordered.table-actions.table-hover.selectable.mbn.table-condensed
  thead
    tr
      th.text-center = t 'administration.norms.editor.factors'
      th.text-center = t 'administration.norms.editor.sub_factors'
      - FactorsNorm::LEVELS.each do |level|
        th.text-center colspan="2" width="150" = level
  tbody
    - @resources.each do |factor|
      tr
        td.text-center = factor[:parent][:name]
        td.text-center = factor[:name]
        - FactorsNorm::LEVELS.each do |level|
          - cell = factor[:factors_norm].props.find { |cell| cell['level'] == level }
          td.text-center
            div class="editable" data-level="#{level}" data-factor="#{factor[:id]}" data-norm="#{@resource.id}" data-norm-type="#{@filterrific.with_norm_type}" data-pk="#{factor[:id]}" data-name="score_from" data-url="#{url_for(administration_factors_norms_update_path()) }"
              = cell.try(:[], 'score_from').try(:round, 5)
          td.text-center
            div class="editable" data-level="#{level}" data-factor="#{factor[:id]}" data-norm="#{@resource.id}" data-norm-type="#{@filterrific.with_norm_type}" data-pk="#{factor[:id]}" data-name="score_to" data-url="#{url_for(administration_factors_norms_update_path()) }"
              = cell.try(:[], 'score_to').try(:round, 5)