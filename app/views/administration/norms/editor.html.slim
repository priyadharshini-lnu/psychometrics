.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
      .panel-body
        = form_for_filterrific @filterrific, html: { class: 'form-inline', id: 'filter' } do |f|
          .row.mbm
            .col-sm-12.phn
              .btn-group data-toggle="buttons"
                - @filterrific.select_options[:by_norm_type].each do |value|
                  label class="btn btn-default #{'active' if f.object.by_norm_type == value}"
                    = f.radio_button(:by_norm_type, value)
                    = value.upcase
              .btn-group.mll data-toggle="buttons"
                - @filterrific.select_options[:by_factor_type].each do |value|
                  label class="btn btn-default #{'active' if f.object.by_factor_type == value}"
                    = f.radio_button(:by_factor_type, value)
                    = t("administration.norms.editor.#{value}")
            .clearfix

        #filterrific_results
          = render partial: @filterrific.by_factor_type