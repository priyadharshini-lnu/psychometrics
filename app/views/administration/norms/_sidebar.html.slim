ul.x-navigation.x-navigation-panel id="sidebar_#{dom_id(@resource)}"
  li.xn-title.title = t('.title', id: @resource.id)
  li.xn-title = t('.assign')
  - if policy(@resource).new?
    li = link_to t('.new'), [:new, :administration, @resource_class.model_name.singular], remote: true
  li.xn-title = t('.view')
  - if policy(@resource).edit?
    li = link_to t('.edit'), [:edit, :administration, @resource], remote: true
  - if policy(@resource).edit?
    li = link_to @resource.decorate.toggle_status_text, [:toggle_status, :administration, @resource], remote: true, method: :patch
  - if policy(@resource).copy?
    li = link_to t('.copy'), [:copy, :administration, @resource], remote: true
  - if policy(@resource).editor?
    li = link_to t('.editor'), [:editor, :administration, @resource]
  - if policy(@resource).import?
    li = link_to t('.import'), [:new, :administration, :import, { resource: @resource_class.model_name.singular, type: :xls }], remote: true
  - if policy(@resource).export?
    li = link_to t('.export'), [:export, :administration, @resource, { format: :xlsx }], target: :_blank
  li.xn-title = t('.surveys')
