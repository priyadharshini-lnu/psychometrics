ul.x-navigation.x-navigation-panel id="sidebar_#{dom_id(@resource)}"
  li.xn-title.title = t('.title')
  - if policy(@resource).edit?
    li = link_to(@resource.decorate.toggle_status_text, [:toggle_status, :administration, @resource], remote: true, method: :patch, data: { confirm: @resource.decorate.toggle_status_confirmation })
  - if policy(@resource).edit?
    li = link_to t('.edit'), [:edit, :administration, @resource], remote: true
  - if policy(@resource).copy?
    li = link_to t('.copy'), [:copy, :administration, @resource], remote: true
  - if policy(@resource).destroy?
    li = link_to(t('.destroy'), { action: :destroy, id: @resource }, remote: true, method: :delete, data: { confirm: @resource.decorate.delete_confirmation })
  - if policy(@resource).editor?
    li = link_to t('.editor'), [:editor, :administration, @resource]
  - if policy(@resource).export?
    li = link_to t('.export'), [:export, :administration, @resource, { format: :xlsx }], target: :_blank
