.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        ul.panel-controls
          li
            - if policy(@resource_class).import?
              = link_to [:new, :administration, :import, { resource: @resource_class.model_name.singular, type: :xls }], remote: true do
                span.fa.fa-building-o
            - if policy(@resource_class).create?
              = link_to [:new, :administration, @resource_class.model_name.singular], remote: true do
                span.fa.fa-plus
      .panel-body
        = form_for_filterrific @filter, as: :filter, html: { class: 'form-inline', id: 'filter' } do |f|
          = f.hidden_field :sorted_by
          .row.mbm
            .col-sm-6.phn

            .col-md-3.col-md-offset-3.col-sm-4.col-sm-offset-2.phn
              .input-group.pull-right
                = f.text_field(:search_query, placeholder: t('administration.search'), class: 'periodically-observed form-control')
                span.input-group-addon
                  .fa.fa-search
            .clearfix
        #filterrific_results
          = render partial: 'list'
