tr data-sidebar=url_for([:sidebar, :administration, resource]) id=dom_id(resource)
  td.text-center
    = link_to([:toggle_status, :administration, resource], method: :patch, remote: true, data: { confirm: resource.decorate.toggle_status_confirmation })
      = resource.decorate.status
  td == "#{resource.name} (#{link_to('factors', [:administration, resource, :factors])} / #{link_to('occupations', [:administration, resource, :occupations])})"
  td.text-center = resource.factors_count
  td = resource.decorate.client_name
  td
    = link_to [:edit, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm mrm', data: { toggle: 'tooltip', title: t('.tooltips.edit') }
      span.fa.fa-pencil
    = link_to [:copy, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm mrm', data: { toggle: 'tooltip', title: t('.tooltips.copy') }
      span.fa.fa-copy
    = link_to [:administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm mrm', method: 'delete', data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete')}
      span.fa.fa-times
  td = resource.decorate.created_at
  td = resource.decorate.updated_at
