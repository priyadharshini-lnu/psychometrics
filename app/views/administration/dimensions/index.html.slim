.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t '.title'
        .pull-right
          .dropdown
            button.btn.btn-default.btn-info.dropdown-toggle type="button" data-toggle="dropdown" aria-expanded="false"
              = t('.new') 
              i.fa.fa-caret-down.ml-2
            ul.dropdown-menu.dropdown-menu-right
              li = link_to t('.create_dimension'), new_administration_dimension_path, remote: true, class: "dropdown-item"
              li = link_to t('.import_dimension'), import_administration_dimensions_path, remote: true, class: "dropdown-item", data: { toggle: "modal-container" }
        = search_form_for(filter_form,
                          url: { action: :index },
                          html: { id: 'filter', class: 'list-filter' },
                          builder: SimpleForm::FormBuilder) do |f|
          = f.input :filterable_fields,
                    as: :string,
                    required: false,
                    placeholder: t('administration.search'),
                    label: false,
                    input_html: { class: 'has_clear periodically-observed', value: @filter_term }
      .panel-body
        #filterrific_results
          = render partial: 'list'
= vite_javascript_tag 'entrypoints/admin/dimension_import_app.jsx'

#modal-container
