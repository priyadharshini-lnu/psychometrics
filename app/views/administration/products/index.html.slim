.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title')
        .pull-right
          - if policy(@resource_class).new?
            = link_to new_administration_product_path, remote: true, class: 'btn btn-default'
              span.fa.fa-plus
              = t('.add')            
      .panel-body
        .row
          .col-sm-10
            #filter_results
              = render partial: 'list'
          .col-sm-2
            h3 
              i.fa.fa-filter
              | Filter
            = search_form_for(@filter_form, 
                              url: { action: :index }, 
                              html: { id: 'filter' },
                              builder: SimpleForm::FormBuilder) do |f|
              = f.input :name_cont, 
                        label: t('administration.search'), 
                        as: :string, 
                        required: false, 
                        placeholder: t('administration.search'), 
                        input_html: { class: 'has_clear periodically-observed' }                              
              = link_to "Clear Filter", request.path, class: "btn btn-block btn-default"
