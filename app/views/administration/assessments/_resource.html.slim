tr data-sidebar=url_for([:sidebar, :administration, resource]) id=dom_id(resource)
  td.text-center
    = link_to([:toggle_status, :administration, resource], method: :patch, remote: true, data: { confirm: resource.decorate.toggle_status_confirmation })
      = resource.decorate.status
  td = link_to resource.decorate.name, administration_assessment_path(resource)
  td = resource.dimension.try(:decorate).try(:display_name)
  td = resource.decorate.created_at
  td = resource.decorate.updated_at
  td.actions-cell
    = link_to [:edit, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', data: { toggle: 'tooltip', title: t('.tooltips.edit') }do
      span.fa.fa-pencil
    = link_to [:copy, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm' , data: { toggle: 'tooltip', title: t('.tooltips.copy') } do
      span.fa.fa-copy
    = link_to [:administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm', method: 'delete', data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete')}
      span.fa.fa-times
