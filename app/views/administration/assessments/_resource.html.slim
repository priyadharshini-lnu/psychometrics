tr data-sidebar=url_for([:sidebar, :administration, resource]) id=dom_id(resource)
  td = resource.id
  td.text-center
    = link_to_if policy(resource).edit?,
      resource.decorate.status,
      ([:toggle_status, :administration, resource]), method: :patch, class: 'toggle-status btn disabled disable-link', remote: true, data: { confirm: resource.decorate.toggle_status_confirmation }
  td
    - if policy(resource).show?
      - if resource.agile?
        = link_to resource.decorate.name, administration_assessment_agiles_path(resource)
      - else
        = link_to resource.decorate.name, administration_assessment_path(resource)
    - else
      = resource.decorate.name
  td = resource.dimension.try(:decorate).try(:display_name)
  td = resource.decorate.owner_link
  td = resource.decorate.type
  td.text-center = resource.decorate.created_at
  td.text-center = resource.decorate.updated_at
  td.actions-cell
    - if policy(resource).edit?
      = link_to [:edit, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm edit disabled disable-link', data: { toggle: 'tooltip', title: t('.tooltips.edit') } do
        span.fa.fa-pencil
    - if policy(resource).copy?
      = link_to [:copy, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm copy disabled disable-link' , data: { toggle: 'tooltip', title: t('.tooltips.copy'), disable_with: t('.in_progress.copying') } do
        span.fa.fa-copy
    - if policy(resource).destroy? &&  resource.deleted?
      = link_to [:administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm delete disabled disable-link',
        method: 'delete', data: { confirm: resource.decorate.delete_confirmation,
        toggle: 'tooltip', title: t('.tooltips.delete'), disable_with: t('.in_progress.deleting') }
        span.fa.fa-times
    - if policy(resource).soft_delete? && !resource.deleted?
      = link_to [:soft_delete, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm disabled disable-link',
        method: 'delete', data: { confirm: resource.decorate.soft_delete_confirmation,
        toggle: 'tooltip', title: t('.tooltips.soft_delete'), disable_with: t('.in_progress.deleting') }
        span.fa.fa-trash
    - if policy(resource).restore? && resource.deleted?
      = link_to [:restore, :administration, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm disabled disable-link',
        method: 'put', data: { toggle: 'tooltip', title: t('.tooltips.restore'), disable_with: t('.in_progress.restoring') }
        span.fa.fa-refresh

