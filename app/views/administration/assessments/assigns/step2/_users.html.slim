.row
  .col-md-6
    .row
      .col-md-4
        h4
          i.fa.fa-filter
          =< t('.filter_form')
        = search_form_for @filter_form, 
                          builder: SimpleForm::FormBuilder, 
                          url: { action: :not_selected_users }, 
                          remote: true, 
                          id: 'search_not_selected' do |f|
          = f.input :exclude_ids, as: :hidden, input_html: { value: @assign.user_ids.join(',') }
          = f.input :user_role_in, 
                    collection: ::User::USER_ROLES.map { |role, value| [t("activerecord.attributes.user.roles.#{role}"), value] }, 
                    input_html: { multiple: true },
                    required: false,
                    label: 'Roles'
          = f.input :client_id_in, 
                    label: 'Client', 
                    required: false, 
                    collection: @clients, 
                    include_blank: 'All', 
                    input_html: {  data: { live_search: true } }
          = f.input :user_first_name_or_user_last_name_or_user_email_cont, 
                    label: 'Search', 
                    as: :string, 
                    required: false, 
                    placeholder: t('administration.search'), 
                    input_html: { class: 'has_clear' }
          = f.input :hris_data_cont, 
                    label: 'HRIS data', 
                    required: false, 
                    input_html: { id: 'users_not_selected_hris-data-cont' }
          = f.button :submit, t('.filter')                             
      .col-md-8
        h4 = t('.not_selected_users')
        table#users_not_selected.table.table-striped.table-bordered
        #addSelected.btn.btn-default.pull-right Add Selected
  .col-md-6
    .row
      .col-md-8
        h4 = t('.selected_users')
        table#users_selected.table.table-striped.table-bordered              
        #removeSelected.btn.btn-default Remove Selected            
      .col-md-4
        h4
          i.fa.fa-filter
          =< t('.filter_form')
        = search_form_for @filter_form, 
                          builder: SimpleForm::FormBuilder, 
                          url: { action: :selected_users }, 
                          remote: true, 
                          id: 'search_selected' do |f|                
          = f.input :include_ids, as: :hidden, input_html: { value: @assign.user_ids.join(',') }              
          = f.input :user_role_in, 
                    collection: ::User::USER_ROLES.map { |role, value| [t("activerecord.attributes.user.roles.#{role}"), value] }, 
                    input_html: { multiple: true },
                    required: false,
                    label: 'Roles'
          = f.input :client_id_in, 
                    label: 'Client', 
                    required: false, 
                    collection: @clients, 
                    include_blank: 'All', 
                    input_html: {  data: { live_search: true } }
          = f.input :user_first_name_or_user_last_name_or_user_email_cont, 
                    label: 'Search', 
                    as: :string, 
                    required: false, 
                    placeholder: t('administration.search'), 
                    input_html: { class: 'has_clear' }
          = f.input :hris_data_cont, 
                    label: 'HRIS data', 
                    required: false, 
                    input_html: { id: 'users_selected_hris-data-cont' }
          = f.button :submit, t('.filter')                               
                                 
javascript:
  $(function() {
  
    // Add to Selected Side
    $('#addSelected').on('click', function (e){
      var table = $('#users_not_selected').DataTable(),
          data = table.rows('.selected').data();
      var user_ids = $.map(data, function (obj) {
        return obj.id
      }).join(',');
      
      var new_users_ids = [$('#q_include_ids').val(), user_ids].join(',');
      $('#q_exclude_ids, #q_include_ids, #assign_user_ids').val(new_users_ids);
      $('#search_not_selected, #search_selected').submit();
      table.columns().checkboxes.deselect();
    });
    
    // Add to Selected Side
    $('#removeSelected').on('click', function (e){
      var table = $('#users_selected').DataTable();
      var selected_rows = table.rows('.selected')
      table.columns().checkboxes.deselect();
      selected_rows.remove().draw( false );
      var data = table.rows().data();
      
      var user_ids = $.map(data, function (obj) {
        return obj.id
      }).join(',');
      
      $('#q_exclude_ids, #q_include_ids, #assign_user_ids').val(user_ids);
      $('#search_not_selected, #search_selected').submit();
    });    
  
    // HRIS data table
    $('#users_not_selected_hris-data-cont').kvJsonInput();
    $('#users_selected_hris-data-cont').kvJsonInput();
    
    // Common DataTable config
    var dataTableCommonConfig = {
      sDom: 'rtip',          
      columns: [
        { data: "id" },
        { data: "name", title: 'Name' },
        { data: "client_name", title: 'Client' },
        { data: "role_name", title: 'Role' }
      ],
      columnDefs: [
         {
            targets: 0,
            checkboxes: {
               selectRow: true
            }
         }
      ],
      select: {
         style: 'multi'
      },
      order: [[1, 'asc']]                
    }
    
    // Not Selected side
    var users_not_selected_config = $.extend({
      ajax: {
        url: $('#search_not_selected').attr('action') + '?' + $('#search_not_selected').serialize(),
        dataSrc: ''
      }
    }, dataTableCommonConfig);          
    $('#users_not_selected').DataTable(users_not_selected_config);
    $('#search_not_selected').on('submit', function (e){
      e.preventDefault();
      var url = $('#search_not_selected').attr('action') + '?' + $('#search_not_selected').serialize()
      $('#users_not_selected').DataTable().ajax.url(url).load();
    });
    
    
    // Selected side
    var users_selected_config = $.extend({
      ajax: {
        url: $('#search_selected').attr('action') + '?' + $('#search_selected').serialize(),
        dataSrc: ''
      }
    }, dataTableCommonConfig)
    
    $('#users_selected').DataTable(users_selected_config);
    $('#search_selected').on('submit', function (e){
      e.preventDefault();
      var url = $('#search_selected').attr('action') + '?' + $('#search_selected').serialize()
      $('#users_selected').DataTable().ajax.url(url).load();
    });            
    
  });
