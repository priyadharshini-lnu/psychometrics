.row
  .col-md-12
    .panel.panel-default
      .panel-heading
        h3.panel-title = t('.title', name: @assessment.decorate.display_name)
      .panel-body
        = render_error_notification(@assign_form)      
        .form-horizontal.mbm
          .form-group
            label class="col-sm-3 control-label text-right" for="client_ids"        
              = t('.clients')
            .col-sm-7
              = select_tag 'assign[client_ids]', 
                           options_from_collection_for_select(policy_scope([:assessments, Client]).all, 'id', 'name', @assign_form.client_ids), 
                           id: 'client_ids', 
                           class: 'select form-control',
                           data: { live_search: true }, 
                           multiple: true  
              .help-block = t('.help_block')
            .col-sm-2            
              button#load_form.btn.btn-default type='button' = t('.load_form')
        #form
          - if @assign_form.client_ids.present?                         
            = render partial: 'form'        
      .panel-footer
        = link_to t('administration.back'), administration_assessments_path, class: 'btn btn-default mrh'
        #assign_submit.btn.btn-primary.pull-right.mrh onclick="document.forms['new_assign'].submit();" = t('.next')                               
javascript:
  $(function () {
    var load_form_url = '#{url_for({ action: :form })}';
    $(document).on('click', '#load_form', function() {
      var self = this
      $.ajax({
        url: load_form_url,
        method: 'POST',
        data: $('#client_ids').serialize(),
        dataType: 'script',
        beforeSend: function () {
          panel_refresh($('#client_ids').closest('.panel'));
        },
        complete: function () {
          panel_refresh($('#client_ids').closest('.panel'));        
        }
      });
    });     
  });
