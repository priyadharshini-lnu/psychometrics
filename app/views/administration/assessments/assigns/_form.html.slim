= simple_form_for(@assign_form,
                  as: :assign,
                  url: { action: :create },
                  wrapper: :horizontal_form,
                  html: { class: 'form-horizontal' }) do |f|
  = f.input_field :client_ids, collection: @clients, multiple: true, class: 'hidden'
  = f.input :report_ids,
            collection: @assessment.reports.for_clients(@clients.map(&:id)).distinct,
            include_blank: false,
            input_html: { data: { live_search: true }, multiple: true }
  = f.input :access_reports,
            as: :radio_buttons,
            wrapper: :horizontal_radio_and_checkboxes,
            collection: [[t('.access_reports.immediately'), :immediately],
                         [t('.access_reports.specific_datetime'), :specific_datetime]]
  #specific_datetime class="mbm #{'hidden' if f.object.access_reports == 'immediately'}"
    = f.input :access_reports_at_date, input_html: { class: 'datepicker' }
    = f.input :access_reports_at_time, input_html: { class: 'timepicker' }
  = f.input_field :user_ids, as: :select, collection: users.map { |u| [u.id, u.id] }, multiple: true, class: 'hidden'
  = f.input :manager_ids,
            as: :grouped_select,
            collection: @managers,
            group_method: :last,
            label_method: lambda { |u| u.decorate.display_name },
            group_label_method: :first,
            input_html: {  class: 'multiselect-two-sides-searchabel', multiple: true }
#users.mtl
  = render partial: 'users'
javascript:
  $(function () {
    $('input[name="assign[access_reports]"]').change(function (e){
      if ($(this).val() == 'specific_datetime') {
        $('#specific_datetime').removeClass('hidden');
      } else {
        $('#specific_datetime').addClass('hidden');
      }
    });
  });
