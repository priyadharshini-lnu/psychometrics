# frozen_string_literal: true

xlsx_package.use_shared_strings = true
wb = xlsx_package.workbook
styles = wb.styles
text_center_bold = styles.add_style alignment: { horizontal: :center, vertical: :center }, b: true
styles.add_style alignment: { wrap_text: true }

factors = resource.factors.where('factors_scoring.props->>0 is not null').order(:name).distinct
questions = resource.questions.includes(factors_scorings_with_props: :factor).
            where("questions.props-> 'choices' is not null")
tail_cells = Array.new(factors.size + 1)

wb.add_worksheet(name: resource.name.to_s) do |sheet|
  sheet.add_row ['Question Name', 'Question text', 'Answers'] + factors.map(&:name), style: text_center_bold
  questions.each do |question|
    sheet.add_row [
      question.name,
      Nokogiri::HTML(question.props['questionText']).text.delete("\n").gsub(/<!--.*-->/, '')
    ] + tail_cells

    factors_hash = {}
    factors_hash.tap do |h|
      question.factors_scorings_with_props.each do |f|
        f.props.map { |p| h[p['index']] = { value: p['value'], factor_id: f.factor_id } }
      end
    end

    row_index = sheet.rows.last.row_index
    question.props['choicesTexts'].each_with_index do |answer, i|
      sheet.add_row [nil, nil, nil] + tail_cells if i != 0
      sheet.rows[row_index + i].cells[2].value = answer

      if factors_hash[i]
        sheet.rows[row_index + i].
          cells[factors.ids.index(factors_hash[i][:factor_id]) + 3].value = factors_hash[i][:value]
      end
    end
  end
end
