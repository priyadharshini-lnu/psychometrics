#psychometrics_preview[data-data="#{AssessmentSerializer.new(context: { selected_locale: params[:assessmentLang] }, include: '**').serialize(resource).to_json}"
  data-type="preview_assessment"
  data-locales=@translations.to_json
  data-selected-locale=params[:assessmentLang]
  data-lang-partial="#{escape_once (render partial: 'application/lang', locals: { locales: @available_translations, lang_param: 'assessmentLang', selected_locale: params[:assessmentLang] })}"]

= vite_javascript_tag 'entrypoints/assessment/preview.jsx'
