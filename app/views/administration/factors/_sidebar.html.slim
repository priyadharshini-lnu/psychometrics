ul.x-navigation.x-navigation-panel id="sidebar_#{dom_id(resource)}"
  li.xn-title.title = t('.title')
  - if policy(resource, { project_id: @dimension.owner_id }).edit?
    li = link_to(resource.decorate.toggle_status_text, [:toggle_status, :administration, @dimension, resource], remote: true, method: :patch, data: { confirm: resource.decorate.toggle_status_confirmation })
  - if policy(resource, { project_id: @dimension.owner_id }).edit?
    li = link_to t('.edit'), [:edit, :administration, @dimension, resource], remote: true
  - if policy(resource, { project_id: @dimension.owner_id }).copy?
    li = link_to t('.copy'), [:copy, :administration, @dimension, resource], remote: true
    - if policy(resource, { project_id: @dimension.owner_id }).destroy?
      li = link_to(t('.destroy'), { action: :destroy, dimension_id: @dimension, id: resource }, remote: true, method: :delete, data: { confirm: resource.decorate.delete_confirmation })
