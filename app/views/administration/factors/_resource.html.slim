tr data-sidebar=url_for([:sidebar, :administration, @dimension, resource]) id=dom_id(resource)
  td.text-center.vertical_middle
    = link_to [:toggle_status, :administration, @dimension, resource], method: :patch, class: 'toggle-status', remote: true do
      = resource.decorate.status
  td.vertical_middle
    = image_tag resource.icon.url(:factors_icon), class: 'factors_icon' if resource.icon.url()
  td.vertical_middle = link_to resource.name, [:administration, @dimension, resource, :sub_factors]
  - questions_count = resource.questions_count_by_assessment
  - if questions_count
    td
      - questions_count.each do |ass_id, count|
        div
          = link_to "#{@map_assessments[ass_id].try(:[], 0).try(:name)} - [#{count}]", administration_assessment_path(ass_id, scoring: 1, factor_id: resource.id)
  - else
    td.vertical_middle
  td.text-center.vertical_middle = resource.subfactors_count
  td.text-center.vertical_middle = resource.decorate.created_at
  td.text-center.vertical_middle = resource.decorate.updated_at
  td.actions-cell
    - if policy(resource).actions?
      = link_to [:edit, :administration, @dimension, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm edit', data: { toggle: 'tooltip', title: t('.tooltips.edit') }
        span.fa.fa-pencil
      = link_to [:copy, :administration, @dimension, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm copy', data: { toggle: 'tooltip', title: t('.tooltips.copy') }
        span.fa.fa-copy
      = link_to [:administration, @dimension, resource], remote: true, class: 'btn btn-default btn-rounded btn-sm delete', method: 'delete', data: { confirm: resource.decorate.delete_confirmation, toggle: 'tooltip', title: t('.tooltips.delete')}
        span.fa.fa-times
