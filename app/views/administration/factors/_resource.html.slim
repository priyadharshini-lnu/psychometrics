tr id=dom_id(resource)
  td.text-center = resource.id
  td = resource.name
  td.text-center = resource.decorate.subfactors
  td
    = link_to [:edit, :administration, :dimension, :factor, {id: resource.id, dimension_id: resource.dimension_id }], remote: true, class: 'btn btn-default btn-rounded btn-sm mrm'  do
      span.fa.fa-pencil
    = confirmation_link [:administration, :dimension, :factor, {id: resource.id, dimension_id: resource.dimension_id }], class: 'btn btn-default btn-rounded btn-sm mrm', method: 'delete', data: {confirm: ''} do
      span.fa.fa-times
  td.text-center = resource.decorate.created_at
  td.text-center = resource.decorate.updated_at