#resource_list.table-responsive
  table.table.table-bordered.table-actions.table-hover
    thead
      tr
        th.text-center width="50" = sorting @resource_class, :id, @filterrific
        th = sorting @resource_class, :name, @filterrific
        th.text-center width="150" = sorting @resource_class, :subfactors_count, @filterrific
        th.text-center width='120' = t 'administration.actions'
        th.text-center width='150' = sorting @resource_class, :created_at, @filterrific
        th.text-center width='150' = sorting @resource_class, :updated_at, @filterrific
    tbody
      = render partial: 'resource', collection: @resources
  = paginate @resources, theme: 'twitter-bootstrap-3'