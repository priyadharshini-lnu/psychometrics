.table-responsive
  table.table.table-bordered.table-actions.table-hover.selectable.list id="#{@resource_class.model_name.plural}_list"
    thead
      tr
        th.text-center width="100" = link_to_sort @resource_class, :active, @filter_form
        th width="70" = t 'administration.factors.index.icon'
        th = link_to_sort @resource_class, :name, @filter_form
        th = @resource_class.human_attribute_name(:questions_count)
        th.text-center width="150" = link_to_sort @resource_class, :subfactors_count, @filter_form
        th.text-center width='200' = t 'administration.actions'
        th.text-center width='150' = link_to_sort @resource_class, :created_at, @filter_form
        th.text-center width='150' = link_to_sort @resource_class, :updated_at, @filter_form
    tbody
      - if @resources.present?
        = render partial: 'resource', collection: @resources
      - else
        tr.no_records
          td align='center' colspan='8' = t('administration.no_data_found')
  = paginate @resources, theme: 'twitter-bootstrap-3'
