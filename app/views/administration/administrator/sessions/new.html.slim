div class=(['center', 'box', 'devise', namespace_name].compact.join(' '))
  .panel.panel-default.session
    .panel-body
      .message.pvl
        h1.mvm
          bdi = t('.title')
        .instruction
          bdi = t('.instruction')
      = simple_form_for(resource, as: resource_name, url: administration_session_path) do |f|
        div.clearfix
          == flash_messages
        .username.input-group.mbm
          span#username.input-group-addon
            i.icon-user
          = f.input_field :email, placeholder: 'Email Address', class: 'form-control input-lg'
        .password.input-group.mbm
          span#password.input-group-addon
            i.icon-lock
          = f.input_field :password, placeholder: t('.password_placeholder'), class: 'form-control input-lg'
        .actions.justified.mvm
          div
            button.btn.btn-primary.text-uppercase type="submit" value="Submit"
              = 'Login'
              span class="fa fa-chevron-right mlm"
          div
            = link_to t('.forgot_password'), new_administration_password_path

    .panel-footer
      = render partial: 'devise/shared/footer'
