= simple_form_for(resource, as: :resource, url: { action: resource.new_record? ? :create : :update }, remote: true) do |f|
  .modal-body
    = f.error_notification

    .form-inputs.clearfix
      = f.input :name
      = f.input :description, as: :text
      = f.input :full_description, as: :text
      = f.input :potential_areas_of_study, as: :text
      = f.input :key_career_tracks, as: :text, hint: t('.hint.key_career_tracks')
      = f.input :high_school_entry_roles, as: :text
      = f.input :diploma_qualification, as: :text
      = f.input :bachelors_or_masters_qualification, as: :text
      = f.input :work_environment, as: :text
      = f.input :color
      = f.input :icon, hint: f.object.icon.present? ? f.input(:remove_icon, as: :boolean) + image_tag(f.object.icon.url(:factors_icon), class: 'thumb') : content_tag(:span, t('.no_icon'))
      = f.input :alternative_icon, hint: f.object.alternative_icon.present? ? f.input(:remove_alternative_icon, as: :boolean) + image_tag(f.object.alternative_icon.url(:factors_icon), class: 'thumb') : content_tag(:span, t('.no_icon'))
      = f.input :indicative_roles_image, hint: f.object.indicative_roles_image.present? ? f.input(:remove_indicative_roles_image, as: :boolean) + image_tag(f.object.indicative_roles_image.url(:factors_icon), class: 'thumb') : content_tag(:span, t('.no_icon'))
      = f.input :key_career_tracks_image, hint: f.object.key_career_tracks_image.present? ? f.input(:remove_key_career_tracks_image, as: :boolean) + image_tag(f.object.key_career_tracks_image.url(:factors_icon), class: 'thumb') : content_tag(:span, t('.no_icon'))
  .modal-footer
    .btn-group
      = f.button :submit, resource.new_record? ? t('administration.create') : t('administration.update'), class: 'btn-info'
      a.btn.btn-default data-dismiss='modal' = t 'administration.close'

javascript:
  $(function(){
    var submit = function (method) {
    var form = $(this);
    var formdata = false;
    if (window.FormData){
        formdata = new FormData(form[0]);
    }

    var formAction = form.attr('action');
    $.ajax({
      url         : formAction,
      data        : formdata ? formdata : form.serialize(),
      dataType    : 'script',
      cache       : false,
      contentType : false,
      processData : false,
      type        : method,
      success     : function(data, textStatus, jqXHR){

      }
    });
    }

    $('#new_resource').on('submit', function(event) {
      event.stopPropagation(); // Stop stuff happening
      event.preventDefault(); // Totally stop stuff happening
      submit.call(this, 'POST')
    });
    $('#edit_resource').on('submit', function(event) {
      event.stopPropagation(); // Stop stuff happening
      event.preventDefault(); // Totally stop stuff happening
      submit.call(this, 'PUT')
    });
    $('#resource_color').colorpicker({
        align: 'left'
    });
  });
