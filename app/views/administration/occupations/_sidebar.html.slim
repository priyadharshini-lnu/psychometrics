ul.x-navigation.x-navigation-panel id="sidebar_#{dom_id(resource)}"
  li.xn-title.title = t('.title')
  - if policy(resource, { project_id: @dimension.owner_id }).edit?
    li = link_to t('.edit'), [:edit, :administration, @dimension, resource], remote: true
  /- if policy(resource).copy?
    li = link_to t('.copy'), [:copy, :administration, @dimension, resource], remote: true
