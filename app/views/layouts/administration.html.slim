doctype html
html lang="en" style=shell_html_style
  head
    = render 'layouts/osano_script'
    meta http-equiv='X-UA-Compatible' content='IE=edge'
    meta name='viewport' content='width=device-width, initial-scale=1'
    meta content='text/html; charset=UTF-8' http-equiv='Content-Type'
    = csrf_meta_tags
    - if react_shell?
      = preload_link_tag image_url('marsh-pattern.png'), as: :image
    = vite_javascript_tag "entrypoints/locales/#{I18n.locale || 'en'}.ts"
    = render 'layouts/pys_global_state'
    javascript [nonce=content_security_policy_nonce]:
      window.__INITIAL_STATE__ = #{@init_state.to_json.html_safe}
    = stylesheet_link_tag 'administration', media: 'all'
    - if Rails.env.test?
      = stylesheet_link_tag 'test'
    = javascript_include_tag 'administration'
    = javascript_include_tag "administration/i18n/#{load_translation_file}.js"
    = load_report_translation_file(params)
    = render 'layouts/favicons'
    = vite_client_tag
    = vite_react_refresh_tag
    = render 'shared/webspellchecker'

  / Transparent body outranks the legacy stylesheet's hardcoded white and lets the html backdrop through.
  body#administration class=(I18n.locale == :ar ? 'rtl' : 'ltr' ) data-locale="#{@selected_locale || params[:lang] || I18n.locale}" style=('background: transparent' if react_shell?)
    = render 'shared/maintenance_alert_banner'
    - if session[:impersonated_by_id].present?
      #impersonation-banner-portal data-sign-out-path="#{destroy_administration_session_path}"
      = vite_javascript_tag 'entrypoints/impersonation_banner.tsx'
    / React owns the whole shell (glint AppShell); Rails renders no chrome around it.
    - if react_shell?
      = render 'layouts/admin_splash'
      = yield
    / Rails-rendered pages get no shell — just a way back — until they join the SPA.
    - else
      - unless @hide_navigation
        #admin-back-bar
        = vite_javascript_tag 'entrypoints/admin/back_bar.tsx'
      #flash-messages-container
        #flash-messages.col-md-12
            = flash_messages
      .page-content-wrap
        = yield
    /! START PRELOADS
    = audio_tag('administration/alert.mp3', preload: 'auto', id: 'audio-alert')
    = audio_tag('administration/fail.mp3', preload: 'auto', id: 'audio-fail')
    /! END PRELOADS

    #modal-container
    #confirm-container
    #notification-center-container
    = vite_javascript_tag 'notification_center.jsx'

    #sidebar.sidebar.right style='right: -220px;'
      button.close type='button'
        span.fa.fa-indent
      .content.panel
      .clearfix

    = render partial: 'administration/base/confirm_modal'
    = render partial: 'layouts/consent_banner' unless Settings.osano_enabled
