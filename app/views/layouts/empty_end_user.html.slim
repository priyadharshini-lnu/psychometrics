doctype html
html dir=dir
  head
    meta content=("text/html; charset=UTF-8") http-equiv="Content-Type" /
    meta content="IE=edge" http-equiv="X-UA-Compatible"
    meta content="width=device-width, initial-scale=1" name="viewport"
    title = @current_project&.name
    - primary_color = @current_project&.design_setting&.primary_color.presence || '#061047'
    - bg_color = "#{primary_color}40"
    style
      |
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; background: #{bg_color}; }
        .interstitial-card { background: #fff; padding: 48px 40px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.08); max-width: 600px; width: 100%; text-align: center; }
        .interstitial-card h2 { margin: 0 0 12px; font-size: 22px; color: #1a1a1a; text-align: left; }
        .interstitial-card p { margin: 0 0 28px 0; font-size: 15px; color: #555; line-height: 1.6; text-align: left; }
        .sign-in-btn { display: inline-block; padding: 12px 32px; background: #{primary_color}; color: #fff; border-radius: 4px; text-decoration: none; font-size: 16px; font-weight: 500; transition: background 0.2s; }
        .sign-in-btn:hover { background: #{primary_color}; opacity: 0.85; color: #fff; }

  body
    = yield
