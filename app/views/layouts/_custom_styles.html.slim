- if @current_project && @current_project.design_setting.background&.present?
  css:
    html, body {
      background: url(#{@current_project.design_setting.background.url}) no-repeat center center fixed !important;
      background-size: cover !important;
    }
- elsif @current_project && @current_project.design_setting.background_color&.present?
  css:
    html, body {
      background-image: none
    }

    body {
      background-color: #{@current_project.design_setting.background_color} !important;
    }
