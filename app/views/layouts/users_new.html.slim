doctype html
html
  head
    meta content=("text/html; charset=UTF-8") http-equiv="Content-Type" /
    meta content="IE=edge" http-equiv="X-UA-Compatible"
    meta content="width=device-width, initial-scale=1" name="viewport"
    title = Settings.project_name
    = csrf_meta_tags
    = jquery_include_tag :google
    = stylesheet_link_tag 'application_new', media: 'all'
    = javascript_include_tag 'application_new'
  body#user data-locale="#{selected_locale}" class=('mobile-device' if browser.device.mobile?)
    #modal-container
    header.solid
      .container-fluid
        .row
          .col-xs-6
            - if @current_project&.logo&.url
              = link_to image_tag(@current_project.logo.url), root_path, class: 'clientLogo'
          .col-xs-2.col-sm-2.hidden-xs
          .col-sm-4
            .userNav
              ul.nav.navbar-nav.navbar-right
                li
                  a.user-profile.dropdown-toggle aria-expanded="false" data-toggle="dropdown" href=""
                    = image_tag 'userIcon.png', class: 'userIcon'
                    ' My Account
                    span.fa.fa-angle-down
                  ul.dropdown-menu.dropdown-usermenu.pull-right
                    li
                      = link_to t('.profile'), edit_profiles_path, remote: :true, data: { toggle: 'dropdown' }
                    li
                      = link_to t('.help'), survey_instructions_path
                    li
                      = link_to [:destroy, pundit_user[:current_user].try(:scope), :session], method: :delete do
                        i.fa.fa-sign-out.pull-right
                        = t('.logout')
                /li.dropdown role="presentation"
                  a.dropdown-toggle.info-number aria-expanded="false" data-toggle="dropdown" href=""
                    = image_tag 'notificationIcon.png'
                    span.badge.bg-green 6
                  ul#menu1.dropdown-menu.list-unstyled.notificationList role="menu"
                    li
                      a
                        span.image
                          = image_tag 'userIcon.png'
