                li
                  = link_to image_tag('homeIcon.png'), root_path
    .banner
    .container-fluid.mainContent
      .row
        .col-xs-12.col-md-8.col-md-offset-2
          == flash_messages
      = yield
      #notification-center-container
      = javascript_pack_tag 'notificationCenter'      
    footer.loginFooter.solid
      .container-fluid
        .row
          .col-xs-6.col-sm-3.text-left
