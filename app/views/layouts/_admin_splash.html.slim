/ Static Marsh spinner from the first byte; AdminTheme removes it once the themed shell has painted.
#admin-splash role="status" aria-label="Loading" style="position: fixed; inset: 0; z-index: 2000; display: flex; align-items: center; justify-content: center"
  css:
    @keyframes admin-splash-spin { to { transform: rotate(360deg) } }
    @media (prefers-reduced-motion: reduce) { #admin-splash-ring { animation: none !important } }
  div style="position: relative; width: 80px; height: 80px"
    #admin-splash-ring style="position: absolute; inset: 0; border-radius: 50%; border: 2px solid light-dark(rgba(6, 16, 71, 0.15), rgba(255, 255, 255, 0.1)); border-top-color: light-dark(#061047, rgba(255, 255, 255, 0.8)); animation: admin-splash-spin 1.1s linear infinite"
    div style="position: absolute; inset: 10px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: light-dark(#061047, #FFFFFF); color: light-dark(#FFFFFF, #061047); box-shadow: 0 4px 12px light-dark(rgba(6, 16, 71, 0.25), rgba(0, 0, 0, 0.35))"
      svg width="28" height="29" viewBox="0 0 23.87 25" aria-hidden="true"
        path fill="currentColor" d="M0,0v24.59h4.48v-11.08l7.08,3.39h.34L.44,0h-.44ZM23.43,0l-11.46,16.89h.34s7.08-3.39,7.08-3.39v11.08s4.48,0,4.48,0V0s-.44,0-.44,0Z"
