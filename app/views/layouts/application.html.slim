doctype html
html
  head
    meta content=("text/html; charset=UTF-8") http-equiv="Content-Type" /
    meta content="IE=edge" http-equiv="X-UA-Compatible"
    meta content="width=device-width, initial-scale=1" name="viewport"
    title = Settings.project_name
    = csrf_meta_tags
    = jquery_include_tag :google
    = stylesheet_link_tag    'application', media: 'all'
    = javascript_include_tag 'application'
    - if @current_client && @current_client.background.present?
      css:
        html, body {
          background: url(#{@current_client.background.url}) no-repeat center center fixed !important;
          background-size: cover !important;
        }
    - elsif @current_client && @current_client.background_color.present?
      css:
        html, body {
          background-image: none
        }
        body {
          background-color: #{@current_client.background_color} !important;
        }    
  body
    header
      .container-fluid
        .row
          .col-xs-12.col-sm-3
            = link_to root_path
              - if @current_client && @current_client.logo.present?
                = image_tag @current_client.logo.url, class: 'img-responsive center-block headerLogo', alt: @current_client.decorate.display_name
              - else
                = image_tag 'the-talent-enterprise-logo', class: 'img-responsive center-block headerLogo', alt: 'The Talent Enterprise logo'
          .col-xs-12.col-sm-6
            h1.pageTitle Talent Compass
          .col-sm-2.hidden-xs

    = yield

    footer
      .container-fluid
        .row
          .col-xs-12.col-sm-6
            p.footerLinks
              => link_to 'Privacy Statement', '#'
              | |
              =<> link_to 'Terms & Conditions', '#'
              | |
              =< link_to "FAQ's"
          .col-xs-12.col-sm-6.text-right
            p.footerLogo
              span.poweredBy
                | Powered by
              = image_tag 'the-talent-enterprise-logo-footer', alt: 'The Talent Enterprise logo'
