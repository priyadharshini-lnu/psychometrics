doctype html
html.body-full-height
  head
    meta http-equiv='X-UA-Compatible' content='IE=edge'
    meta name='viewport' content='width=device-width, initial-scale=1'
    meta content='text/html; charset=UTF-8' http-equiv='Content-Type'
    = csrf_meta_tags
    = javascript_include_tag 'application'
    = javascript_include_tag "administration/i18n/#{I18n.locale}.js"
    = vite_client_tag
    = vite_react_refresh_tag
    = render 'layouts/pys_global_state'
    = render 'layouts/favicons'
  body data-locale="#{@selected_locale  || params[:lang] || I18n.locale}"
    = yield
css:
  html {
    font-size: 12px;
  }
  body[data-locale="ar"] #psychometrics_preview,
  * {
    box-sizing: border-box;
  }
  p {
    margin: 0 0 10px;
  }
