doctype html
html.body-full-height
  head
    meta http-equiv='X-UA-Compatible' content='IE=edge'
    meta name='viewport' content='width=device-width, initial-scale=1'
    meta content='text/html; charset=UTF-8' http-equiv='Content-Type'
    title = @current_project&.name || t('devise.administrators.meta_title')
    = csrf_meta_tags
    = render 'layouts/pys_global_state'
    = javascript_include_tag 'administration'
    = stylesheet_pack_tag 'vendors2'
    = stylesheet_pack_tag 'vendors'
    = javascript_pack_tag 'vendors2'
    = javascript_pack_tag 'vendors'
    = render 'layouts/favicons'
  body class=(rtl? ? 'rtl' : 'ltr' ) data-locale="#{I18n.locale}"
    - if show_maintenance_alert?
      div style="color: #fff;width: 100%;padding: 10px;font-size: 14px;background: #fa8c16; text-align: center;"
        = t('maintenance_message', maintenance_time_frame)
    = render 'devise/shared/video'
    = render 'devise/shared/locales'

    javascript:
      __INITIAL_STATE__ = {
        csrfToken: '#{form_authenticity_token}',
        user: #{::Auth::CurrentUserSerializer.new(current_user || resource || User.new).to_json.html_safe},
        projectConfig: #{::Auth::ProjectConfigSerializer.new(@current_project).to_json.html_safe},
        flash: #{flash_json_messages.to_json.html_safe}
      }
    .main#devise
      = yield

    = javascript_pack_tag 'user/login'
