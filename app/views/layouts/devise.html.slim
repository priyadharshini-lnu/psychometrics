doctype html
html.body-full-height
  head
    meta http-equiv='X-UA-Compatible' content='IE=edge'
    meta name='viewport' content='width=device-width, initial-scale=1'
    meta content='text/html; charset=UTF-8' http-equiv='Content-Type'
    title = @current_project&.name || t('devise.administrators.meta_title')
    = csrf_meta_tags
    = vite_client_tag
    = vite_react_refresh_tag
    = render 'layouts/pys_global_state'
    = javascript_include_tag 'threesixty'
    = render 'layouts/favicons'
  body class=(rtl? ? 'rtl' : 'ltr' ) data-locale="#{I18n.locale}"
    - if show_maintenance_alert?
      div style="color: #fff;width: 100%;padding: 10px;font-size: 14px;background: #fa8c16; text-align: center;"
        = t('maintenance_message', **maintenance_time_frame)
    = render 'devise/shared/locales'

    javascript:
      __INITIAL_STATE__ = {
        csrfToken: '#{form_authenticity_token}',
        user: #{::Auth::CurrentUserSerializer.new.serialize((current_user || resource || User.new)).to_json.html_safe},
        projectConfig: #{::Auth::ProjectConfigSerializer.new(context: { background: image_url(randomized_background_image) }).serialize(@current_project || Client.new).to_json.html_safe},
        flash: #{flash_json_messages.to_json.html_safe}
      }
    - action = "#{controller_name}/#{action_name}"
    - if ["registrations/new", "registrations/create"].include?(action)
        javascript:
          #{@form ? ("__INITIAL_STATE__['user'] = " + @form.attributes.to_json).html_safe : ''}
          #{@form ? ("__INITIAL_STATE__['errors'] = " + @form.errors.messages.to_json).html_safe : ''}
    - if ["invitations/update", "passwords/edit", "passwords/update"].include?(action)
        javascript:
          #{resource.persisted? && resource.invalid? ? ("__INITIAL_STATE__['errors'] = " + resource.errors.messages.to_json).html_safe : ''}
    - if ["password_expired/show", "password_expired/update"].include?(action)
        javascript:
          #{("__INITIAL_STATE__['errors'] = " + resource.errors.messages.to_json).html_safe}
    - if action == "magic_links/send_magic_link"
        javascript:
          #{@form ? ("__INITIAL_STATE__['user'] = " + @form.attributes.merge({success: @form.valid?}).to_json).html_safe : ''}
          #{@form ? ("__INITIAL_STATE__['errors'] = " + @form.errors.messages.to_json).html_safe : ''}

    .main#devise

    = vite_javascript_tag 'entrypoints/user/login.jsx'
