doctype html
html.body-full-height style=device_html_style
  head
    meta http-equiv='X-UA-Compatible' content='IE=edge'
    meta name='viewport' content='width=device-width, initial-scale=1'
    meta content='text/html; charset=UTF-8' http-equiv='Content-Type'
    title = @current_project&.name || t('devise.administrators.meta_title')
    = csrf_meta_tags
    = jquery_include_tag :google
    = stylesheet_link_tag 'devise', media: 'all'
    = javascript_include_tag 'administration'
    = render 'layouts/favicons'
  body
    .main#devise
      = yield
