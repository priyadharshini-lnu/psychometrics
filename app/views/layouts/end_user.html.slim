doctype html
html dir=dir lang="#{I18n.locale}"
  head
    = render 'layouts/osano_script'
    meta content=("text/html; charset=UTF-8") http-equiv="Content-Type" /
    meta content="IE=edge" http-equiv="X-UA-Compatible"
    meta content="width=device-width, initial-scale=1" name="viewport"
    javascript [nonce=content_security_policy_nonce]:
      window.I18n = {
        locale: '#{I18n.locale}'
      }

    = csrf_meta_tags
    = render 'shared/locales'
    = render 'layouts/pys_global_state'
    = javascript_include_tag :threesixty
    = stylesheet_link_tag 'threesixty_dependencies', media: 'all'
    - if Settings.enduser_locales.include?(ui_locale)
      = javascript_include_tag "i18n/#{ui_locale}.js"
    - if Settings.enduser_locales.include?(user_locale)
      = javascript_include_tag "i18n/#{user_locale}.js"
    = render 'layouts/favicons'
    = vite_client_tag
    = vite_react_refresh_tag

  body.end-user class=(I18n.locale == :ar ? 'rtl' : 'ltr' )  data-locale="#{I18n.locale}"
    = render 'shared/maintenance_alert_banner'
    - if session[:impersonated_by_id].present?
      #impersonation-banner-portal data-sign-out-path="#{destroy_user_session_path}"
      = vite_javascript_tag 'entrypoints/impersonation_banner.tsx'
    = yield
    / #notification-center-container
    / = vite_javascript_tag 'notification_center.jsx'

  - if @current_project&.enable_live_chat?
    javascript [nonce=content_security_policy_nonce]:
      (function(d,t) {
        var state = #{@init_state.to_json.html_safe};
        var config = state.liveChat;
        var user = state.currentUser;
        var userId = String(user.id);
        var BASE_URL = config.url;  // Settings/ENV CHATWOOT_BASE_URL
        var g=d.createElement(t),s=d.getElementsByTagName(t)[0];
        window.chatwootSettings = {position: #{I18n.locale == :ar} ? 'left' : 'right'};
        g.src= BASE_URL + "/packs/js/sdk.js";
        s.parentNode.insertBefore(g,s);
        const infoId = 'lighthouse-chatwoot-support-msg'
        const btnSelector = '.woot-widget-bubble:not(.woot--hide)'
        const storageKey = 'lhChatInfoDismissed'
        function stopAnimate(cwBubble, infoEle) {
          if(!cwBubble || !infoEle) {return}
          cwBubble.classList.remove('wave-animation')
          infoEle.classList.add('hide')
          window.localStorage.setItem(storageKey, 'true')
        }
        function initializeChatwoot () {
          window.$chatwoot.setUser(userId, {
            email: user.email,
            name: user.fullName
          })
          window.$chatwoot.setLocale('#{I18n.locale}')
          const bubble = document.querySelector(btnSelector)
          if(bubble) {
            bubble.classList.add('chat-icon-custom')
            bubble.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="" stroke-linecap="round" stroke-linejoin="round" class="chat-svg-icon" aria-hidden="true"><path d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path><path d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"></path></svg>'
              if (!(window.localStorage.getItem(storageKey) === 'true')) {
                bubble.classList.add('wave-animation')
                const infoEle = document.createElement('p')
                infoEle.setAttribute('id', infoId)
                infoEle.addEventListener('click', function(e){
                  e.stopPropagation()
                  stopAnimate(bubble, infoEle)
                })
                infoEle.innerHTML = `<svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x w-3.5 h-3.5 text-black" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>${"#{I18n.t('frontend.chatwoot_info_msg')}"}`
                infoEle.classList.add('chat-info-msg')
                bubble.prepend(infoEle)
              }
          }
          if (localStorage.chatwootUserId !== userId) {
            window.$chatwoot.reset()
            localStorage.chatwootUserId = userId
          }
        }
        window.addEventListener('chatwoot:ready', initializeChatwoot);
        window.addEventListener('chatwoot:opened', function() {
          stopAnimate(document.querySelector(btnSelector), document.getElementById(infoId))
        })
        g.onload= function(){
          window.chatwootSDK.run({
            websiteToken: config.token, // Settings/ENV CHATWOOT_TOKEN
            baseUrl: BASE_URL,
          })
        }
      })(document,"script");
  = render partial: 'layouts/consent_banner' unless Settings.osano_enabled

