doctype html
html
  head
    meta content=("text/html; charset=UTF-8") http-equiv="Content-Type" /
    meta content="IE=edge" http-equiv="X-UA-Compatible"
    meta content="width=device-width, initial-scale=1" name="viewport"
    title = @current_project&.name
    javascript:
      window.I18n = {
        locale: '#{I18n.locale}'
      }
    = csrf_meta_tags
    = jquery_include_tag :google
    = render '//layouts/custom_styles'
    = javascript_include_tag :threesixty

    = stylesheet_link_tag 'threesixty_dependencies', media: 'all'
    = javascript_pack_tag 'vendors'

  body class=(I18n.locale == :ar ? 'rtl' : 'ltr' )  data-locale="#{I18n.locale}"
    = yield
    #notification-center-container
    = javascript_pack_tag 'notificationCenter'
