
footer.lighthouse_footer
  .fluid-container
    .footer-wrapper
      = image_tag('lighthouseLogoWide.png')
      .text-align-c
        a href="#{Settings.privacy_url}" rel="noopener noreferrer" target="_blank"
          | #{I18n.t('shared.tte_terms_and_condition')}
        - if @current_project&.privacy_setting.enable_privacy_link
          br
          a href="#{@current_project.privacy_setting.privacy_link_url}" target="_blank" class='inline-block mts' #{@current_project.privacy_setting.privacy_link_text}
      = image_tag('tteLogo.svg')
