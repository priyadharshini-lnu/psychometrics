.contentBox
  .contentTitleHeader
    i.glyphicon.glyphicon-eye-open.titleIcon.pull-left
    p.contentTitle.pull-left = t('.header')
    = render partial: 'lang'
    = link_to t('.export_pdf'), { action: :show, export: true, format: :pdf }, class: 'btn btn-default pull-right mrl'
    .clearfix
  = render partial: 'show'
