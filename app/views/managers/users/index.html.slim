.row
  .col-xs-12
    #assessmentDashboard
      .contentTitleHeader
        i.glyphicon.glyphicon-dashboard.titleIcon.pull-left
        p.contentTitle
          = t('.title')
      .col-md-3.col-md-push-9.topPadding
        .dropdown.pull-right
          button#dropdownMenu1.btn.btn-default.dropdown-toggle aria-expanded="true" aria-haspopup="true" data-toggle="dropdown" type="button"
            | Select Type
            span.caret
          ul.dropdown-menu aria-labelledby="dropdownMenu1"
            li
              a href="#"
                | Manager
            li
              a href="#"
                | Direct Reports
            li
              a href="#"
                | Peers
        .clearfix  
      .col-xs-12
        .notificationTable style=("overflow-x:auto !important;")
          table.table.table-striped
            thead

              tr
                th
                  | Name
                th
                  | Position/Job Title
                th
                  | Relation
            tbody
              - if @resources.present?
                = render partial: 'resource', collection: @resources
              - else
                tr.no_records
                  td align='center' colspan='7' = t('administration.no_data_found')
      .clearfix  