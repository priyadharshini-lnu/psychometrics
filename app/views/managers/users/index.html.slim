.row
  .col-xs-12
    #assessmentDashboard
      .contentTitleHeader
        i.glyphicon.glyphicon-dashboard.titleIcon.pull-left
        p.contentTitle
          = t('.title')
      .col-md-3.col-md-push-9.topPadding
        .dropdown.pull-right
          button#dropdownMenu1.btn.btn-default.dropdown-toggle aria-expanded="true" aria-haspopup="true" data-toggle="dropdown" type="button"
            | Select Type
            span.caret
          ul.dropdown-menu aria-labelledby="dropdownMenu1"
            = active_link_to 'All', { action: :index }, wrap_tag: :li, active: /^(?!.*\bfilter\b)/
            = active_link_to 'Managers', { action: :index, filter: 'manager' }, wrap_tag: :li, active: /filter=manager/
            = active_link_to 'Direct Reports', { action: :index, filter: 'report' }, wrap_tag: :li, active: /filter=report/
            = active_link_to 'Peers', { action: :index, filter: 'peer' }, wrap_tag: :li, active: /filter=peer/
        .clearfix  
      .col-xs-12
        .notificationTable style=("overflow-x:auto !important;")
          table.table.table-striped
            thead

              tr
                th
                  | Name
                th
                  | Job Title
                th
                  | Relation
            tbody
              - if @resources.present?
                = render partial: 'resource', collection: @resources
              - else
                tr.no_records
                  td align='center' colspan='7' = t('administration.no_data_found')
      .clearfix  
