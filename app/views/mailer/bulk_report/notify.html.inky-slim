spacer[size="48"]
container.email-container
  spacer[size="32"]

  row
    columns
      - if @user.project&.logo.url
        = image_tag(@user.project&.logo.url, class: 'project-logo float-left')
  row
    columns.email-content
      p="Dear #{@user.first_name},"
      p="Your request to export bulk reports has been completed successfully. Please download the exported zip file before #{@report.expiration_date.strftime('%d %b %Y %H:%M')}. After this date, this zip file will be deleted automatically."

      ul
        - @report.public_download_urls.each do |url|
          li = link_to(nil, url)
  row
    columns.email-content
      = simple_format(t("devise.mailer.reset_password_instructions.regards"))

  row
    columns.email-copyright.footer
      |  © 
      = Time.now.year
      |  Lighthouse. All rights reserved 
  spacer[size="16"]

spacer[size="16"]
wrapper.secondary
  center
    row
      columns.powered-by-tte[valign="middle"]
        center
          = image_tag('tte-logo-no-text.svg')
        spacer[size="16"]

        p.text-center
          |  Powered by The Talent Enterprises.
