container.email-container
  row
    columns.email-content
      p
        | You have been booked for Assessment center 
        = link_to ' View details', administration_to_admin_url(@url)

      p
       | Start time: #{@workshop.formatted_start_time}

      p
        | End time:#{@workshop.formatted_end_time}

      p
        | Project: #{@workshop&.campaign&.project&.name}
      p
        | Campaign: #{@workshop&.campaign&.name}
