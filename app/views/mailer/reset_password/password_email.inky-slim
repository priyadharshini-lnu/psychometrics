- signin_url = Utility::Url.generate(:user_session_url, subdomain: @user&.project&.subdomain)

p= "Hello #{@user.decorate.display_name}, "
p Greetings for the day!
- if @user.admin?
  p Your administrator has reset your Lighthouse for #{@user.email}
- else
  p Your administrator has reset your Lighthouse - #{@user.project.name} password for #{@user.email}
  
p
  b Password:
  = " #{@password}"
  
spacer[size="16"]
row
  columns
    = link_to signin_url
      | Click here to login
