spacer[size="48"]
container.email-container
  spacer[size="32"]
  row
    columns
      - if @resource&.project&.logo&.url
        = image_tag(@resource&.project&.logo&.url, class: 'project-logo float-left')
  row
    columns.email-content
      - if @stats[:used_licenses].present?
        p = t('.weekly_stats')
        table border="1"
          tr
            th = t('.column_headers.client_name')
            th = t('.column_headers.expiry_date')
            th = t('.column_headers.type')
            th = t('.column_headers.use_count')
            th = t('.column_headers.overuse_limit')
            th = t('.column_headers.remaining_count')
          - @stats[:used_licenses].each do |used_license|
            tr
              td = used_license[:client_name]
              td = used_license[:license_end_date]
              td = used_license[:type]
              td = used_license[:use_count]
              td = used_license[:overuse_limit]
              td = used_license[:remaining_count]
        spacer[size="16"]
      - else
        p = t('.no_weekly_stats')

      - if @stats[:expiring_licenses]
        p = t('.expiry_stats')
        table border="1"
          tr
            th = t('.column_headers.client_name')
            th = t('.column_headers.expiry_date')
            th = t('.column_headers.account_manager')
            th = t('.column_headers.project_manager')
          - @stats[:expiring_licenses].each do |expiring_license|
            tr
              td = expiring_license[:client_name]
              td = expiring_license[:license_end_date]
              td = expiring_license[:account_manager]
              td = expiring_license[:project_manager]
        spacer[size="16"]
      - else
        p = t('.no_expiry_stats')
      p = t('.notice')
  row
    columns.email-copyright.footer
      |  © 
      = Time.now.year
      |  Lighthouse. All rights reserved 
  spacer[size="16"]

spacer[size="16"]
wrapper.secondary
  center
    row
      columns.powered-by-tte[valign="middle"]
        center
          = image_tag('tte-logo-no-text.svg')
        spacer[size="16"]

        p.text-center
          |  Powered by The Talent Enterprises.