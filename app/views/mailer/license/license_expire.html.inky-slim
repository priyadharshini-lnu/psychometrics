spacer[size="48"]
container.email-container
  spacer[size="32"]
  = render 'mailer/layouts/admin/logo'

  row
    columns.email-content
      p License expire
      - if @client
        p
          = "Check Client #{@client.decorate.display_name} License usage "
          = link_to "here.", license_administration_client_url(@client) 
  = render 'mailer/layouts/footer'

= render 'mailer/layouts/powered_by'

