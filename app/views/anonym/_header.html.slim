header
  .row
    .col-xs-6.col-md-6.logo-wrap
      - if @client && @client.logo.present?
        = image_tag @client.logo.url, class: 'logo', alt: @current_client.decorate.display_name
      - else
        = image_tag 'the-talent-enterprise-logo.png', class: 'img-responsive', alt: 'The Talent Enterprise logo'
    .col-xs-6.col-md-6
