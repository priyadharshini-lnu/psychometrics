= stylesheet_link_tag :administration
.row
  .col-xs-12
    .contentBox
      .contentTitleHeader
        i.glyphicon.glyphicon-question-sign.titleIcon.pull-left
        p.contentTitle.pull-left Questions
        = render partial: 'application/lang', locals: { with_confirm: true, locales: @available_translations, active_locale: @active_locale }
        .clearfix
      .questionContent
        #psychometrics_preview data-result="#{AssignSerializer.new(@assign).to_json}" data-type="pass_assessment" data-data="#{AssessmentSerializer.new(@resource).to_json(include: '**')}"  data-locales="#{@translations.to_json}"
        = javascript_include_tag :psychometrics_vendor
        = javascript_include_tag :psychometrics_preview
