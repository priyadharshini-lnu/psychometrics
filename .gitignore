# Ignore local ssl certs
support/dev-ssl/*.pem
support/dev-ssl/*.key
!support/dev-ssl/lvh.me.pem
!support/dev-ssl/lvh.me.key
!support/dev-ssl/ttedev.me.pem
!support/dev-ssl/ttedev.me.key

# Ignore local translations
app/assets/javascripts/administration/i18n/*
app/assets/javascripts/i18n/*

# Ignore Dev Procfile
Procfile.*

# Ignore storybook build files
storybook-static

/app/assets/builds/*
!/app/assets/builds/.keep

