{
  "parser": "babel-eslint",
  "env": {
    "browser": true,
    "es6": true
  },
  "extends": [
    "airbnb"
  ],
  "parserOptions": {
    "ecmaVersion": 8,
    "ecmaFeatures": {
      "experimentalObjectRestSpread": true,
      "jsx": true
    },
    "sourceType": "module"
  },
  "plugins": [
    "babel",
    "react",
    "import"
  ],
  "rules": {
    "no-debugger": "off"
  },
  "globals": {
    "__DEV__": true,
    "__PROD__": true
  },
  "settings": {
    "import/resolver": {
      "babel-module": {}
    }
  }
}
