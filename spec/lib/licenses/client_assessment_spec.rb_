require 'rails_helper'

RSpec.describe Licenses::ClientAssessment do
  let(:call) { Licenses::ClientAssessment.use(assessment) }
  let!(:client) { create(:client) }
  let!(:license) { client.licenses.client_assessment.first }
  let(:subtenancy) { create(:client, parent: client) }
  let(:assessment) { build(:assessment, owner: client) }

  describe 'self.use' do
    context 'When owner is Client' do
      context 'and HAS enough licenses then' do
        before { call }

        it { expect(assessment.errors.added?(:base, :has_no_enough_licenses)).to be_falsey }
        it 'builds a license_usage' do
          expect(assessment.license_usages.size).to eq(1)
          expect(assessment.license_usages.first.license).to eq(license)
        end
        it { expect(call).to be(assessment.license_usages.first) }
      end

      context 'and HAS NO enough licenses then' do
        before { license.update(number: 0) }

        it 'does NOT build a license_usage' do
          expect { call }.to raise_error(ActiveRecord::RecordInvalid)
          expect(assessment.errors.added?(:base, :has_no_enough_licenses)).to be_truthy
          expect(assessment.license_usages).to be_empty
        end
      end

      context 'When owner is Subtenancy' do
        let(:assessment) { build(:assessment, owner: subtenancy) }
        before { call }

        it 'builds a license_usage of Tenancy license' do
          expect(assessment.license_usages.first.license_id).to eq(license.id)
        end
      end
    end

    context 'When owner is TTE' do
      let(:assessment) { build(:assessment) }

      it { expect(call).to be_nil }
    end
  end
end
