{
  "compilerOptions": {
    "declaration":false,
    "emitDecoratorMetadata":true,
    "experimentalDecorators":true,
    "lib": [
      "es6",
      "dom",
    ],
    "module":"commonjs",
    "moduleResolution":"node",
    "sourceMap":true,
    "target":"es5",
    "jsx":"react",
    "allowJs": true,
    "allowSyntheticDefaultImports":true,
    "esModuleInterop": true ,
    "noImplicitAny":false,
    "noImplicitThis":true,
    "noImplicitReturns":true,
    "strictNullChecks":true,
    "baseUrl": ".",
    "paths": {
      "*": [
        "app/frontend/*",
        "app/frontend/modules/survey*"
      ]
    },
    "typeRoots": [
      "app/frontend/typings",
      "./node_modules/@types"
    ]
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "node_modules",
    "public"
  ],
  "include": [
    "app/frontend",
    "app/frontend/modules/survey",
  ],
  "compileOnSave":false
}
