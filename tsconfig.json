{
  "compilerOptions": {
    "target":"ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "declaration":false,
    "noEmit": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata":false,
    "experimentalDecorators":true,
    "module":"commonjs",
    "moduleResolution":"node",
    "sourceMap":true,
    "jsx":"react",
    "allowJs": true,
    "resolveJsonModule":true,
    "allowSyntheticDefaultImports":true,
    "esModuleInterop": true ,
    "noImplicitAny":false,
    "noImplicitThis":true,
    "noImplicitReturns":true,
    "strictNullChecks":true,
    "useUnknownInCatchVariables": false,
    "baseUrl": ".",
    "paths": {
      "*": [
        "app/frontend/*",
        "app/frontend/modules/survey*",
        "app/frontend/modules/survey/*",
      ],
      "~/*": ["app/frontend/*"]
    },
    "typeRoots": [
      "app/frontend/typings",
      "./node_modules/@types"
    ]
  },
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "node_modules",
    "public"
  ],
  "include": [
    "./app/stories",
    "**/*.stories.tsx",
    "./app/frontend",
    "./app/frontend/modules/survey",
  ],
  "compileOnSave":false
}
